    ("bing_cache", _strategy_bing_cache, 0.6),
    ("yandex_cache", _strategy_yandex_cache, 0.6),
    ("textise", _strategy_textise, 0.5),
    ("12ft", _strategy_12ft, 0.5),
    ("tg_iv", _strategy_tg_iv, 0.4),
]


# ============================================================
# Smart picker
# ============================================================

def _score(domain, name, base, stats):
    s = stats.get(name) or {}
    weight = float(s.get("weight", 1.0))
    ok = int(s.get("ok", 0))
    fail = int(s.get("fail", 0))
    total = ok + fail
    if total == 0:
        cold = 0.5
    else:
        rate = ok / total
        cold = rate * 2.0
    # recent fail penalty
    lf = s.get("last_fail")
    recent_pen = 0.0
    if lf and (time.time() - float(lf)) < 300:
        recent_pen = -1.5
    lo = s.get("last_ok")
    recent_bonus = 0.0
    if lo and (time.time() - float(lo)) < 300:
        recent_bonus = 0.5
    return base + weight * 0.4 + cold + recent_bonus + recent_pen


def _pick_top(domain, n=RACE_N, exclude=None):
    exclude = set(exclude or [])
    stats = _get_strategy_stats(domain)
    scored = []
    for name, fn, base in STRATEGIES:
        if name in exclude:
            continue
        sc = _score(domain, name, base, stats)
        scored.append((sc, name, fn))
    scored.sort(key=lambda x: -x[0])
    top = scored[:n]
    # thompson: каждый 5-й вызов — exploration
    if random.random() < 0.2 and len(scored) > n:
        top.append(scored[n])
    return [(name, fn) for _, name, fn in top]


# ============================================================
# Executors
# ============================================================

async def _try_strategy(name, fn, url, ctx=None):
    cached = _cache_get(url + "#" + name)
    if cached:
        _trace_put(url, name, True, 0.0, len(cached))
        return cached, name
    t0 = time.time()
    try:
        page = await asyncio.wait_for(fn(url, ctx=ctx), timeout=20)
    except asyncio.TimeoutError:
        ms = (time.time() - t0) * 1000
        _record_strategy(_domain(url), name, False, ms)
        _log_trace(url, name, False, ms, 0)
        _trace_put(url, name, False, ms, 0)
        return None, None
    except Exception:
        ms = (time.time() - t0) * 1000
        _record_strategy(_domain(url), name, False, ms)
        _log_trace(url, name, False, ms, 0)
        _trace_put(url, name, False, ms, 0)
        return None, None
    ms = (time.time() - t0) * 1000
    if page and len(page) > 500:
        _record_strategy(_domain(url), name, True, ms)
        _log_trace(url, name, True, ms, len(page))
        _trace_put(url, name, True, ms, len(page))
        _cache_set(url + "#" + name, page)
        _cache_set(url, page)
        return page, name
    _record_strategy(_domain(url), name, False, ms)
    _log_trace(url, name, False, ms, len(page) if page else 0)
    _trace_put(url, name, False, ms, len(page) if page else 0)
    return None, None


async def _race(strategy_pairs, url, ctx=None):
    if not strategy_pairs:
        return None, None
    tasks = [
        asyncio.create_task(_try_strategy(n, f, url, ctx=ctx))
        for n, f in strategy_pairs
    ]
    try:
        for coro in asyncio.as_completed(tasks, timeout=RACE_TIMEOUT):
            page, used = await coro
            if page:
                for t in tasks:
                    if not t.done():
                        t.cancel()
                return page, used
    except asyncio.TimeoutError:
        for t in tasks:
            if not t.done():
                t.cancel()
    return None, None


async def _pipeline(strategy_pairs, url, ctx=None):
    for name, fn in strategy_pairs:
        page, used = await _try_strategy(name, fn, url, ctx=ctx)
        if page:
            return page, used
    return None, None


async def _solve(url, reason="", ctx=None):
    if not url:
        return None

    cached = _cache_get(url)
    if cached:
        _trace_put(url, "cache", True, 0.0, len(cached))
        return cached

    domain = _domain(url)

    top = _pick_top(domain, n=RACE_N)
    if top:
        page, used = await _race(top, url, ctx=ctx)
        if page:
            return page

    tried = {n for n, _ in top}
    rest = _pick_top(domain, n=8, exclude=tried)
    if rest:
        page, used = await _pipeline(rest, url, ctx=ctx)
        if page:
            return page

    if _HAS_CURL:
        page, used = await _pipeline([("curl_profiles", _strategy_curl_profiles)], url, ctx=ctx)
        if page:
            return page

    return None


# ============================================================
# Public API for NeverFake
# ============================================================

async def solve(url, reason="", ctx=None):
    return await _solve(url, reason=reason, ctx=ctx)


def get_last_headers(url):
    return _last_headers.get(url, ({}, 200))


def list_last_headers():
    return dict(_last_headers)


def solve_trace(url):
    return _trace_ring.get(url)


def get_stats(domain):
    return _get_strategy_stats(domain)


def list_stats(limit=20):
    c = _db()
    if c is None:
        return []
    try:
        rows = c.execute(
            "SELECT domain, COUNT(*) FROM lf_strategy GROUP BY domain "
            "ORDER BY MAX(last_ok) DESC LIMIT ?",
            (limit,),
        ).fetchall()
        return [(r[0], int(r[1])) for r in rows]
    except Exception:
        return []


# ============================================================
# Hooks
# ============================================================

_CTX_HINT = {"last": None}


async def on_blocked(ctx):
    url = ctx.get("url")
    if not url:
        return None
    _CTX_HINT["last"] = ctx
    page = await _solve(url, reason=ctx.get("reason") or "blocked", ctx=ctx)
    if page:
        domain = _domain(url)
        headers, status = _last_headers.get(url, ({}, 200))
        _save_cookie(domain, "", "", None)
        _set_ua_profile(domain, _pick_impersonate(url, ctx) or "chrome", "")
    return page


async def on_js_required(ctx):
    url = ctx.get("url")
    if not url:
        return None
    _CTX_HINT["last"] = ctx
    page = await _strategy_jina(url, ctx=ctx)
    if page:
        return page
    page = await _strategy_jina_text(url, ctx=ctx)
    if page:
        return page
    return await _strategy_wayback(url, ctx=ctx)


async def on_error(ctx):
    url = ctx.get("url")
    err = str(ctx.get("error") or "").lower()
    if not url:
        return None
    _CTX_HINT["last"] = ctx
    if "timeout" in err or "timed out" in err:
        page = await _strategy_wayback(url, ctx=ctx)
        if page:
            return page
    if "refused" in err or "connection" in err:
        page = await _strategy_jina_text(url, ctx=ctx)
        if page:
            return page
    return await _strategy_httpx_h2(url, ctx=ctx)


async def after_fetch(ctx):
    url = ctx.get("url")
    html_text = ctx.get("html") or ""
    if not url or not html_text:
        return None
    _CTX_HINT["last"] = ctx
    try:
        m = re.search(r'cf_clearance=([^;\"\']+)', html_text)
        if m:
            _save_cookie(_domain(url), f"cf_clearance={m.group(1)}", "", None)
    except Exception:
        pass
    try:
        status = ctx.get("status") or 200
        if status == 200:
            _cache_set(url, html_text)
    except Exception:
        pass
    return None