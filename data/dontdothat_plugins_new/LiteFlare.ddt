# ============================================================
# SQLite store
# ============================================================

_store_lock = threading.Lock()
_store_conn = None


def _connect():
    global _store_conn
    if _store_conn is not None:
        return _store_conn
    try:
        DB_PATH.parent.mkdir(parents=True, exist_ok=True)
        c = sqlite3.connect(str(DB_PATH), check_same_thread=False)
        try:
            c.execute("PRAGMA journal_mode=WAL")
        except Exception:
            pass
        c.execute(
            "CREATE TABLE IF NOT EXISTS lf_cookies ("
            "domain TEXT PRIMARY KEY, cookie TEXT, ua TEXT, proxy TEXT, "
            "created REAL, expires REAL)"
        )
        c.execute(
            "CREATE TABLE IF NOT EXISTS lf_strategy ("
            "domain TEXT, strategy TEXT, weight REAL DEFAULT 1.0, "
            "ok INTEGER DEFAULT 0, fail INTEGER DEFAULT 0, total_ms REAL DEFAULT 0, "
            "last_ok REAL, last_fail REAL, "
            "PRIMARY KEY (domain, strategy))"
        )
        c.execute(
            "CREATE TABLE IF NOT EXISTS lf_trace ("
            "ts REAL, url TEXT, strategy TEXT, ok INTEGER, ms REAL, size INTEGER)"
        )
        c.execute(
            "CREATE TABLE IF NOT EXISTS lf_ua (domain TEXT PRIMARY KEY, profile TEXT, ua TEXT)"
        )
        c.commit()
        _store_conn = c
        return c
    except Exception:
        return None


def _db():
    try:
        return _connect()
    except Exception:
        return None


def _get_cookie(domain):
    c = _db()
    if c is None:
        return None
    try:
        row = c.execute(
            "SELECT cookie, ua, proxy, expires FROM lf_cookies WHERE domain=?",
            (domain,),
        ).fetchone()
        if row is None:
            return None
        cookie, ua, proxy, expires = row
        if expires and expires < time.time():
            c.execute("DELETE FROM lf_cookies WHERE domain=?", (domain,))
            c.commit()
            return None
        return {"cookie": cookie, "ua": ua, "proxy": proxy}
    except Exception:
        return None


def _save_cookie(domain, cookie, ua, proxy):
    c = _db()
    if c is None:
        return
    try:
        c.execute(
            "INSERT OR REPLACE INTO lf_cookies (domain, cookie, ua, proxy, created, expires) "
            "VALUES (?,?,?,?,?,?)",
            (domain, cookie, ua, proxy or "", time.time(), time.time() + 3600 * 6),
        )
        c.commit()
    except Exception:
        pass


def _record_strategy(domain, strategy, ok, ms):
    c = _db()
    if c is None:
        return
    try:
        with _store_lock:
            row = c.execute(
                "SELECT weight, ok, fail, total_ms FROM lf_strategy WHERE domain=? AND strategy=?",
                (domain, strategy),
            ).fetchone()
            now = time.time()
            if row is None:
                c.execute(
                    "INSERT INTO lf_strategy (domain, strategy, weight, ok, fail, total_ms, last_ok, last_fail) "
                    "VALUES (?,?,?,?,?,?,?,?)",
                    (
                        domain, strategy,
                        1.5 if ok else 0.5,
                        1 if ok else 0,
                        0 if ok else 1,
                        ms,
                        now if ok else None,
                        None if ok else now,
                    ),
                )
            else:
                weight, ok_n, fail_n, total_ms = row
                weight = float(weight or 1.0)
                total_ms = float(total_ms or 0.0)
                if ok:
                    weight = min(3.0, weight * 1.15 + 0.1)
                    ok_n += 1
                else:
                    weight = max(0.05, weight * 0.8)
                    fail_n += 1
                total_ms = total_ms + ms
                last_ok = now if ok else None
                last_fail = None if ok else now
                c.execute(
                    "UPDATE lf_strategy SET weight=?, ok=?, fail=?, total_ms=?, "
                    "last_ok=COALESCE(?, last_ok), last_fail=COALESCE(?, last_fail) "
                    "WHERE domain=? AND strategy=?",
                    (weight, ok_n, fail_n, total_ms, last_ok, last_fail, domain, strategy),
                )
            c.commit()
    except Exception:
        pass


def _get_strategy_stats(domain):
    c = _db()
    if c is None:
        return {}
    try:
        rows = c.execute(
            "SELECT strategy, weight, ok, fail, total_ms, last_ok, last_fail "
            "FROM lf_strategy WHERE domain=?",
            (domain,),
        ).fetchall()
        out = {}
        for r in rows:
            out[r[0]] = {
                "weight": float(r[1] or 1.0),
                "ok": int(r[2] or 0),
                "fail": int(r[3] or 0),
                "total_ms": float(r[4] or 0.0),
                "last_ok": r[5],
                "last_fail": r[6],
            }
        return out
    except Exception:
        return {}


def _log_trace(url, strategy, ok, ms, size):
    c = _db()
    if c is None:
        return
    try:
        with _store_lock:
            c.execute(
                "INSERT INTO lf_trace (ts, url, strategy, ok, ms, size) VALUES (?,?,?,?,?,?)",
                (time.time(), url[:500], strategy, 1 if ok else 0, ms, size),
            )
            c.execute(
                "DELETE FROM lf_trace WHERE ts < ?",
                (time.time() - 86400,),
            )
            c.commit()
    except Exception:
        pass


def _get_ua_profile(domain):
    c = _db()
    if c is None:
        return None
    try:
        row = c.execute(
            "SELECT profile FROM lf_ua WHERE domain=?", (domain,)
        ).fetchone()
        return row[0] if row else None
    except Exception:
        return None


def _set_ua_profile(domain, profile, ua):
    c = _db()
    if c is None:
        return
    try:
        c.execute(
            "INSERT OR REPLACE INTO lf_ua (domain, profile, ua) VALUES (?,?,?)",
            (domain, profile, ua or ""),
        )
        c.commit()
    except Exception:
        pass


# ============================================================
# In-memory LRU page cache + trace ring
# ============================================================

_page_cache = OrderedDict()
_trace_ring = OrderedDict()
_last_headers = {}
_ua_lock = threading.Lock()


def _cache_get(url):
    e = _page_cache.get(url)
    if e is None:
        return None
    html, ts = e
    if time.time() - ts > CACHE_TTL:
        _page_cache.pop(url, None)
        return None
    _page_cache.move_to_end(url)
    return html


def _cache_set(url, html):
    if not html:
        return
    _page_cache[url] = (html, time.time())
    _page_cache.move_to_end(url)
    while len(_page_cache) > CACHE_MAX:
        _page_cache.popitem(last=False)


def _trace_put(url, strategy, ok, ms, size):
    _trace_ring[url] = {
        "ts": time.time(),
        "strategy": strategy,
        "ok": bool(ok),
        "ms": round(ms, 3),
        "size": size,
    }
    while len(_trace_ring) > TRACE_MAX:
        _trace_ring.popitem(last=False)


# ============================================================
# Detectors
# ============================================================

def _detect_antibot(text):
    if not text:
        return None
    low = text.lower()
    for name, markers in _ANTIBOT:
        for m in markers:
            if m in low:
                return name
    if any(m in low for m in _CAPTCHA):
        return "captcha"
    return None


def _is_blocked(text):
    return _detect_antibot(text) is not None


def _is_cf(text):
    if not text:
        return False
    low = text.lower()
    return any(m in low for m in _CF)


def _domain(url):
    try:
        return urlparse(url).netloc.lower()
    except Exception:
        return ""


def _site_override(url, query):
    d = _domain(url)
    for key, fn in SITE_HANDLERS.items():
        if key in d:
            try:
                return fn(query)
            except Exception:
                return None
    return None


# ============================================================
# UA / impersonate consistency
# ============================================================

def _ua_to_profile(ua):
    if not ua:
        return None
    ua = str(ua)
    m = re.search(r"Chrome/(\d+)", ua)
    if m:
        ver = m.group(1)
        return "chrome%s" % ver
    if "Firefox/133" in ua:
        return "firefox133"
    if "Firefox/132" in ua:
        return "firefox132"
    if "Firefox/131" in ua:
        return "firefox131"
    if "Safari/" in ua and "iPhone" in ua:
        return "safari17_2_ios"
    if "Safari/" in ua:
        return "safari17_0"
    return None


def _pick_impersonate(url, ctx=None):
    domain = _domain(url)
    profile = _get_ua_profile(domain)
    if profile:
        return profile
    if ctx is not None:
        try:
            ua = ctx.call_plugin("neverfake", "pick_ua", domain)
            if asyncio.iscoroutine(ua):
                pass
            else:
                p = _ua_to_profile(ua)
                if p and p in IMPERSONATE_PROFILES:
                    _set_ua_profile(domain, p, ua or "")
                    return p
        except Exception:
            pass
    return None


# ============================================================
# Fetch primitives
# ============================================================

async def _curl_fetch(url, impersonate="chrome", headers=None, cookie=None, ctx=None):
    if not _HAS_CURL:
        return None
    prof = impersonate or _pick_impersonate(url, ctx) or "chrome"
    if prof not in IMPERSONATE_PROFILES:
        prof = "chrome"
    h = dict(headers or {})
    if cookie:
        h["Cookie"] = cookie
    try:
        async with _CurlSession() as session:
            r = await session.get(
                url, headers=h, timeout=20,
                impersonate=prof, allow_redirects=True,
            )
            try:
                hd = {}
                for k, v in (r.headers or {}).items():
                    hd[str(k)] = str(v)
                _last_headers[url] = (hd, int(getattr(r, "status_code", 200) or 200))
            except Exception:
                pass
            return (r.text or "")[:900_000]
    except Exception:
        return None


async def _httpx_fetch(url, headers=None, cookie=None):
    if not _HAS_HTTPX:
        return None
    h = dict(headers or {})
    if cookie:
        h["Cookie"] = cookie
    try:
        async with httpx.AsyncClient(
            http2=True, timeout=20,
            follow_redirects=True, headers=h,
        ) as client:
            r = await client.get(url)
            try:
                hd = {}
                for k, v in (r.headers or {}).items():
                    hd[str(k)] = str(v)
                _last_headers[url] = (hd, int(getattr(r, "status_code", 200) or 200))
            except Exception:
                pass
            return (r.text or "")[:900_000]
    except Exception:
        return None


def _urllib_fetch(url, headers=None, cookie=None):
    h = dict(headers or {})
    if cookie:
        h["Cookie"] = cookie
    try:
        req = Request(url, headers=h)
        with urlopen(req, timeout=20) as response:
            raw = response.read(900_000)
            charset = response.headers.get_content_charset() or "utf-8"
            try:
                hd = {}
                for k, v in (response.headers or {}).items():
                    hd[str(k)] = str(v)
                _last_headers[url] = (hd, int(getattr(response, "status", 200) or 200))
            except Exception:
                pass
            try:
                return raw.decode(charset, errors="ignore")
            except LookupError:
                return raw.decode("utf-8", errors="ignore")
    except Exception:
        return None


# ============================================================
# Strategies (16)
# ============================================================

async def _strategy_cookie(url, ctx=None):
    d = _domain(url)
    ck = _get_cookie(d)
    if not ck:
        return None
    page = await _curl_fetch(url, headers={"User-Agent": ck.get("ua") or ""}, cookie=ck.get("cookie"), ctx=ctx)
    if page and len(page) > 500 and not _is_blocked(page):
        return page
    page = await _httpx_fetch(url, headers={"User-Agent": ck.get("ua") or ""}, cookie=ck.get("cookie"))
    if page and len(page) > 500 and not _is_blocked(page):
        return page
    return None


async def _strategy_curl_profiles(url, ctx=None):
    if not _HAS_CURL:
        return None
    locked = _pick_impersonate(url, ctx)
    order = [locked] if locked else []
    for p in IMPERSONATE_PROFILES:
        if p not in order:
            order.append(p)
    for p in order[:6]:
        page = await _curl_fetch(url, impersonate=p, ctx=ctx)
        if page and len(page) > 500 and not _is_blocked(page):
            if p.startswith("chrome"):
                _set_ua_profile(_domain(url), p, "")
            return page
    return None


async def _strategy_curl_headers(url, ctx=None):
    variants = [
        {"Referer": f"https://{_domain(url)}/"},
        {"User-Agent": "Mozilla/5.0 (Linux; Android 16; Pixel 9 Pro) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0.0.0 Mobile Safari/537.36"},
        {"Accept-Language": "ru-RU,ru;q=0.9,en;q=0.8"},
        {"Accept-Language": "en-US,en;q=0.9"},
    ]
    for h in variants:
        page = await _curl_fetch(url, headers=h, ctx=ctx)
        if page and len(page) > 500 and not _is_blocked(page):
            return page
        page = await _httpx_fetch(url, headers=h)
        if page and len(page) > 500 and not _is_blocked(page):
            return page
    return None


async def _strategy_httpx_h2(url, ctx=None):
    page = await _httpx_fetch(url)
    if page and len(page) > 500 and not _is_blocked(page):
        return page
    return None


async def _strategy_jina(url, ctx=None):
    if _HAS_HTTPX:
        page = await _httpx_fetch("https://r.jina.ai/" + url, headers={"X-Return-Format": "markdown"})
    else:
        page = await asyncio.to_thread(_urllib_fetch, "https://r.jina.ai/" + url, {"X-Return-Format": "markdown"})
    if page and len(page) > 300 and not _is_blocked(page):
        return page
    if _HAS_HTTPX:
        page = await _httpx_fetch("https://r.jina.ai/" + url, headers={"X-Return-Format": "text"})
    else:
        page = await asyncio.to_thread(_urllib_fetch, "https://r.jina.ai/" + url, {"X-Return-Format": "text"})
    if page and len(page) > 300 and not _is_blocked(page):
        return page
    return None


async def _strategy_wayback(url, ctx=None):
    try:
        api = f"https://archive.org/wayback/available?url={quote_plus(url)}"
        text = await asyncio.to_thread(_urllib_fetch, api)
        if not text:
            return None
        data = json.loads(text)
        snap = data.get("archived_snapshots", {}).get("closest")
        if not snap or not snap.get("available"):
            return None
        page = await asyncio.to_thread(_urllib_fetch, snap.get("url"))
        if page and len(page) > 500 and not _is_blocked(page):
            return page
    except Exception:
        pass
    return None


async def _strategy_archive_mirrors(url, ctx=None):
    for mirror in ARCHIVE_MIRRORS:
        try:
            target = f"https://{mirror}/newest/{url}"
            page = await asyncio.to_thread(_urllib_fetch, target)
            if page and len(page) > 500 and not _is_blocked(page):
                return page
        except Exception:
            continue
    return None


