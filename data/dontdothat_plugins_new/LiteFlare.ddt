async def _strategy_sucuri_bypass(url, ctx=None):
    variants = [
        {"User-Agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"},
        {"User-Agent": "Mozilla/5.0 (compatible; bingbot/2.0; +http://www.bing.com/bingbot.htm)"},
        {"User-Agent": "Mozilla/5.0 (Linux; Android 16) AppleWebKit/537.36 Chrome/131.0.0.0 Mobile"},
    ]
    for h in variants:
        page = await _curl_fetch(url, headers=h, ctx=ctx)
        if page and len(page) > 500 and not _is_blocked(page):
            return page
    return None


STRATEGIES = [
    ("cookie", _strategy_cookie, 1.0),
    ("curl_profiles", _strategy_curl_profiles, 1.2),
    ("curl_headers", _strategy_curl_headers, 1.1),
    ("sucuri_bypass", _strategy_sucuri_bypass, 0.9),
    ("httpx_h2", _strategy_httpx_h2, 0.9),
    ("jina", _strategy_jina, 0.8),
    ("jina_text", _strategy_jina_text, 0.8),
