    def _help_plugins(self, p):
        return "<blockquote><b>plugins</b>\n<code>%sdothat plugins [--new|--legacy|--trust=]</code>\n<code>%sdothat plugin info|reload|enable|disable|remove &lt;name&gt;</code>\n<code>%sdothat plugin validate &lt;path&gt;</code>\n<code>%sdothat plugin migrate-all</code>\n<code>%sdothat plugin scaffold &lt;name&gt;</code>\n<code>%sdothat plugin lint &lt;path&gt;</code>\n<code>%sdothat plugin trust &lt;name&gt; &lt;level&gt;</code>\n<code>%sdothat plugin search &lt;q&gt;</code>\n<code>%sdothat plugin install &lt;name&gt;</code>\n<code>%sdothat plugin update [&lt;name&gt;] | plugin upgrade-all | plugin refresh-index</code>\n<code>%sdothat plugin-config &lt;name&gt; &lt;key&gt; [value]</code>\n<code>%sdothat plugin-rollback &lt;name&gt; &lt;version&gt;</code>\n<code>%sdothat install [name]</code>\n<code>%sdothat plugin-legacy &lt;name&gt;|plugin-new &lt;name&gt;</code>\n</blockquote>" % (p, p, p, p, p, p, p, p, p, p, p, p, p)

    def _help_repo(self, p):
        return "<blockquote><b>repo</b>\n<code>%sdothat add-to-repo [--method=git|http|auto]</code>\n<code>%sdothat remove-from-repo &lt;name&gt;</code>\n<code>%sdothat update-in-repo</code>\n<code>%sdothat repo-status</code>\n<code>%sdothat repo-list</code>\n</blockquote>" % (p, p, p, p, p)

    def _help_new(self, p):
        return "<blockquote><b>v1.5.0</b>\n<code>%sdothat new info|list|reload</code>\n<code>%sdothat new state|state-clear &lt;name&gt;</code>\n<code>%sdothat new events [replay &lt;type&gt;]|health|stats</code>\n</blockquote>" % (p, p, p)

