    def _help_service(self, p):
        return "<blockquote><b>service</b>\n<code>%sdothat export|import|backup|restore</code>\n<code>%sdothat watch add|list|remove|run [--all]</code>\n<code>%sdothat metrics export</code>\n<code>%sdothat template add|list|run|remove</code>\n<code>%sdothat version</code>\n</blockquote>" % (p, p, p, p, p)

    def _help_commands(self, role_filter=None):
        p = html.escape(self._prefix())
        order = ["guest", "viewer", "contributor", "verified", "searcher", "editor", "admin", "superadmin", "owner"]
        start_idx = 0
        if role_filter and role_filter in ROLE_ORDER:
            start_idx = order.index(role_filter) if role_filter in order else 0
        lines = ["<blockquote><b>\U0001F4CB commands by role</b></blockquote>"]
        seen = set()
        for role in order[start_idx:]:
            if role in seen:
                continue
            seen.add(role)
            cmds = ROLE_COMMANDS.get(role)
            if cmds is None:
                cmds = set()
                for r2 in order:
                    if r2 == "owner":
                        continue
                    c = ROLE_COMMANDS.get(r2)
                    if c:
                        cmds.update(c)
            prev = set()
            for r2 in order[:order.index(role)]:
                c = ROLE_COMMANDS.get(r2)
                if c:
                    prev.update(c)
            new = sorted(cmds - prev)
            if not new:
                continue
            lines.append("<b>\u2014 %s \u2014</b>" % role)
            for c in new:
                lines.append("  <code>%sdothat %s</code>" % (p, html.escape(c)))
        lines.append("<i>filter: <code>%sdothat help commands [role]</code></i>" % p)
        return "\n".join(lines)

    def _help_operators(self, p):
        return "<blockquote><b>operators</b>\n+word -word \"phrase\" site: filetype:pdf,docx intitle: кот* ~котик AND OR NOT ( )\n</blockquote>"

    def _help_rc(self, p):
        return "<blockquote><b>rc</b>\n<code>%sdothat rc stop add|remove|list [word]</code>\n<code>%sdothat rc captcha add|remove|list [word]</code>\n<code>%sdothat rc ua add|remove|list [region] [ua]</code>\n</blockquote>" % (p, p, p)

    async def _handle_rc(self, event, sub, tail, sender):
        info = self._plugins.get("rcagent")
        if info is None or info.get("enabled") is False:
            await self._respond(event, "<blockquote><b>RCAgent not loaded</b></blockquote>", parse_mode="html")
            return
        mod = info.get("module")
        toks = tail.split(maxsplit=2)
        if not toks:
            await self._respond(event, self._help_rc(self._prefix()), parse_mode="html")
            return
        action = toks[0].lower()
        ctx = self._make_ctx("rcagent", "rc_command", {"event": event, "args": tail})
        if sub == "stop":
            if action == "add" and len(toks) > 1:
                if hasattr(mod, "add_stop"):
                    mod.add_stop(ctx, toks[1])
                    await self._respond(event, "<blockquote><b>stop+</b> <code>%s</code></blockquote>" % html.escape(toks[1]), parse_mode="html")
                else:
                    await self._respond(event, "<blockquote><b>method missing</b></blockquote>", parse_mode="html")
                return
            if action == "remove" and len(toks) > 1:
                ok = mod.remove_stop(ctx, toks[1]) if hasattr(mod, "remove_stop") else False
                await self._respond(event, "<blockquote><b>stop-</b> <code>%s</code> (%s)</blockquote>" % (html.escape(toks[1]), "ok" if ok else "not found"), parse_mode="html")
                return
            if action == "list":
                words = mod.list_stop(ctx) if hasattr(mod, "list_stop") else []
                await self._respond(event, "<blockquote><b>stop words</b>: %d\n<code>%s</code></blockquote>" % (len(words), html.escape(", ".join(words) or "-")), parse_mode="html")
                return
            if action == "clear":
                if hasattr(mod, "clear_stop"):
                    mod.clear_stop(ctx)
                await self._respond(event, "<blockquote><b>cleared</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, self._help_rc(self._prefix()), parse_mode="html")
            return
        if sub == "captcha":
            if action == "add" and len(toks) > 1:
                if hasattr(mod, "add_captcha"):
                    mod.add_captcha(ctx, toks[1])
                    await self._respond(event, "<blockquote><b>captcha+</b> <code>%s</code></blockquote>" % html.escape(toks[1]), parse_mode="html")
                return
            if action == "remove" and len(toks) > 1:
                ok = mod.remove_captcha(ctx, toks[1]) if hasattr(mod, "remove_captcha") else False
                await self._respond(event, "<blockquote><b>captcha-</b> <code>%s</code> (%s)</blockquote>" % (html.escape(toks[1]), "ok" if ok else "not found"), parse_mode="html")
                return
            if action == "list":
                words = mod.list_captcha(ctx) if hasattr(mod, "list_captcha") else []
                await self._respond(event, "<blockquote><b>captcha words</b>: %d\n<code>%s</code></blockquote>" % (len(words), html.escape(", ".join(words) or "-")), parse_mode="html")
                return
            if action == "clear":
                if hasattr(mod, "clear_captcha"):
                    mod.clear_captcha(ctx)
                await self._respond(event, "<blockquote><b>cleared</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, self._help_rc(self._prefix()), parse_mode="html")
            return
        if sub == "ua":
            if action == "add" and len(toks) > 2:
                if hasattr(mod, "add_ua"):
                    mod.add_ua(ctx, toks[1], toks[2])
                    await self._respond(event, "<blockquote><b>ua+</b> <code>%s</code></blockquote>" % html.escape(toks[1]), parse_mode="html")
                return
            if action == "remove" and len(toks) > 1:
                region = toks[1]
                idx = int(toks[2]) if len(toks) > 2 and toks[2].isdigit() else -1
                if hasattr(mod, "remove_ua"):
                    mod.remove_ua(ctx, region, idx)
                    await self._respond(event, "<blockquote><b>ua-</b> <code>%s</code></blockquote>" % html.escape(region), parse_mode="html")
                return
            if action == "list":
                regs = mod.list_ua(ctx) if hasattr(mod, "list_ua") else {}
                out = ["<blockquote><b>ua regions</b></blockquote>"]
                for r, uas in regs.items():
                    out.append("<b>%s</b>: %d" % (html.escape(r), len(uas)))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if action == "clear":
                if hasattr(mod, "clear_ua"):
                    mod.clear_ua(ctx)
                await self._respond(event, "<blockquote><b>cleared</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, self._help_rc(self._prefix()), parse_mode="html")
            return
        await self._respond(event, self._help_rc(self._prefix()), parse_mode="html")

    async def _handle_cfg(self, event, args, sender, role, p):
        parts = args.split(maxsplit=2)
        if len(parts) < 2:
            await self._respond(event, self._help_cfg(p), parse_mode="html")
            return
        sub = parts[1].lower()
        tail = parts[2] if len(parts) > 2 else ""
        if sub == "get":
            key = tail.strip()
            if not key:
                await self._respond(event, "<blockquote><b>need key</b></blockquote>", parse_mode="html")
                return
            val = self._cfg_mgr.get(key)
            schema = self._cfg_mgr.schema_for(key)
            await self._respond(event, "<blockquote><b>%s</b> = <code>%s</code>\n<i>type: %s default: %s</i></blockquote>" % (html.escape(key), html.escape(json.dumps(val, ensure_ascii=False)), schema.get("type"), html.escape(json.dumps(schema.get("default"), ensure_ascii=False))), parse_mode="html")
            return
        if sub == "set":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            toks = tail.split(maxsplit=1)
            if len(toks) < 2:
                await self._respond(event, "<blockquote><b>need key and value</b></blockquote>", parse_mode="html")
                return
            key, raw = toks[0], toks[1].strip()
            try:
                val = json.loads(raw)
            except Exception:
                val = raw
            try:
                self._cfg_mgr.set(key, val, actor=str(sender))
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            self._audit_log(sender, "cfg_set", "%s=%s" % (key, raw[:80]))
            await self._respond(event, "<blockquote><b>%s</b> → <code>%s</code></blockquote>" % (html.escape(key), html.escape(str(val))), parse_mode="html")
            return
        if sub == "reset":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            key = tail.strip()
            if not key:
                await self._respond(event, "<blockquote><b>need key</b></blockquote>", parse_mode="html")
                return
            ok = self._cfg_mgr.reset(key, actor=str(sender))
            await self._respond(event, "<blockquote><b>%s</b> %s</blockquote>" % (html.escape(key), "reset" if ok else "no default"), parse_mode="html")
            return
        if sub == "del":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            key = tail.strip()
            if not key:
                return
            try:
                self._cfg_mgr.set(key, None, actor=str(sender))
            except Exception:
                pass
            await self._respond(event, "<blockquote><b>%s</b> deleted</blockquote>" % html.escape(key), parse_mode="html")
            return
        if sub == "list":
            section = tail.strip() if tail.strip() else None
            if section:
                data = self._cfg_mgr.section(section)
                out = ["<blockquote><b>cfg %s</b></blockquote>" % html.escape(section)]
                for k in sorted(data.keys()):
                    out.append("<code>%s</code> = <code>%s</code>" % (html.escape(k), html.escape(json.dumps(data[k], ensure_ascii=False))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            out = ["<blockquote><b>sections</b></blockquote>"]
            for s in CFG_SECTIONS:
                out.append("<code>%s</code> — %d keys" % (html.escape(s), len(CFG_DEFAULTS.get(s, {}))))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "sections":
            out = ["<blockquote><b>sections</b></blockquote>"]
            for s in CFG_SECTIONS:
                out.append("<code>%s</code> — %d keys" % (html.escape(s), len(CFG_DEFAULTS.get(s, {}))))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "dump":
            payload = json.dumps(self._cfg_mgr.flat(), ensure_ascii=False, indent=2)
            if len(payload) < 3500:
                await self._respond(event, "<blockquote><b>dump</b></blockquote>\n<pre>%s</pre>" % html.escape(payload), parse_mode="html")
                return
            try:
                await event.client.send_file(event.chat_id, payload.encode("utf-8"), file_name="ddt_cfg.json")
            except Exception:
                pass
            return
        if sub == "diff":
            flat = self._cfg_mgr.flat()
            diff = {}
            for section, defaults in CFG_DEFAULTS.items():
                for k, v in defaults.items():
                    key = "%s.%s" % (section, k)
                    cur = flat.get(key)
                    if cur != v:
                        diff[key] = {"current": cur, "default": v}
            if not diff:
                await self._respond(event, "<blockquote><b>no diff</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>diff</b></blockquote>"]
            for key, dd in list(diff.items())[:30]:
                out.append("<code>%s</code>: <code>%s</code> (def %s)" % (html.escape(key), html.escape(str(dd["current"])), html.escape(str(dd["default"]))))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "schema":
            key = tail.strip()
            if not key:
                return
            schema = self._cfg_mgr.schema_for(key)
            await self._respond(event, "<blockquote><b>%s</b>\n<b>type:</b> <code>%s</code>\n<b>default:</b> <code>%s</code>\n<b>section:</b> <code>%s</code></blockquote>" % (html.escape(key), schema.get("type"), html.escape(json.dumps(schema.get("default"), ensure_ascii=False)), schema.get("section")), parse_mode="html")
            return
        if sub == "validate":
            errors = self._cfg_mgr.validate()
            if errors:
                out = ["<blockquote><b>errors</b></blockquote>"] + ["• <code>%s</code>" % html.escape(e) for e in errors]
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>✅ valid</b></blockquote>", parse_mode="html")
            return
        if sub == "search":
            pattern = tail.strip().lower()
            if not pattern:
                return
            flat = self._cfg_mgr.flat()
            matches = [k for k in flat if pattern in k.lower()]
            if not matches:
                await self._respond(event, "<blockquote><b>no match</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>search</b></blockquote>"]
            for k in matches[:30]:
                out.append("<code>%s</code> = <code>%s</code>" % (html.escape(k), html.escape(json.dumps(flat[k], ensure_ascii=False))))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "history":
            key = tail.strip() if tail.strip() else None
            if key:
                h = self._cfg_mgr.history.get(key)
                if not h:
                    await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                    return
                out = ["<blockquote><b>history %s</b></blockquote>" % html.escape(key)]
                for rec in h[-20:][::-1]:
                    out.append("<code>%s</code> %s → %s" % (time.strftime("%H:%M", time.localtime(rec["ts"])), html.escape(str(rec["old"])), html.escape(str(rec["new"]))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            out = ["<blockquote><b>history</b></blockquote>"]
            for k, h in self._cfg_mgr.history.all().items():
                if h:
                    out.append("<code>%s</code> — %s" % (html.escape(k), html.escape(str(h[-1]["new"])[:50])))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "profile":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>profile use|save|list|delete</b></blockquote>", parse_mode="html")
                return
            toks = parts[2].split()
            psub = toks[0].lower() if toks else ""
            name = toks[1] if len(toks) > 1 else ""
            if psub == "use":
                if not name:
                    return
                ok = self._cfg_mgr.use_profile(name)
                await self._respond(event, "<blockquote><b>%s</b> %s</blockquote>" % (html.escape(name), "applied" if ok else "failed"), parse_mode="html")
                return
            if psub == "save":
                if not name:
                    return
                self._cfg_mgr.profiles.save(name, self._cfg_mgr.all())
                await self._respond(event, "<blockquote><b>saved:</b> <code>%s</code></blockquote>" % html.escape(name), parse_mode="html")
                return
            if psub == "list":
                pdata = self._cfg_mgr.profiles.list()
                out = ["<blockquote><b>profiles</b></blockquote>"]
                out.append("<b>builtin:</b> " + ", ".join("<code>%s</code>" % b for b in pdata["builtin"]))
                if pdata["custom"]:
                    out.append("<b>custom:</b> " + ", ".join("<code>%s</code>" % c for c in pdata["custom"]))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if psub == "delete":
                if not name:
                    return
                ok = self._cfg_mgr.profiles.delete(name)
                await self._respond(event, "<blockquote><b>%s</b> %s</blockquote>" % (html.escape(name), "deleted" if ok else "not found"), parse_mode="html")
                return
            return
        if sub == "export":
            fmt = "json"
            fm = re.search(r"--format=(\w+)", tail)
            if fm:
                fmt = fm.group(1).lower()
            payload = self._cfg_mgr.export(fmt)
            try:
                await event.client.send_file(event.chat_id, payload, file_name="cfg.%s" % fmt)
            except Exception:
                pass
            return
        if sub == "import":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                await self._respond(event, "<blockquote><b>reply to json</b></blockquote>", parse_mode="html")
                return
            try:
                data = await reply.download_media(bytes)
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            merge = "--merge" in tail
            cnt, err = self._cfg_mgr.import_(data, merge=merge)
            if err:
                await self._respond(event, "<blockquote><b>import failed:</b> <code>%s</code></blockquote>" % html.escape(err), parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>imported:</b> <code>%d</code></blockquote>" % cnt, parse_mode="html")
            return
        if sub == "override":
            if len(parts) < 3:
                out = ["<blockquote><b>overrides</b></blockquote>"]
                for k, v in self._cfg_mgr.overrides.active().items():
                    out.append("<code>%s</code> = <code>%s</code>" % (html.escape(k), html.escape(str(v["value"]))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            toks = parts[2].split()
            if not toks:
                return
            if toks[0].lower() == "list":
                out = ["<blockquote><b>overrides</b></blockquote>"]
                for k, v in self._cfg_mgr.overrides.active().items():
                    out.append("<code>%s</code> = <code>%s</code>" % (html.escape(k), html.escape(str(v["value"]))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if toks[0].lower() == "clear":
                self._cfg_mgr.overrides.clear()
                await self._respond(event, "<blockquote><b>cleared</b></blockquote>", parse_mode="html")
                return
            if len(toks) < 2:
                return
            key, raw = toks[0], toks[1]
            try:
                val = json.loads(raw)
            except Exception:
                val = raw
            ttl = 3600
            tm = re.search(r"--ttl=(\d+)([smhd])", tail)
            if tm:
                n, u = int(tm.group(1)), tm.group(2)
                ttl = n * {"s": 1, "m": 60, "h": 3600, "d": 86400}[u]
            self._cfg_mgr.overrides.set(key, val, ttl=ttl)
            self._cfg_mgr.set(key, val, actor="override")
            await self._respond(event, "<blockquote><b>override:</b> <code>%s</code> = <code>%s</code> (%ss)</blockquote>" % (html.escape(key), html.escape(str(val)), ttl), parse_mode="html")
            return
        if sub == "bulk":
            if len(parts) < 3:
                return
            toks = parts[2].split()
            if not toks:
                return
            bsub = toks[0].lower()
            if bsub == "set":
                if not self._role_gte(role, "owner"):
                    return
                cnt = 0
                for tok in toks[1:]:
                    if "=" not in tok:
                        continue
                    k, v = tok.split("=", 1)
                    try:
                        val = json.loads(v)
                    except Exception:
                        val = v
                    try:
                        self._cfg_mgr.set(k, val, actor=str(sender))
                        cnt += 1
                    except Exception:
                        continue
                await self._respond(event, "<blockquote><b>bulk set:</b> <code>%d</code></blockquote>" % cnt, parse_mode="html")
                return
            if bsub == "reset":
                if not self._role_gte(role, "owner"):
                    return
                for k in toks[1:]:
                    self._cfg_mgr.reset(k)
                await self._respond(event, "<blockquote><b>bulk reset</b></blockquote>", parse_mode="html")
                return
            return
        if sub == "watch":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>watch &lt;key&gt;</b></blockquote>", parse_mode="html")
                return
            key = parts[2].strip()
            await self._respond(event, "<blockquote><b>watching:</b> <code>%s</code></blockquote>" % html.escape(key), parse_mode="html")
            return
        if sub == "env":
            out = ["<blockquote><b>env DDT_*</b></blockquote>"]
            any_found = False
            for section in CFG_SECTIONS:
                for k in CFG_DEFAULTS.get(section, {}):
                    ek = "DDT_%s_%s" % (section.upper(), k.upper())
                    val = os.environ.get(ek)
                    if val is not None:
                        any_found = True
                        out.append("<code>%s</code> = <code>%s</code>" % (ek, html.escape(val)))
            if not any_found:
                out.append("<i>no DDT_* env vars set</i>")
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if sub == "help":
            await self._respond(event, self._help_cfg(p), parse_mode="html")
            return
        await self._respond(event, "<blockquote><b>unknown cfg sub</b> <code>%s</code></blockquote>" % html.escape(sub), parse_mode="html")

    async def _git_push_file(self, repo, branch, path, content, message):
        if shutil.which("git") is None:
            return False, "git not found"
        token = self._cfg_mgr.get("plugins.repo_token", "")
        local_path = Path(self._cfg_mgr.get("plugins.repo_local_path", "data/dontdothat_repo"))
        try:
            if not (local_path / ".git").exists():
                local_path.parent.mkdir(parents=True, exist_ok=True)
                url = "https://%s@github.com/%s.git" % (token, repo) if token else "https://github.com/%s.git" % repo
                r = await asyncio.to_thread(lambda: subprocess.run(["git", "clone", "--depth", "1", "--branch", branch, url, str(local_path)], capture_output=True, text=True, timeout=180))
                if r.returncode != 0:
                    return False, "clone: %s" % ((r.stderr or r.stdout) or "")[:200]
            else:
                await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "pull", "--rebase"], capture_output=True, text=True, timeout=60))
            target = local_path / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content, encoding="utf-8")
            name = self._cfg_mgr.get("plugins.repo_commit_name", "DontDoThatADM")
            email = self._cfg_mgr.get("plugins.repo_commit_email", "ddt@local")
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "add", path], capture_output=True, text=True, timeout=30))
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "-c", "user.name=" + name, "-c", "user.email=" + email, "commit", "-m", message], capture_output=True, text=True, timeout=30))
            r = await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "push"], capture_output=True, text=True, timeout=90))
            if r.returncode != 0:
                return False, "push: %s" % ((r.stderr or r.stdout) or "")[:200]
            return True, "ok"
        except Exception as e:
            return False, str(e)[:200]

    async def _git_delete_file(self, repo, branch, path, message):
        if shutil.which("git") is None:
            return False, "git not found"
        local_path = Path(self._cfg_mgr.get("plugins.repo_local_path", "data/dontdothat_repo"))
        if not (local_path / ".git").exists():
            return False, "no local repo"
        target = local_path / path
        if not target.exists():
            return False, "not found"
        try:
            target.unlink()
            name = self._cfg_mgr.get("plugins.repo_commit_name", "DontDoThatADM")
            email = self._cfg_mgr.get("plugins.repo_commit_email", "ddt@local")
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "rm", path], capture_output=True, text=True, timeout=30))
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "-c", "user.name=" + name, "-c", "user.email=" + email, "commit", "-m", message], capture_output=True, text=True, timeout=30))
            r = await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "push"], capture_output=True, text=True, timeout=90))
            return r.returncode == 0, "ok" if r.returncode == 0 else "push failed"
        except Exception as e:
            return False, str(e)[:200]

    async def _git_update_index(self, repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, access, tags):
        local_path = Path(self._cfg_mgr.get("plugins.repo_local_path", "data/dontdothat_repo"))
        if not (local_path / ".git").exists():
            return False, "no local repo"
        index_path = local_path / "index.json"
        if index_path.exists():
            try:
                index = json.loads(index_path.read_text(encoding="utf-8"))
            except Exception:
                index = {"schema": 2, "updated": time.strftime("%Y-%m-%d"), "plugins": []}
        else:
            index = {"schema": 2, "updated": time.strftime("%Y-%m-%d"), "plugins": []}
        if not isinstance(index.get("plugins"), list):
            index["plugins"] = []
        index["updated"] = time.strftime("%Y-%m-%d")
        existing = None
        for i, p in enumerate(index["plugins"]):
            if p.get("name", "").lower() == plugin_name.lower():
                existing = i
                break
        entry = {"name": plugin_name, "file": path_in_repo, "version": version, "author": author, "description": description, "min_core": min_core, "sha256": sha, "access": access or [], "tags": tags or []}
        if existing is not None:
            index["plugins"][existing] = entry
        else:
            index["plugins"].append(entry)
        index_path.write_text(json.dumps(index, ensure_ascii=False, indent=4), encoding="utf-8")
        try:
            name = self._cfg_mgr.get("plugins.repo_commit_name", "DontDoThatADM")
            email = self._cfg_mgr.get("plugins.repo_commit_email", "ddt@local")
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "add", "index.json"], capture_output=True, text=True, timeout=30))
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "-c", "user.name=" + name, "-c", "user.email=" + email, "commit", "-m", "Update index for %s" % plugin_name], capture_output=True, text=True, timeout=30))
            r = await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "push"], capture_output=True, text=True, timeout=90))
            return r.returncode == 0, "ok"
        except Exception as e:
            return False, str(e)[:200]

    async def _git_remove_from_index(self, repo, branch, plugin_name):
        local_path = Path(self._cfg_mgr.get("plugins.repo_local_path", "data/dontdothat_repo"))
        if not (local_path / ".git").exists():
            return False, "no local repo"
        index_path = local_path / "index.json"
        if not index_path.exists():
            return False, "no index"
        try:
            index = json.loads(index_path.read_text(encoding="utf-8"))
            index["plugins"] = [p for p in index.get("plugins", []) if p.get("name", "").lower() != plugin_name.lower()]
            index["updated"] = time.strftime("%Y-%m-%d")
            index_path.write_text(json.dumps(index, ensure_ascii=False, indent=4), encoding="utf-8")
            name = self._cfg_mgr.get("plugins.repo_commit_name", "DontDoThatADM")
            email = self._cfg_mgr.get("plugins.repo_commit_email", "ddt@local")
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "add", "index.json"], capture_output=True, text=True, timeout=30))
            await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "-c", "user.name=" + name, "-c", "user.email=" + email, "commit", "-m", "Remove %s from index" % plugin_name], capture_output=True, text=True, timeout=30))
            r = await asyncio.to_thread(lambda: subprocess.run(["git", "-C", str(local_path), "push"], capture_output=True, text=True, timeout=90))
            return r.returncode == 0, "ok"
        except Exception as e:
            return False, str(e)[:200]

    async def _http_put_file(self, token, repo, branch, path, content, message):
        url = "https://api.github.com/repos/%s/contents/%s" % (repo, path)
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        sha = await self._http_get_file_sha(token, repo, branch, path)
        body = {"message": message, "content": base64.b64encode(content.encode("utf-8")).decode("ascii"), "branch": branch}
        if sha:
            body["sha"] = sha
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=30) as client:
                    r = await client.put(url, headers=headers, json=body)
                    return r.status_code in (200, 201), "%s %s" % (r.status_code, r.text[:200])
            return False, "no httpx"
        except Exception as e:
            return False, str(e)[:200]

    async def _http_delete_file(self, token, repo, branch, path, message):
        sha = await self._http_get_file_sha(token, repo, branch, path)
        if not sha:
            return False, "file not found"
        url = "https://api.github.com/repos/%s/contents/%s" % (repo, path)
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        body = {"message": message, "sha": sha, "branch": branch}
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=30) as client:
                    r = await client.request("DELETE", url, headers=headers, json=body)
                    return r.status_code in (200, 204), "%s" % r.status_code
            return False, "no httpx"
        except Exception as e:
            return False, str(e)[:200]

    async def _http_get_file_sha(self, token, repo, branch, path):
        url = "https://api.github.com/repos/%s/contents/%s?ref=%s" % (repo, path, branch)
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=15) as client:
                    r = await client.get(url, headers=headers)
                    if r.status_code == 200:
                        return r.json().get("sha")
            return None
        except Exception:
            return None

    async def _http_get_file(self, token, repo, branch, path):
        url = "https://api.github.com/repos/%s/contents/%s?ref=%s" % (repo, path, branch)
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=15) as client:
                    r = await client.get(url, headers=headers)
                    if r.status_code == 200:
                        data = r.json()
                        return base64.b64decode(data.get("content", "")).decode("utf-8"), data.get("sha")
            return None, None
        except Exception:
            return None, None

    async def _http_update_index(self, token, repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, access, tags):
        content, current_sha = await self._http_get_file(token, repo, branch, "index.json")
        if content:
            try:
                index = json.loads(content)
            except Exception:
                index = {"schema": 2, "updated": time.strftime("%Y-%m-%d"), "plugins": []}
        else:
            index = {"schema": 2, "updated": time.strftime("%Y-%m-%d"), "plugins": []}
        if not isinstance(index.get("plugins"), list):
            index["plugins"] = []
        index["updated"] = time.strftime("%Y-%m-%d")
        existing = None
        for i, p in enumerate(index["plugins"]):
            if p.get("name", "").lower() == plugin_name.lower():
                existing = i
                break
        entry = {"name": plugin_name, "file": path_in_repo, "version": version, "author": author, "description": description, "min_core": min_core, "sha256": sha, "access": access or [], "tags": tags or []}
        if existing is not None:
            index["plugins"][existing] = entry
        else:
            index["plugins"].append(entry)
        new_content = json.dumps(index, ensure_ascii=False, indent=4)
        url = "https://api.github.com/repos/%s/contents/index.json" % repo
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        body = {"message": "Update index for %s" % plugin_name, "content": base64.b64encode(new_content.encode("utf-8")).decode("ascii"), "branch": branch}
        if current_sha:
            body["sha"] = current_sha
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=30) as client:
                    r = await client.put(url, headers=headers, json=body)
                    return r.status_code in (200, 201), "%s" % r.status_code
            return False, "no httpx"
        except Exception as e:
            return False, str(e)[:200]

    async def _http_remove_from_index(self, token, repo, branch, plugin_name):
        content, current_sha = await self._http_get_file(token, repo, branch, "index.json")
        if not content:
            return False, "no index"
        try:
            index = json.loads(content)
        except Exception:
            return False, "invalid index"
        index["plugins"] = [p for p in index.get("plugins", []) if p.get("name", "").lower() != plugin_name.lower()]
        index["updated"] = time.strftime("%Y-%m-%d")
        new_content = json.dumps(index, ensure_ascii=False, indent=4)
        url = "https://api.github.com/repos/%s/contents/index.json" % repo
        headers = {"Authorization": "token %s" % token, "Accept": "application/vnd.github.v3+json", "User-Agent": "DontDoThatADM"}
        body = {"message": "Remove %s from index" % plugin_name, "content": base64.b64encode(new_content.encode("utf-8")).decode("ascii"), "branch": branch, "sha": current_sha}
        try:
            if _HAS_HTTPX:
                async with httpx.AsyncClient(timeout=30) as client:
                    r = await client.put(url, headers=headers, json=body)
                    return r.status_code in (200, 201), "%s" % r.status_code
            return False, "no httpx"
        except Exception as e:
            return False, str(e)[:200]

    async def _add_to_repo(self, event, sender, tail):
        token = self._cfg_mgr.get("plugins.repo_token", "")
        repo = self._cfg_mgr.get("plugins.repo", "flexOwnerAL/dontdothat-plugins")
        branch = self._cfg_mgr.get("plugins.repo_branch", "main")
        method = self._cfg_mgr.get("plugins.repo_method", "auto")
        _, flags = self._parse_flags(tail or "")
        if isinstance(flags.get("method"), str):
            method = flags["method"].lower()
        reply = None
        try:
            reply = await event.get_reply_message()
        except Exception:
            reply = None
        if reply is None:
            await self._respond(event, "<blockquote><b>reply to .py</b></blockquote>", parse_mode="html")
            return
        fname = None
        doc = getattr(reply, "document", None)
        if doc is not None:
            for a in getattr(doc, "attributes", []) or []:
                n = getattr(a, "file_name", None)
                if n:
                    fname = n
                    break
        if not fname or not fname.endswith((".py", ".ddt")):
            await self._respond(event, "<blockquote><b>file must be .py or .ddt</b></blockquote>", parse_mode="html")
            return
        if fname.endswith(".py"):
            try:
                self.log.warning("ddt repo: prefer .ddt over .py for new plugins: %s", fname)
            except Exception:
                pass
        try:
            data = await reply.download_media(bytes)
        except Exception as e:
            await self._respond(event, "<blockquote><b>download failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        try:
            import ast
            ast.parse(data.decode("utf-8", errors="ignore"))
        except SyntaxError as e:
            await self._respond(event, "<blockquote><b>syntax error:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        content = data.decode("utf-8", errors="ignore")
        sha = hashlib.sha256(data).hexdigest()
        plugin_name = Path(fname).stem
        version = "1.0.0"
        author = "@unknown"
        description = ""
        min_core = "6.7.0"
        for pat, setter in (
            (r'name\s*[:=]\s*["\']([^"\']+)["\']', "name"),
            (r'version\s*[:=]\s*["\']([^"\']+)["\']', "version"),
            (r'author\s*[:=]\s*["\']([^"\']+)["\']', "author"),
            (r'description\s*[:=]\s*["\']([^"\']+)["\']', "description"),
            (r'min_core\s*[:=]\s*["\']([^"\']+)["\']', "min_core"),
        ):
            m = re.search(pat, content)
            if not m:
                continue
            if setter == "name":
                plugin_name = m.group(1)
            elif setter == "version":
                version = m.group(1)
            elif setter == "author":
                author = m.group(1)
            elif setter == "description":
                description = m.group(1)
            elif setter == "min_core":
                min_core = m.group(1)
        await self._respond(event, "<blockquote><b>pushing..</b></blockquote>", parse_mode="html")
        ext = ".ddt" if fname.lower().endswith(".ddt") else ".py"
        path_in_repo = "plugins/%s%s" % (plugin_name, ext)
        ok = False
        msg = ""
        used = ""
        if method in ("git", "auto"):
            ok, msg = await self._git_push_file(repo, branch, path_in_repo, content, "Add %s v%s" % (plugin_name, version))
            used = "git"
        if not ok and method in ("http", "auto"):
            if not token:
                msg = "no token for http"
            else:
                ok, msg = await self._http_put_file(token, repo, branch, path_in_repo, content, "Add %s v%s" % (plugin_name, version))
                used = "http"
        if not ok:
            await self._respond(event, "<blockquote><b>push failed:</b> <code>%s</code></blockquote>" % html.escape(str(msg)), parse_mode="html")
            return
        index_ok = False
        if used == "http" and token:
            index_ok, _ = await self._http_update_index(token, repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, [], [])
        if not index_ok:
            index_ok, _ = await self._git_update_index(repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, [], [])
        self._repo_index_cache = {}
        self._audit_log(sender, "add_to_repo", "%s %s" % (plugin_name, path_in_repo))
        await self._respond(event, "<blockquote><b>✅ pushed:</b> <code>%s</code>\n<b>file:</b> <code>%s</code>\n<b>method:</b> <code>%s</code>\n<b>sha256:</b> <code>%s...</code></blockquote>" % (html.escape(plugin_name), html.escape(path_in_repo), used, sha[:16]), parse_mode="html")

    async def _remove_from_repo(self, event, name, sender):
        token = self._cfg_mgr.get("plugins.repo_token", "")
        repo = self._cfg_mgr.get("plugins.repo", "flexOwnerAL/dontdothat-plugins")
        branch = self._cfg_mgr.get("plugins.repo_branch", "main")
        path_in_repo = "plugins/%s.py" % name
        ok, msg = await self._git_delete_file(repo, branch, path_in_repo, "Remove %s" % name)
        if not ok and token:
            ok, msg = await self._http_delete_file(token, repo, branch, path_in_repo, "Remove %s" % name)
        if not ok:
            await self._respond(event, "<blockquote><b>delete failed:</b> <code>%s</code></blockquote>" % html.escape(str(msg)), parse_mode="html")
            return
        if token:
            await self._http_remove_from_index(token, repo, branch, name)
        else:
            await self._git_remove_from_index(repo, branch, name)
        self._repo_index_cache = {}
        self._audit_log(sender, "remove_from_repo", name)
        await self._respond(event, "<blockquote><b>✅ removed:</b> <code>%s</code></blockquote>" % html.escape(name), parse_mode="html")

    async def _update_in_repo(self, event, sender):
        token = self._cfg_mgr.get("plugins.repo_token", "")
        repo = self._cfg_mgr.get("plugins.repo", "flexOwnerAL/dontdothat-plugins")
        branch = self._cfg_mgr.get("plugins.repo_branch", "main")
        reply = None
        try:
            reply = await event.get_reply_message()
        except Exception:
            reply = None
        if reply is None:
            await self._respond(event, "<blockquote><b>reply to .py</b></blockquote>", parse_mode="html")
            return
        fname = None
        doc = getattr(reply, "document", None)
        if doc is not None:
            for a in getattr(doc, "attributes", []) or []:
                n = getattr(a, "file_name", None)
                if n:
                    fname = n
                    break
        if not fname or not fname.endswith((".py", ".ddt")):
            await self._respond(event, "<blockquote><b>file must be .py or .ddt</b></blockquote>", parse_mode="html")
            return
        if fname.endswith(".py"):
            try:
                self.log.warning("ddt repo: prefer .ddt over .py for new plugins: %s", fname)
            except Exception:
                pass
        try:
            data = await reply.download_media(bytes)
        except Exception as e:
            await self._respond(event, "<blockquote><b>download failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        content = data.decode("utf-8", errors="ignore")
        sha = hashlib.sha256(data).hexdigest()
        plugin_name = Path(fname).stem
        version = "1.0.0"
        author = "@unknown"
        description = ""
        min_core = "6.7.0"
        for pat, setter in (
            (r'name\s*[:=]\s*["\']([^"\']+)["\']', "name"),
            (r'version\s*[:=]\s*["\']([^"\']+)["\']', "version"),
            (r'author\s*[:=]\s*["\']([^"\']+)["\']', "author"),
            (r'description\s*[:=]\s*["\']([^"\']+)["\']', "description"),
            (r'min_core\s*[:=]\s*["\']([^"\']+)["\']', "min_core"),
        ):
            m = re.search(pat, content)
            if not m:
                continue
            if setter == "name":
                plugin_name = m.group(1)
            elif setter == "version":
                version = m.group(1)
            elif setter == "author":
                author = m.group(1)
            elif setter == "description":
                description = m.group(1)
            elif setter == "min_core":
                min_core = m.group(1)
        ext = ".ddt" if fname.lower().endswith(".ddt") else ".py"
        path_in_repo = "plugins/%s%s" % (plugin_name, ext)
        await self._respond(event, "<blockquote><b>updating..</b></blockquote>", parse_mode="html")
        ok, msg = await self._git_push_file(repo, branch, path_in_repo, content, "Update %s v%s" % (plugin_name, version))
        if not ok and token:
            ok, msg = await self._http_put_file(token, repo, branch, path_in_repo, content, "Update %s v%s" % (plugin_name, version))
        if not ok:
            await self._respond(event, "<blockquote><b>push failed:</b> <code>%s</code></blockquote>" % html.escape(str(msg)), parse_mode="html")
            return
        if token:
            await self._http_update_index(token, repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, [], [])
        else:
            await self._git_update_index(repo, branch, plugin_name, path_in_repo, version, author, description, min_core, sha, [], [])
        self._repo_index_cache = {}
        self._audit_log(sender, "update_in_repo", plugin_name)
        await self._respond(event, "<blockquote><b>✅ updated:</b> <code>%s</code> v<code>%s</code></blockquote>" % (html.escape(plugin_name), html.escape(version)), parse_mode="html")

    async def _repo_index(self, force=False):
        ttl = int(self._cfg_mgr.get("plugins.index_ttl", 3600) or 3600)
        now = time.time()
        if not force and self._repo_index_cache and now - self._repo_index_cache.get("ts", 0) < ttl:
            return self._repo_index_cache.get("data")
        repo = self._cfg_mgr.get("plugins.repo", "flexOwnerAL/dontdothat-plugins")
        branch = self._cfg_mgr.get("plugins.repo_branch", "main")
        url = "https://raw.githubusercontent.com/%s/%s/index.json" % (repo, branch)
        try:
            text, _ = await self._http_request(url, headers={"Accept": "application/json"})
            data = json.loads(text)
            self._repo_index_cache = {"ts": now, "data": data}
            return data
        except Exception:
            return self._repo_index_cache.get("data")

    async def _repo_fetch_plugin(self, file_path):
        repo = self._cfg_mgr.get("plugins.repo", "flexOwnerAL/dontdothat-plugins")
        branch = self._cfg_mgr.get("plugins.repo_branch", "main")
        url = "https://raw.githubusercontent.com/%s/%s/%s" % (repo, branch, file_path)
        try:
            text, _ = await self._http_request(url)
            return text
        except Exception:
            return None

    async def _repo_update(self, name=None):
        data = await self._repo_index(force=True)
        if not data:
            return []
        updated = []
        for p in data.get("plugins", []):
            pname = p.get("name")
            if not pname:
                continue
            key = pname.lower().replace(" ", "_")
            if key not in self._plugins:
                continue
            if name and pname.lower() != name.lower():
                continue
            cur = (self._plugins[key].get("manifest") or {}).get("version", "?")
            new = p.get("version", "?")
            if cur == new:
                continue
            ok, res = await self._repo_install(pname)
            if ok:
                updated.append((pname, cur, new))
        return updated

    async def _repo_install(self, name):
        data = await self._repo_index(force=True)
        if not data or not isinstance(data.get("plugins"), list):
            return False, "repo unavailable"
        entry = None
        for p in data["plugins"]:
            if p.get("name", "").lower() == name.lower():
                entry = p
                break
        if entry is None:
            return False, "not found"
        content = await self._repo_fetch_plugin(entry.get("file", ""))
        if not content:
            return False, "download failed"
        expected = entry.get("sha256") or ""
        actual = hashlib.sha256(content.encode("utf-8")).hexdigest()
        if expected and actual != expected:
            return False, "sha256 mismatch"
        file_name = str(entry.get("file") or "")
        ext = ".ddt" if file_name.lower().endswith(".ddt") else ".py"
        target = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")) / ("%s%s" % (entry.get("name", name), ext))
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")
        ok, reg_name, info = await self._load_plugin_any(target)
        if not ok:
            return False, reg_name
        return True, info

    async def _install_from_reply(self, event):
        reply = None
        try:
            reply = await event.get_reply_message()
        except Exception:
            reply = None
        if reply is None:
            return False, "reply to .py", {}
        fname = None
        doc = getattr(reply, "document", None)
        if doc is not None:
            for a in getattr(doc, "attributes", []) or []:
                n = getattr(a, "file_name", None)
                if n:
                    fname = n
                    break
        if not fname or not fname.endswith((".py", ".ddt")):
            return False, "file must be .py or .ddt", {}
        try:
            data = await reply.download_media(bytes)
        except Exception as e:
            return False, "download: %s" % e, {}
        try:
            import ast
            ast.parse(data.decode("utf-8", errors="ignore"))
        except SyntaxError as e:
            return False, "syntax: %s" % e, {}
        target = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")) / fname
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
        return await self._load_plugin_any(target)

    async def _validate_plugin_file(self, raw_path):
        p = Path(raw_path.strip())
        if not p.exists():
            return "<blockquote><b>not found:</b> <code>%s</code></blockquote>" % html.escape(str(p))
        ext = p.suffix.lower()
        if ext not in (".py", ".ddt"):
            return "<blockquote><b>bad extension</b> (need .py or .ddt)</blockquote>"
        try:
            code = p.read_text(encoding="utf-8")
        except Exception as e:
            return "<blockquote><b>read failed:</b> <code>%s</code></blockquote>" % html.escape(str(e))
        warnings = []
        if ext == ".ddt":
            first_line = (code.split("\n", 1)[0] or "").strip()
            if not first_line.startswith("#!ddt"):
                warnings.append("missing magic header <code>#!ddt &lt;version&gt;</code>")
        try:
            import ast as _ast
            _ast.parse(code)
        except SyntaxError as e:
            return "<blockquote><b>syntax error:</b> <code>%s</code></blockquote>" % html.escape(str(e))
        try:
            mod = self._import_plugin_module(p)
        except Exception as e:
            return "<blockquote><b>import failed:</b> <code>%s</code></blockquote>" % html.escape(str(e))
        manifest = self._detect_manifest(mod)
        if manifest is None:
            return "<blockquote><b>manifest not found</b></blockquote>"
        name = manifest.get("name")
        if not name:
            return "<blockquote><b>manifest.name missing</b></blockquote>"
        api = str(manifest.get("api") or "")
        if ext == ".ddt" and not api.startswith("1.5"):
            return "<blockquote><b>.ddt requires api&gt;=1.5.0</b> (got <code>%s</code>)</blockquote>" % html.escape(api)
        if ext == ".ddt" and not isinstance(getattr(mod, "Plugin", None), type):
            return "<blockquote><b>.ddt requires class Plugin</b></blockquote>"
        key = str(name).lower().replace(" ", "_")
        missing = []
        for req in (manifest.get("requires") or []):
            rk = str(req).lower().replace(" ", "_")
            if rk and rk not in self._plugins:
                missing.append(str(req))
        conflict = []
        for conf in (manifest.get("conflicts") or []):
            ck = str(conf).lower().replace(" ", "_")
            if ck and ck in self._plugins:
                conflict.append(str(conf))
        src = "ddt" if ext == ".ddt" else "new"
        lines = ["<blockquote><b>validate: ok</b>"]
        lines.append("<b>file:</b> <code>%s</code>" % html.escape(p.name))
        lines.append("<b>name:</b> <code>%s</code>" % html.escape(str(name)))
        lines.append("<b>version:</b> <code>%s</code>" % html.escape(str(manifest.get("version", "?"))))
        lines.append("<b>author:</b> <code>%s</code>" % html.escape(str(manifest.get("author", "?"))))
        lines.append("<b>api:</b> <code>%s</code>" % html.escape(api or "-"))
        lines.append("<b>trust:</b> <code>%s</code>" % self._resolve_trust(key, manifest, source=src))
        missing, _ = self._resolve_requires(manifest.get("requires") or [])
        if missing:
            lines.append("<b>missing requires:</b> <code>%s</code>" % html.escape(", ".join(missing)))
        if conflict:
            lines.append("<b>conflicts:</b> <code>%s</code>" % html.escape(", ".join(conflict)))
        if warnings:
            lines.append("<b>warnings:</b> " + "; ".join(warnings))
        lines.append("</blockquote>")
        return "\n".join(lines)

    async def _notify_owner_trusted(self, event, action, details=""):
        if not self._cfg_mgr.get("roles.notify_owner_on_trusted", True):
            return
        try:
            owner_id = getattr(self.kernel.context, "admin_id", None)
            if not owner_id:
                return
            sid = self._sender_id(event)
            await event.client.send_message(owner_id, "🔔 <b>trusted</b>\nuser: <code>%s</code>\naction: %s\ndetails: <code>%s</code>" % (sid, html.escape(action), html.escape(details[:200])), parse_mode="html")
        except Exception:
            pass

    _SAFE_IMPORTS = frozenset({
        'dataclasses', 'typing', 're', 'json', 'math', 'time',
        'hashlib', 'hmac', 'random', 'asyncio', 'datetime',
        'collections', 'itertools', 'functools', 'string',
        'urllib', 'base64', 'uuid', 'textwrap', 'html',
        'os', 'sys', 'pathlib', 'sqlite3',
    })
    _DANGEROUS_CALLS = frozenset({
        'eval', 'exec', 'compile', '__import__',
        'system', 'popen', 'spawn', 'fork',
        'check_output', 'check_call', 'run', 'Popen',
        'urlopen', 'urlretrieve',
        'rmtree', 'unlink', 'remove', 'rmdir',
    })

    def _scan_imports(self, code_text):
        try:
            import ast as _ast
            tree = _ast.parse(code_text)
        except Exception:
            return [], []
        bad_mods = []
        bad_calls = []
        for node in _ast.walk(tree):
            if isinstance(node, _ast.Import):
                for alias in node.names:
                    top = alias.name.split('.')[0]
                    if top not in self._SAFE_IMPORTS:
                        bad_mods.append(alias.name)
            elif isinstance(node, _ast.ImportFrom):
                if node.module:
                    top = node.module.split('.')[0]
                    if top not in self._SAFE_IMPORTS and top != '__future__':
                        bad_mods.append(node.module)
            elif isinstance(node, _ast.Call):
                fname = None
                if isinstance(node.func, _ast.Name):
                    fname = node.func.id
                elif isinstance(node.func, _ast.Attribute):
                    fname = node.func.attr
                if fname and fname in self._DANGEROUS_CALLS:
                    bad_calls.append(fname)
        return list(dict.fromkeys(bad_mods)), list(dict.fromkeys(bad_calls))

    def _match_ctx(self, match, ctx_base):
        if not match:
            return True
        try:
            url = str(ctx_base.get('url') or '')
            host = urlparse(url).netloc.lower() if url else ''
            site = ctx_base.get('site') or {}
            tags = [str(t).lower() for t in (site.get('tags') or [])]
            domains = match.get('domain') or []
            if domains:
                okv = False
                for d in domains:
                    d = str(d).lower().strip()
                    if d.startswith('*.'):
                        base = d[1:]
                        if host.endswith(base) or ('.' + base.lstrip('.')) in host:
                            okv = True
                            break
                    elif d == host or host.endswith('.' + d):
                        okv = True
                        break
                if not okv:
                    return False
            mtags = match.get('tag') or []
            if mtags:
                wanted = [str(t).lower() for t in mtags]
                if not any(t in tags for t in wanted):
                    return False
            url_re = match.get('url_re')
            if url_re:
                try:
                    if not re.search(url_re, url):
                        return False
                except Exception:
                    pass
            name_globs = match.get('site_name') or []
            if name_globs:
                sname = str(ctx_base.get('name') or '').lower()
                if sname not in [str(n).lower() for n in name_globs]:
                    return False
        except Exception:
            pass
        return True

    def _resolve_requires(self, requires):
        if not requires:
            return [], []
        satisfied = set()
        for key in self._plugins.keys():
            satisfied.add(key)
            m = (self._plugins[key].get('manifest') or {})
            for p in (m.get('provides') or []):
                satisfied.add(str(p).lower().replace(' ', '_'))
        missing = []
        for req in requires:
            rk = str(req).lower().replace(' ', '_')
            if rk and rk not in satisfied:
                missing.append(str(req))
        return missing, list(satisfied)

    def _audit_capability(self, plugin_name, capability):
        try:
            c = self._sqlite_conn()
            if c is None:
                return
            with self._sqlite_lock:
                c.execute('CREATE TABLE IF NOT EXISTS plugin_audit (ts REAL, plugin TEXT, capability TEXT)')
                c.execute('INSERT INTO plugin_audit (ts, plugin, capability) VALUES (?,?,?)', (round(time.time(), 2), plugin_name, capability))
                c.commit()
        except Exception:
            pass

    @watcher
    async def trusted_watcher(self, event):
        if getattr(event, "_tetko_handled", False) or getattr(event, "_ddt_trusted", False):
            return
        if getattr(event, "out", False):
            return
        text = (getattr(event, "raw_text", "") or "").strip()
        if not text:
            return
        prefix = self._prefix()
        if not text.startswith(prefix):
            return
        body = text[len(prefix):].split(maxsplit=1)
        if not body:
            return
        cmd = body[0].lower()
        if cmd != "dothat":
            return
        sender = self._sender_id(event)
        if sender is None:
            return
        owner_id = getattr(self.kernel.context, "admin_id", None)
        if owner_id is not None and sender == owner_id:
            return
        role = self._role_of(event)
        if role is None:
            return
        if self._user_blocked(event):
            return
        if not self._chat_allowed(event):
            return
        tc = self._cfg_mgr.get("advanced.trusted_chat_id")
        if tc is not None:
            try:
                if event.chat_id != tc:
                    return
            except Exception:
                return
        muted_until = self._is_muted(sender)
        if muted_until:
            try:
                await event.reply("🚫 muted until %s" % time.strftime("%Y-%m-%d %H:%M", time.localtime(muted_until)))
            except Exception:
                pass
            return
        if not self._user_rate_ok(sender, event):
            try:
                await event.reply("🚫 rate limit")
            except Exception:
                pass
            return
        event._tetko_handled = True
        event._ddt_trusted = True
        self._audit_log(sender, "trusted_command", text[:200])
        await self._notify_owner_trusted(event, "command", text[:200])
        tlc = self._cfg_mgr.get("advanced.trusted_log_chat")
        if tlc:
            try:
                await event.client.send_message(tlc, "👤 <code>%s</code> → <code>%s</code>" % (sender, html.escape(text[:200])), parse_mode="html")
            except Exception:
                pass
        try:
            await self.dothat(event)
        except Exception as e:
            self._audit_log(sender, "trusted_error", str(e)[:200])
            try:
                await event.reply("❌ error: %s" % e)
            except Exception:
                pass

    @loop(interval=3600)
    async def healthcheck(self):
        sites = self._sites()
        if not sites:
            return
        sem = asyncio.Semaphore(5)
        st = {"ch": False}
        async def check(name, site):
            async with sem:
                tu = self._build_url(site, "test")
                try:
                    alive = await asyncio.wait_for(asyncio.to_thread(self._ping, tu), timeout=15)
                except Exception:
                    alive = False
                if site.get("alive") != alive:
                    site["alive"] = alive
                    st["ch"] = True
        await asyncio.gather(*(check(n, s) for n, s in sites.items()))
        if st["ch"]:
            self._save_sites(sites)

    @loop(interval=3600)
    async def auto_disable_dead(self):
        thr = int(self._cfg_mgr.get("plugins.error_threshold", 5) or 5)
        if thr <= 0:
            return
        fails = self._stats.get("per_source_fail", {}) or {}
        sites = self._sites()
        changed = False
        for name, count in list(fails.items()):
            if count >= thr and name in sites and not sites[name].get("disabled"):
                sites[name]["disabled"] = True
                changed = True
        if changed:
            self._save_sites(sites)

    @loop(interval=300)
    async def cleanup_pending(self):
        ttl = int(self._cfg_mgr.get("advanced.pending_actions_ttl", 86400) or 86400)
        if ttl <= 0:
            return
        pending = self._cfg_mgr.get("advanced.pending_actions") or {}
        if not pending:
            return
        now = time.time()
        new = {k: v for k, v in pending.items() if now - v.get("ts", 0) < ttl}
        if len(new) != len(pending):
            self._cfg_mgr.set("advanced.pending_actions", new)

    @loop(interval=300)
    async def auto_demote(self):
        thr = int(self._cfg_mgr.get("roles.auto_demote_threshold", 60) or 60)
        win = int(self._cfg_mgr.get("roles.auto_demote_window", 3600) or 3600)
        if thr <= 0:
            return
        now = time.time()
        try:
            owner_id = str(self.kernel.context.admin_id)
        except Exception:
            owner_id = None
        for uid, acts in list(self._user_activity.items()):
            if uid == owner_id:
                continue
            recent = [a for a in acts if now - a["ts"] < win]
            self._user_activity[uid] = recent
            if len(recent) >= thr:
                r = self._cfg_mgr.get("roles.roles") or {}
                demoted = None
                if int(uid) in (r.get("editors") or []):
                    self._set_role(int(uid), "verified")
                    demoted = "verified"
                elif int(uid) in (r.get("verified") or []):
                    self._set_role(int(uid), "contributor")
                    demoted = "contributor"
                elif int(uid) in (r.get("contributors") or []):
                    self._set_role(int(uid), "viewer")
                    demoted = "viewer"
                if demoted and owner_id:
                    try:
                        await self.kernel.client.send_message(int(owner_id), "⚠️ auto-demote <code>%s</code> → <code>%s</code>" % (uid, demoted), parse_mode="html")
                    except Exception:
                        pass

    @loop(interval=60)
    async def watch_runner(self):
        watchers = self._cfg_mgr.get("advanced.watchers") or []
        if not watchers:
            return
        now = time.time()
        changed = False
        for w in watchers:
            if w.get("next_run", 0) > now:
                continue
            q = w.get("query")
            if not q:
                w["next_run"] = now + int(w.get("interval", 3600))
                changed = True
                continue
            try:
                ok, err = await self._search_everywhere(q, actor="watcher")
            except Exception:
                ok, err = [], []
                w["next_run"] = now + max(60, int(w.get("interval", 3600)) * 2)
            else:
                w["next_run"] = now + int(w.get("interval", 3600))
            changed = True
            seen = set(w.get("seen") or [])
            new = [r for r in ok if r["url"] not in seen] if w.get("new_only") else ok
            for r in ok:
                seen.add(r["url"])
            w["seen"] = list(seen)[-500:]
            if new:
                try:
                    cid = getattr(self.kernel, "log_chat_id", None)
                    if cid:
                        text, _ = self._format_results(q, new)
                        await self.kernel.client.send_message(cid, text, parse_mode="html")
                except Exception:
                    pass
        if changed:
            self._cfg_mgr.set("advanced.watchers", watchers)

    @loop(interval=300)
    async def plugin_health_monitor(self):
        for name, info in list(self._plugins.items()):
            module_obj = info.get("module")
            if module_obj is None:
                continue
            fn = getattr(module_obj, "health", None)
            if not callable(fn):
                continue
            try:
                ctx = self._make_ctx(name, "health", {})
                h = fn(ctx)
                if asyncio.iscoroutine(h):
                    h = await h
                if isinstance(h, dict):
                    self._health_monitor.update(name, h.get("status", "unknown"), h.get("message", ""))
            except Exception:
                self._health_monitor.update(name, "failed", "")

    @command(name="dothat", description="Owner edition search")
    async def dothat(self, event):
        if self._cfg_mgr is None:
            return
        if not self._chat_allowed(event):
            return
        if self._user_blocked(event):
            await self._respond(event, "<blockquote><b>🚫 blocked</b></blockquote>", parse_mode="html")
            return
        args = self._args(event)
        p = self._prefix()
        sender = self._sender_id(event)
        chat_id = getattr(event, "chat_id", None)
        if not args:
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is not None:
                is_bot_msg = getattr(reply, "out", False) or bool(getattr(reply, "via_bot_id", None))
                if not is_bot_msg:
                    try:
                        s = await reply.get_sender()
                    except Exception:
                        s = None
                    un = getattr(s, "username", None) if s else None
                    if un:
                        args = "@%s" % un
                if not args:
                    await self._respond(event, self._usage(), parse_mode="html")
                    return
            else:
                await self._respond(event, self._usage(), parse_mode="html")
                return
        tag_filter = None
        tm = re.search(r"--tag=(\w+)", args)
        if tm:
            tag_filter = tm.group(1)
            args = re.sub(r"--tag=\w+", "", args).strip()
        to_chat = None
        to_m = re.search(r"--to=(-?\d+)", args)
        if to_m:
            to_chat = int(to_m.group(1))
            args = re.sub(r"--to=-?\d+", "", args).strip()
        parts = args.split(maxsplit=2)
        action = parts[0].lower() if parts else ""

        trusted = getattr(event, "_ddt_trusted", False)
        role = self._role_of(event)
        try:
            hook_result = await self._run_hook("on_command", {
                "event": event,
                "action": action,
                "args": args,
                "parts": parts,
                "sender": sender,
                "role": role,
                "prefix": p,
            })
            if hook_result is not None:
                return
        except Exception as e:
            try:
                self.log.warning("on_command hook failed: %s" % e)
            except Exception:
                pass

        if action == "help":
            section = parts[1].lower() if len(parts) > 1 else ""
            sub = parts[2].lower() if len(parts) > 2 else ""
            if section == "commands":
                text = self._help_commands(sub if sub in ROLE_ORDER else None)
                await self._respond(event, text, parse_mode="html")
                return
            if section == "search":
                text = self._help_search(p)
            elif section == "sources":
                text = self._help_sources(p)
            elif section == "diag":
                text = self._help_diag(p)
            elif section == "plugins":
                text = self._help_plugins(p)
            elif section == "repo":
                text = self._help_repo(p)
            elif section == "new":
                text = self._help_new(p)
            elif section == "cfg":
                text = self._help_cfg(p)
            elif section == "roles":
                text = self._help_roles(p)
            elif section == "service":
                text = self._help_service(p)
            elif section == "operators":
                text = self._help_operators(p)
            elif section == "rc":
                text = self._help_rc(p)
            else:
                text = self._help_main(p)
            await self._respond(event, text, parse_mode="html")
            return
        if action == "version":
            new_cnt = sum(1 for v in self._plugins.values() if v.get("source") == "new")
            old_cnt = sum(1 for v in self._plugins.values() if v.get("source") == "legacy")
            deps = []
            for nm, ok in (("curl_cffi", _HAS_CURL), ("httpx", _HAS_HTTPX), ("pymorphy2", _MORPH is not None)):
                deps.append("%s=%s" % (nm, "✓" if ok else "✗"))
            await self._respond(event, "<blockquote><b>DontDoThatADM</b> v%s (owner edition)\nplugins: %d (new %d / legacy %d)\nsites: %d\ndeps: %s\ncfg_lib: %s</blockquote>" % (self.version, len(self._plugins), new_cnt, old_cnt, len(self._sites()), " ".join(deps), "ok" if self._cfg_mgr else "fail"), parse_mode="html")
            return
        if action == "whoami":
            await self._respond(event, "<blockquote><b>role:</b> <code>%s</code></blockquote>" % html.escape(role or "none"), parse_mode="html")
            return
        if action == "my-stats":
            sid = str(sender)
            us = self._stats["per_user"].get(sid, 0)
            hist = [h for h in self._history if h.get("actor") == sid]
            await self._respond(event, "<blockquote><b>my stats</b>\nrole: <code>%s</code>\nsearches: <code>%d</code>\n%s</blockquote>" % (html.escape(role or "none"), us, "\n".join("<code>%s</code> — <code>%s</code>" % (time.strftime("%H:%M", time.localtime(h["ts"])), html.escape(h["query"][:60])) for h in hist[-10:])), parse_mode="html")
            return
        if trusted and role is None:
            return
        if action == "trust":
            if not self._role_gte(role, "owner"):
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                return
            try:
                t = await reply.get_sender()
                uid = getattr(t, "id", None)
            except Exception:
                uid = None
            if uid is None:
                return
            self._set_role(uid, "trusted")
            self._audit_log(sender, "trust", str(uid))
            await self._respond(event, "<blockquote><b>trusted:</b> <code>%s</code></blockquote>" % uid, parse_mode="html")
            return
        if action == "untrust":
            if not self._role_gte(role, "owner"):
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                return
            try:
                t = await reply.get_sender()
                uid = getattr(t, "id", None)
            except Exception:
                uid = None
            if uid is None:
                return
            self._remove_role(uid)
            await self._respond(event, "<blockquote><b>untrusted:</b> <code>%s</code></blockquote>" % uid, parse_mode="html")
            return
        if action == "trusted":
            r = self._cfg_mgr.get("roles.roles") or {}
            all_ids = []
            for k in ("superadmins", "admins", "editors", "verified", "contributors", "searchers", "viewers", "guests", "trusted"):
                for uid in r.get(k) or []:
                    all_ids.append((uid, k))
            if not all_ids:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>trusted</b></blockquote>"]
            for uid, rn in all_ids:
                out.append("<code>%s</code> — <code>%s</code>" % (uid, rn))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "roles":
            r = self._cfg_mgr.get("roles.roles") or {}
            out = ["<blockquote><b>roles</b></blockquote>"]
            for k in ("superadmins", "admins", "editors", "verified", "contributors", "searchers", "viewers", "guests", "trusted"):
                out.append("<b>%s:</b> <code>%s</code>" % (k, ", ".join(str(x) for x in (r.get(k) or [])) or "-"))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "role":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 3:
                await self._respond(event, "<blockquote><code>%sdothat role set|remove|up|down &lt;uid|@u|reply&gt; [role]</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            sub = parts[1].lower()
            tail = parts[2]
            toks = tail.split()
            if not toks:
                return
            target = toks[0]
            new_role = toks[1].lower() if len(toks) > 1 else None
            uid = None
            if target == "reply":
                try:
                    reply = await event.get_reply_message()
                    s = await reply.get_sender()
                    uid = getattr(s, "id", None)
                except Exception:
                    uid = None
            elif target.startswith("@"):
                try:
                    e = await self.kernel.client.get_entity(target)
                    uid = e.id
                except Exception:
                    uid = None
            else:
                try:
                    uid = int(target)
                except ValueError:
                    uid = None
            if uid is None:
                await self._respond(event, "<blockquote><b>cannot resolve</b></blockquote>", parse_mode="html")
                return
            if sub in ("set", "remove", "up", "down") and not self._is_trusted_uid(uid):
                await self._respond(event, "<blockquote><b>user not trusted</b>\n<i>use</i> <code>%sdothat trust</code> <i>first</i></blockquote>" % html.escape(p), parse_mode="html")
                return
            if sub == "set":
                if new_role not in ("guest", "viewer", "contributor", "verified", "searcher", "editor", "admin", "superadmin", "trusted"):
                    await self._respond(event, "<blockquote><b>bad role</b></blockquote>", parse_mode="html")
                    return
                self._set_role(uid, new_role)
                self._audit_log(sender, "role_set", "%s %s" % (uid, new_role))
                await self._respond(event, "<blockquote><b>%s</b> → <code>%s</code></blockquote>" % (uid, new_role), parse_mode="html")
                return
            if sub == "remove":
                self._remove_role(uid)
                await self._respond(event, "<blockquote><b>removed</b> <code>%s</code></blockquote>" % uid, parse_mode="html")
                return
            if sub == "up":
                order = ["guest", "viewer", "contributor", "verified", "searcher", "editor", "admin", "superadmin"]
                cur = self._role_of_by_uid(uid)
                idx = order.index(cur) if cur in order else 0
                nxt = order[min(idx + 1, len(order) - 1)]
                self._set_role(uid, nxt)
                await self._respond(event, "<blockquote><b>%s</b>: <code>%s</code> → <code>%s</code></blockquote>" % (uid, cur, nxt), parse_mode="html")
                return
            if sub == "down":
                order = ["guest", "viewer", "contributor", "verified", "searcher", "editor", "admin", "superadmin"]
                cur = self._role_of_by_uid(uid)
                if cur not in order:
                    await self._respond(event, "<blockquote><b>no role</b></blockquote>", parse_mode="html")
                    return
                idx = order.index(cur)
                prv = order[max(idx - 1, 0)]
                self._set_role(uid, prv)
                await self._respond(event, "<blockquote><b>%s</b>: <code>%s</code> → <code>%s</code></blockquote>" % (uid, cur, prv), parse_mode="html")
                return
            await self._respond(event, self._help_roles(p), parse_mode="html")
            return
        if action == "roleinfo":
            if len(parts) < 2:
                return
            t = parts[1]
            uid = None
            if t == "reply":
                try:
                    reply = await event.get_reply_message()
                    s = await reply.get_sender()
                    uid = getattr(s, "id", None)
                except Exception:
                    uid = None
            elif t.startswith("@"):
                try:
                    e = await self.kernel.client.get_entity(t)
                    uid = e.id
                except Exception:
                    uid = None
            else:
                try:
                    uid = int(t)
                except ValueError:
                    uid = None
            if uid is None:
                return
            r = self._role_of_by_uid(uid)
            await self._respond(event, "<blockquote><b>%s</b> → <code>%s</code></blockquote>" % (uid, r or "none"), parse_mode="html")
            return
        if action == "mute":
            if not self._role_gte(role, "admin"):
                await self._respond(event, "<blockquote><b>admin+</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 3:
                return
            toks = parts[2].split()
            target = toks[0]
            dur = toks[1] if len(toks) > 1 else "1h"
            uid = None
            if target == "reply":
                try:
                    reply = await event.get_reply_message()
                    s = await reply.get_sender()
                    uid = getattr(s, "id", None)
                except Exception:
                    uid = None
            else:
                try:
                    uid = int(target)
                except ValueError:
                    uid = None
            if uid is None:
                return
            m = re.match(r"(\d+)([smhd])", dur)
            if not m:
                return
            secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
            self._mute_user(uid, secs)
            self._audit_log(sender, "mute", "%s %s" % (uid, dur))
            await self._respond(event, "<blockquote><b>muted:</b> <code>%s</code> %s</blockquote>" % (uid, dur), parse_mode="html")
            return
        if action == "unmute":
            if not self._role_gte(role, "admin"):
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            uid = None
            if reply is not None:
                try:
                    s = await reply.get_sender()
                    uid = getattr(s, "id", None)
                except Exception:
                    uid = None
            if uid is None and len(parts) > 2:
                try:
                    uid = int(parts[2].split()[0])
                except Exception:
                    uid = None
            if uid is None:
                return
            self._unmute_user(uid)
            await self._respond(event, "<blockquote><b>unmuted:</b> <code>%s</code></blockquote>" % uid, parse_mode="html")
            return
        if action == "quota-set":
            if not self._role_gte(role, "owner"):
                return
            if len(parts) < 3:
                return
            toks = parts[2].split()
            if len(toks) < 3:
                return
            try:
                uid = int(toks[0]); key = toks[1]; val = int(toks[2])
            except ValueError:
                return
            quotas = self._cfg_mgr.get("roles.trusted_quotas") or {}
            per = quotas.get(str(uid), {}) or {}
            per[key] = val
            quotas[str(uid)] = per
            self._cfg_mgr.set("roles.trusted_quotas", quotas)
            await self._respond(event, "<blockquote><b>quota:</b> <code>%s.%s=%d</code></blockquote>" % (uid, key, val), parse_mode="html")
            return
        if action == "quota-reset":
            if not self._role_gte(role, "owner"):
                return
            if len(parts) < 2:
                return
            try:
                uid = int(parts[1])
            except ValueError:
                return
            used = self._cfg_mgr.get("roles.quota_used") or {}
            used.pop(str(uid), None)
            self._cfg_mgr.set("roles.quota_used", used)
            await self._respond(event, "<blockquote><b>quota reset:</b> <code>%s</code></blockquote>" % uid, parse_mode="html")
            return
        if action == "quota-status":
            if len(parts) < 2:
                return
            try:
                uid = int(parts[1])
            except ValueError:
                return
            quotas = self._cfg_mgr.get("roles.trusted_quotas") or {}
            used = self._cfg_mgr.get("roles.quota_used") or {}
            await self._respond(event, "<blockquote><b>quota %s</b>\nlimits: <code>%s</code>\nused: <code>%s</code></blockquote>" % (uid, html.escape(json.dumps(quotas.get(str(uid), {}), ensure_ascii=False)), html.escape(json.dumps(used.get(str(uid), {}), ensure_ascii=False))), parse_mode="html")
            return
        if action == "rc":
            await self._handle_rc(event, parts[1].lower() if len(parts) > 1 else "", parts[2] if len(parts) > 2 else "", sender)
            return
        if action == "add-contrib":
            if not self._role_gte(role, "contributor"):
                return
            if len(parts) < 3:
                return
            name = parts[1].strip().lower()
            url = self._extract_url_from_text(parts[2])
            if not url.startswith(("http://", "https://")) or not self._is_ssrf_safe(url):
                return
            pending = self._cfg_mgr.get("advanced.pending_sources") or {}
            nid = str(int(self._cfg_mgr.get("advanced.pending_next_id", 1) or 1))
            pending[nid] = {"name": name, "url": url, "by": sender, "ts": time.time()}
            self._cfg_mgr.set("advanced.pending_sources", pending)
            self._cfg_mgr.set("advanced.pending_next_id", int(nid) + 1)
            await self._notify_owner_trusted(event, "add-contrib", "%s %s" % (name, url))
            await self._respond(event, "<blockquote><b>pending</b> <code>#%s</code></blockquote>" % nid, parse_mode="html")
            return
        if action == "pending":
            pending = self._cfg_mgr.get("advanced.pending_sources") or {}
            if not pending:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>pending</b></blockquote>"]
            for pid, pdata in pending.items():
                out.append("<code>#%s</code> — <b>%s</b> — <code>%s</code>" % (pid, html.escape(pdata.get("name", "?")), html.escape(pdata.get("url", "")[:120])))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "approve":
            if not self._role_gte(role, "owner"):
                return
            if len(parts) < 2:
                return
            pid = parts[1].strip().lstrip("#")
            pending = self._cfg_mgr.get("advanced.pending_sources") or {}
            pdata = pending.pop(pid, None)
            if not pdata:
                return
            sites = self._sites()
            sites[pdata["name"]] = {"url": pdata["url"], "host": urlparse(pdata["url"]).netloc, "alive": None}
            self._save_sites(sites)
            self._cfg_mgr.set("advanced.pending_sources", pending)
            await self._respond(event, "<blockquote><b>approved:</b> <code>%s</code></blockquote>" % html.escape(pdata["name"]), parse_mode="html")
            return
        if action == "reject":
            if not self._role_gte(role, "owner"):
                return
            if len(parts) < 2:
                return
            pid = parts[1].strip().lstrip("#")
            pending = self._cfg_mgr.get("advanced.pending_sources") or {}
            pending.pop(pid, None)
            self._cfg_mgr.set("advanced.pending_sources", pending)
            await self._respond(event, "<blockquote><b>rejected</b> <code>#%s</code></blockquote>" % pid, parse_mode="html")
            return
        if action == "plugins":
            if not self._plugins:
                await self._respond(event, "<blockquote><b>no plugins</b></blockquote>", parse_mode="html")
                return
            trust_filter = None
            tm2 = re.search(r"--trust=(\w+)", args)
            if tm2:
                trust_filter = tm2.group(1).lower()
            only_new = "--new" in args
            only_legacy = "--legacy" in args
            new_list = []
            old_list = []
            for k, v in self._plugins.items():
                trust = v.get("trust_level", "sandboxed")
                if trust_filter and trust != trust_filter:
                    continue
                is_legacy = v.get("source") == "legacy"
                if only_new and is_legacy:
                    continue
                if only_legacy and not is_legacy:
                    continue
                st = "🟢" if v.get("enabled") else "🔴"
                emoji = {"sandboxed": "🔒", "trusted": "🔓", "privileged": "👑"}.get(trust, "?")
                dn = (v.get("manifest") or {}).get("name") or k
                ver = (v.get("manifest") or {}).get("version", "?")
                line = "%s%s <b>%s</b> v%s — <code>%s</code> — <i>%s</i>" % (st, emoji, html.escape(dn), html.escape(str(ver)), html.escape(k), trust)
                if is_legacy:
                    old_list.append(line)
                else:
                    new_list.append(line)
            out = ["<blockquote><b>plugins</b>: %d new, %d legacy</blockquote>" % (len(new_list), len(old_list))]
            if new_list:
                out.append("<b>🆕 v1.5.0 (new)</b>")
                out.extend(new_list)
            if old_list:
                out.append("<b>📦 v1.0.0 (legacy)</b>")
                out.extend(old_list)
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "plugin":
            if len(parts) < 2:
                await self._respond(event, self._help_plugins(p), parse_mode="html")
                return
            sub = parts[1].lower()
            tail = parts[2] if len(parts) > 2 else ""
            if sub == "search":
                q = tail.strip()
                if not q:
                    await self._respond(event, "<blockquote><b>need query</b></blockquote>", parse_mode="html")
                    return
                data = await self._repo_index(force=True)
                if not data or not isinstance(data.get("plugins"), list):
                    await self._respond(event, "<blockquote><b>repo unavailable</b></blockquote>", parse_mode="html")
                    return
                matches = []
                ql = q.lower()
                for pl in data["plugins"]:
                    hay = (str(pl.get("name", "")) + " " + str(pl.get("description", "")) + " " + " ".join(pl.get("tags") or [])).lower()
                    if ql in hay:
                        matches.append(pl)
                if not matches:
                    await self._respond(event, "<blockquote><b>no matches for</b> <code>%s</code></blockquote>" % html.escape(q), parse_mode="html")
                    return
                out = ["<blockquote><b>repo search</b>: %d</blockquote>" % len(matches)]
                for pl in matches:
                    name = str(pl.get("name", "?"))
                    ver = str(pl.get("version", "?"))
                    auth = str(pl.get("author", "?"))
                    mc = str(pl.get("min_core", "-"))
                    tags = ",".join(pl.get("tags") or []) or "-"
                    sha = str(pl.get("sha256", ""))[:16]
                    desc = str(pl.get("description", ""))[:120]
                    out.append("<b>%s</b> v%s\n  author: <code>%s</code> min_core: <code>%s</code>\n  tags: <code>%s</code> sha: <code>%s...</code>\n  <i>%s</i>" % (html.escape(name), html.escape(ver), html.escape(auth), html.escape(mc), html.escape(tags), html.escape(sha), html.escape(desc)))
                out.append("<i>install: <code>%sdothat plugin install &lt;name&gt;</code></i>" % html.escape(p))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "install":
                if not self._role_gte(role, "superadmin"):
                    await self._respond(event, "<blockquote><b>superadmin+</b></blockquote>", parse_mode="html")
                    return
                name = tail.strip()
                if not name:
                    await self._respond(event, "<blockquote><b>need name</b></blockquote>", parse_mode="html")
                    return
                ok, info = await self._repo_install(name)
                if ok:
                    dn = (info.get("manifest") or {}).get("name", name)
                    ver = (info.get("manifest") or {}).get("version", "?")
                    await self._respond(event, "<blockquote><b>installed:</b> <code>%s</code> v%s</blockquote>" % (html.escape(str(dn)), html.escape(str(ver))), parse_mode="html")
                else:
                    await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(info)), parse_mode="html")
                return
            if sub == "update":
                if not self._role_gte(role, "superadmin"):
                    await self._respond(event, "<blockquote><b>superadmin+</b></blockquote>", parse_mode="html")
                    return
                name = tail.strip() or None
                updated = await self._repo_update(name)
                if not updated:
                    await self._respond(event, "<blockquote><b>no updates</b></blockquote>", parse_mode="html")
                    return
                out = ["<blockquote><b>updated</b></blockquote>"]
                for n, old, new in updated:
                    out.append("<b>%s</b>: %s → %s" % (html.escape(n), html.escape(str(old)), html.escape(str(new))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "upgrade-all":
                if not self._role_gte(role, "superadmin"):
                    await self._respond(event, "<blockquote><b>superadmin+</b></blockquote>", parse_mode="html")
                    return
                updated = await self._repo_update(None)
                if not updated:
                    await self._respond(event, "<blockquote><b>nothing to update</b></blockquote>", parse_mode="html")
                    return
                out = ["<blockquote><b>upgraded</b></blockquote>"]
                for n, old, new in updated:
                    out.append("<b>%s</b>: %s → %s" % (html.escape(n), html.escape(str(old)), html.escape(str(new))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "refresh-index":
                if not self._role_gte(role, "superadmin"):
                    await self._respond(event, "<blockquote><b>superadmin+</b></blockquote>", parse_mode="html")
                    return
                await self._repo_index(force=True)
                await self._respond(event, "<blockquote><b>index refreshed</b></blockquote>", parse_mode="html")
                return
            if sub == "trust":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                toks = tail.split()
                if len(toks) < 2:
                    await self._respond(event, "<blockquote><b>need name and level</b></blockquote>", parse_mode="html")
                    return
                name = toks[0].lower().replace(" ", "_")
                level = toks[1].lower()
                if level not in ("sandboxed", "trusted", "privileged"):
                    await self._respond(event, "<blockquote><b>bad level</b></blockquote>", parse_mode="html")
                    return
                if name not in self._plugins:
                    await self._respond(event, "<blockquote><b>not found</b></blockquote>", parse_mode="html")
                    return
                self._plugins[name]["trust_level"] = level
                overrides = self._cfg_mgr.get("plugins.trust_overrides") or {}
                overrides[name] = level
                self._cfg_mgr.set("plugins.trust_overrides", overrides)
                await self._respond(event, "<blockquote><b>%s</b> → <code>%s</code></blockquote>" % (html.escape(name), level), parse_mode="html")
                return
            if sub == "trust-list":
                out = ["<blockquote><b>trust</b></blockquote>"]
                for k, v in self._plugins.items():
                    trust = v.get("trust_level", "sandboxed")
                    author = (v.get("manifest") or {}).get("author", "?")
                    src = v.get("source", "?")
                    emoji = {"sandboxed": "🔒", "trusted": "🔓", "privileged": "👑"}.get(trust, "?")
                    out.append("%s <b>%s</b> — <code>%s</code> — %s — src=<code>%s</code>" % (emoji, html.escape(k), trust, html.escape(str(author)), src))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "migrate-all":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                new_dir = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new"))
                done = []
                skipped = []
                for py in sorted(new_dir.glob("*.py")):
                    if py.name.startswith("_"):
                        continue
                    try:
                        txt = py.read_text(encoding="utf-8")
                    except Exception:
                        continue
                    if "MANIFEST" not in txt or "class Plugin" not in txt:
                        skipped.append(py.name)
                        continue
                    first = (txt.split(chr(10), 1)[0] or "").strip()
                    if not first.startswith("#!ddt"):
                        txt = "#!ddt 1.5.0" + chr(10) + txt
                    target = py.with_suffix(".ddt")
                    try:
                        target.write_text(txt, encoding="utf-8")
                        py.unlink()
                        done.append(py.name + " -> " + target.name)
                    except Exception as e:
                        skipped.append("%s: %s" % (py.name, e))
                lines = ["<blockquote><b>migrate-all</b>"]
                if done:
                    lines.append("<b>migrated:</b>")
                    for x in done:
                        lines.append("  <code>" + html.escape(x) + "</code>")
                if skipped:
                    lines.append("<b>skipped:</b>")
                    for x in skipped:
                        lines.append("  <code>" + html.escape(x) + "</code>")
                if not done and not skipped:
                    lines.append("<i>nothing to migrate</i>")
                lines.append("</blockquote>")
                await self._respond(event, chr(10).join(lines), parse_mode="html")
                return
            if sub == "validate":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                raw = tail.strip()
                if not raw:
                    await self._respond(event, "<blockquote><b>need path</b></blockquote>", parse_mode="html")
                    return
                result = await self._validate_plugin_file(raw)
                await self._respond(event, result, parse_mode="html")
                return
            if sub == "scaffold":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                name = tail.strip().lower().replace(" ", "_")
                if not name:
                    await self._respond(event, "<blockquote><b>usage:</b> <code>plugin scaffold &lt;name&gt;</code></blockquote>", parse_mode="html")
                    return
                target_dir = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new"))
                target_dir.mkdir(parents=True, exist_ok=True)
                target = target_dir / (name + ".ddt")
                if target.exists():
                    await self._respond(event, "<blockquote><b>exists:</b> <code>%s</code></blockquote>" % html.escape(str(target)), parse_mode="html")
                    return
                cls_name = "".join(p.capitalize() for p in name.split("_") if p) or "MyPlugin"
                tpl = chr(10).join([
                    "#!ddt 1.5.0",
                    "from dataclasses import dataclass, field",
                    "from typing import Any, Dict, List",
                    "",
                    "",
                    "@dataclass",
                    "class Manifest:",
                    "    name: str = \"%s\"" % cls_name,
                    "    version: str = \"1.0.0\"",
                    "    author: str = \"@you\"",
                    "    description: str = \"short description\"",
                    "    api: str = \"1.5.0\"",
                    "    access: List[str] = field(default_factory=lambda: [\"module\"])",
                    "    tags: List[str] = field(default_factory=lambda: [\"util\"])",
                    "    timeout: int = 10",
                    "    cfg_defaults: Dict[str, Any] = field(default_factory=lambda: {\"enabled\": True})",
                    "    cfg_schema: Dict[str, Any] = field(default_factory=lambda: {\"enabled\": {\"type\": \"bool\"}})",
                    "",
                    "",
                    "MANIFEST = Manifest()",
                    "",
                    "",
                    "class Plugin:",
                    "    manifest = MANIFEST",
                    "",
                    "    async def on_load(self, ctx):",
                    "        ctx.logger.info(\"%s loaded\")" % cls_name,
                    "",
                    "    async def after_fetch(self, ctx):",
                    "        return None",
                    "",
                    "    def health(self, ctx):",
                    "        return {\"status\": \"ok\", \"message\": \"idle\"}",
                    "",
                ])
                try:
                    target.write_text(tpl, encoding="utf-8")
                except Exception as e:
                    await self._respond(event, "<blockquote><b>write failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                    return
                await self._respond(event, "<blockquote><b>scaffolded:</b> <code>%s</code></blockquote>" % html.escape(str(target)), parse_mode="html")
                return
            if sub == "lint":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                raw = tail.strip()
                if not raw:
                    await self._respond(event, "<blockquote><b>usage:</b> <code>plugin lint &lt;path&gt;</code></blockquote>", parse_mode="html")
                    return
                p_l = Path(raw)
                if not p_l.exists():
                    await self._respond(event, "<blockquote><b>not found:</b> <code>%s</code></blockquote>" % html.escape(raw), parse_mode="html")
                    return
                try:
                    txt = p_l.read_text(encoding="utf-8")
                except Exception as e:
                    await self._respond(event, "<blockquote><b>read failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                    return
                mods, calls = self._scan_imports(txt)
                warns = []
                first = (txt.split(chr(10), 1)[0] or "").strip()
                if p_l.suffix == ".ddt" and not first.startswith("#!ddt"):
                    warns.append("missing magic header")
                if mods:
                    warns.append("imports: " + ", ".join(mods))
                if calls:
                    warns.append("dangerous calls: " + ", ".join(calls))
                if not warns:
                    await self._respond(event, "<blockquote><b>lint: clean</b></blockquote>", parse_mode="html")
                else:
                    body = "\n".join("• " + w for w in warns)
                    await self._respond(event, "<blockquote><b>lint warnings:</b>\n%s</blockquote>" % html.escape(body), parse_mode="html")
                return

            if sub in ("info", "reload", "enable", "disable", "remove"):
                raw = tail.strip()
                if not raw:
                    await self._respond(event, "<blockquote><b>need name</b></blockquote>", parse_mode="html")
                    return
                key = raw.lower().replace(" ", "_")
                if key not in self._plugins:
                    await self._respond(event, "<blockquote><b>not found</b></blockquote>", parse_mode="html")
                    return
                info = self._plugins[key]
                if sub == "info":
                    m = info.get("manifest") or {}
                    await self._respond(event, "<blockquote><b>%s</b>\nversion: <code>%s</code>\nauthor: <code>%s</code>\ndesc: %s\napi: <code>%s</code>\ntrust: <code>%s</code>\nsource: <code>%s</code>\nsha256: <code>%s...</code></blockquote>" % (html.escape(key), html.escape(str(m.get("version", "?"))), html.escape(str(m.get("author", "?"))), html.escape(str(m.get("description") or "-")), html.escape(str(m.get("api", "1.0.0"))), info.get("trust_level", "sandboxed"), info.get("source", "?"), info.get("sha256", "")[:16]), parse_mode="html")
                    return
                if sub == "remove":
                    if not self._role_gte(role, "owner"):
                        await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                        return
                    path = info.get("path")
                    self._unregister_plugin(key)
                    try:
                        Path(path).unlink()
                    except Exception:
                        pass
                    self._audit_log(sender, "plugin_remove", key)
                    await self._respond(event, "<blockquote><b>removed</b> <code>%s</code></blockquote>" % html.escape(key), parse_mode="html")
                    return
                if sub == "reload":
                    if not self._role_gte(role, "owner"):
                        await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                        return
                    path = info.get("path")
                    if path and Path(path).exists():
                        self._rollback.store_version(key, info.get("manifest", {}).get("version", "0.0.0"), path)
                    self._unregister_plugin(key)
                    ok, reg_name, _ = await self._load_plugin_any(path) if path else (False, "no path", {})
                    await self._respond(event, "<blockquote><b>reload:</b> <code>%s</code></blockquote>" % html.escape(str(reg_name)), parse_mode="html")
                    return
                if sub == "enable":
                    info["enabled"] = True
                    await self._respond(event, "<blockquote><b>enabled</b> <code>%s</code></blockquote>" % html.escape(key), parse_mode="html")
                    return
                if sub == "disable":
                    info["enabled"] = False
                    await self._respond(event, "<blockquote><b>disabled</b> <code>%s</code></blockquote>" % html.escape(key), parse_mode="html")
                    return
            await self._respond(event, "<blockquote><b>unknown plugin sub</b> <code>%s</code></blockquote>" % html.escape(sub), parse_mode="html")
            return
        if action == "plugin-config":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>plugin-config &lt;name&gt; [key] [value]</b></blockquote>", parse_mode="html")
                return
            toks = parts[2].split(maxsplit=2)
            if not toks:
                return
            name = toks[0].lower().replace(" ", "_")
            if name not in self._plugins:
                await self._respond(event, "<blockquote><b>not found</b></blockquote>", parse_mode="html")
                return
            view = self._plugin_cfg_views.get(name)
            if view is None:
                await self._respond(event, "<blockquote><b>no cfg view</b></blockquote>", parse_mode="html")
                return
            if len(toks) == 1:
                data = view.all()
                payload = json.dumps(data, ensure_ascii=False, indent=2)
                await self._respond(event, "<blockquote><b>cfg %s</b></blockquote>\n<pre>%s</pre>" % (html.escape(name), html.escape(payload[:3500])), parse_mode="html")
                return
            key = toks[1]
            if len(toks) == 2:
                val = view.get(key)
                await self._respond(event, "<blockquote><b>%s.%s</b> = <code>%s</code></blockquote>" % (html.escape(name), html.escape(key), html.escape(json.dumps(val, ensure_ascii=False))), parse_mode="html")
                return
            raw = toks[2].strip()
            try:
                val = json.loads(raw)
            except Exception:
                val = raw
            try:
                view.set(key, val)
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            await self._run_hook_plugin(name, "on_config", {"key": key, "value": val})
            await self._respond(event, "<blockquote><b>%s.%s</b> → <code>%s</code></blockquote>" % (html.escape(name), html.escape(key), html.escape(str(val))), parse_mode="html")
            return
        if action == "plugin-rollback":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>plugin-rollback &lt;name&gt; &lt;version&gt;</b></blockquote>", parse_mode="html")
                return
            toks = parts[2].split()
            if len(toks) < 2:
                return
            name = toks[0].lower().replace(" ", "_")
            version = toks[1]
            p = self._rollback.get_version(name, version)
            if p is None:
                await self._respond(event, "<blockquote><b>version not found</b></blockquote>", parse_mode="html")
                return
            if name in self._plugins:
                self._unregister_plugin(name)
            target = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")) / ("%s.py" % name)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(p, target)
            await self._load_plugin_any(target)
            await self._respond(event, "<blockquote><b>rolled back:</b> <code>%s@%s</code></blockquote>" % (html.escape(name), html.escape(version)), parse_mode="html")
            return
        if action in ("plugin-legacy", "plugin-new"):
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 2:
                return
            key = parts[1].lower().replace(" ", "_")
            if key not in self._plugins:
                await self._respond(event, "<blockquote><b>not found</b></blockquote>", parse_mode="html")
                return
            path = self._plugins[key].get("path")
            self._unregister_plugin(key)
            ok, reg_name, _ = await self._load_plugin_any(path) if path else (False, "no path", {})
            await self._respond(event, "<blockquote><b>%s:</b> <code>%s</code></blockquote>" % (action, html.escape(str(reg_name))), parse_mode="html")
            return
        if action == "new":
            if len(parts) < 2:
                new_cnt = sum(1 for v in self._plugins.values() if v.get("source") == "new")
                await self._respond(event, "<blockquote><b>v1.5.0</b>\nplugins: <code>%d</code>\napi: <code>%s</code></blockquote>" % (new_cnt, PLUGIN_API), parse_mode="html")
                return
            sub = parts[1].lower()
            tail = parts[2] if len(parts) > 2 else ""
            if sub == "list":
                out = ["<blockquote><b>v1.5.0</b></blockquote>"]
                shown = 0
                for k, v in self._plugins.items():
                    if v.get("source") != "new":
                        continue
                    shown += 1
                    emoji = {"sandboxed": "🔒", "trusted": "🔓", "privileged": "👑"}.get(v.get("trust_level", "sandboxed"), "?")
                    out.append("%s <b>%s</b> — <code>%s</code>" % (emoji, html.escape(k), (v.get("manifest") or {}).get("version", "?")))
                if not shown:
                    out.append("<i>none</i>")
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "reload":
                if not self._role_gte(role, "owner"):
                    await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                    return
                for k in list(self._plugins.keys()):
                    info = self._plugins[k]
                    if info.get("source") != "new":
                        continue
                    path = info.get("path")
                    self._unregister_plugin(k)
                    if path:
                        await self._load_plugin_any(path)
                await self._respond(event, "<blockquote><b>reloaded</b></blockquote>", parse_mode="html")
                return
            if sub == "state":
                key = tail.lower().replace(" ", "_")
                data = self._state_store.get(key)
                await self._respond(event, "<blockquote><b>state %s</b>\n<pre>%s</pre></blockquote>" % (html.escape(key), html.escape(json.dumps(data, ensure_ascii=False, indent=2))[:3500]), parse_mode="html")
                return
            if sub == "state-clear":
                key = tail.lower().replace(" ", "_")
                self._state_store.clear(key)
                await self._respond(event, "<blockquote><b>cleared</b> <code>%s</code></blockquote>" % html.escape(key), parse_mode="html")
                return
            if sub == "events":
                if tail.strip().startswith("replay"):
                    extra = tail.strip().split(maxsplit=1)
                    et = extra[1] if len(extra) > 1 else None
                    for rec in self._event_bus.history(50, event_type=et):
                        self._emit_event(rec["type"], rec["data"])
                    await self._respond(event, "<blockquote><b>replayed:</b> <code>%s</code></blockquote>" % html.escape(str(et or "all")), parse_mode="html")
                    return
                out = ["<blockquote><b>events</b></blockquote>"]
                for rec in self._event_bus.history(20):
                    out.append("<code>%s</code> <b>%s</b>" % (time.strftime("%H:%M:%S", time.localtime(rec["ts"])), html.escape(rec["type"])))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "health":
                out = ["<blockquote><b>health</b></blockquote>"]
                for k, v in self._health_monitor.all().items():
                    out.append("<b>%s</b>: <code>%s</code>" % (html.escape(k), v.get("status", "unknown")))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "stats":
                out = ["<blockquote><b>stats</b></blockquote>"]
                for k, v in self._metrics.get().items():
                    total = sum(h.get("calls", 0) for h in v.values())
                    errs = sum(h.get("errors", 0) for h in v.values())
                    out.append("<b>%s</b>: calls=%d errors=%d" % (html.escape(k), total, errs))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            await self._respond(event, self._help_new(p), parse_mode="html")
            return
        if action == "plugin-reload-reply":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                await self._respond(event, "<blockquote><b>reply to .py</b></blockquote>", parse_mode="html")
                return
            fname = None
            doc = getattr(reply, "document", None)
            if doc is not None:
                for a in getattr(doc, "attributes", []) or []:
                    n = getattr(a, "file_name", None)
                    if n:
                        fname = n
                        break
            if not fname or not fname.endswith((".py", ".ddt")):
                await self._respond(event, "<blockquote><b>file must be .py or .ddt</b></blockquote>", parse_mode="html")
                return
            try:
                data = await reply.download_media(bytes)
            except Exception as e:
                await self._respond(event, "<blockquote><b>download failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            try:
                import ast
                ast.parse(data.decode("utf-8", errors="ignore"))
            except SyntaxError as e:
                await self._respond(event, "<blockquote><b>syntax error:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            target = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")) / fname
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            ok, reg_name, info = await self._load_plugin_any(target)
            if ok:
                dn = (info.get("manifest") or {}).get("name", reg_name)
                ver = (info.get("manifest") or {}).get("version", "?")
                await self._respond(event, "<b>reload</b> <code>//</code> <code>%s v%s</code>" % (html.escape(str(dn)), html.escape(str(ver))), parse_mode="html")
            else:
                await self._respond(event, "<b>err</b> <code>//</code> <code>%s</code>" % html.escape(str(reg_name)), parse_mode="html")
            return

        if action == "plugin-update-reply":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                await self._respond(event, "<blockquote><b>reply to .py</b></blockquote>", parse_mode="html")
                return
            fname = None
            doc = getattr(reply, "document", None)
            if doc is not None:
                for a in getattr(doc, "attributes", []) or []:
                    n = getattr(a, "file_name", None)
                    if n:
                        fname = n
                        break
            if not fname or not fname.endswith((".py", ".ddt")):
                await self._respond(event, "<blockquote><b>file must be .py or .ddt</b></blockquote>", parse_mode="html")
                return
            try:
                data = await reply.download_media(bytes)
            except Exception as e:
                await self._respond(event, "<blockquote><b>download failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            try:
                import ast
                ast.parse(data.decode("utf-8", errors="ignore"))
            except SyntaxError as e:
                await self._respond(event, "<blockquote><b>syntax error:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            target = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")) / fname
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            ok, reg_name, info = await self._load_plugin_any(target)
            if ok:
                dn = (info.get("manifest") or {}).get("name", reg_name)
                ver = (info.get("manifest") or {}).get("version", "?")
                await self._respond(event, "<b>update</b> <code>//</code> <code>%s v%s</code>" % (html.escape(str(dn)), html.escape(str(ver))), parse_mode="html")
            else:
                await self._respond(event, "<b>err</b> <code>//</code> <code>%s</code>" % html.escape(str(reg_name)), parse_mode="html")
            return

        if action == "add-to-repo":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            await self._add_to_repo(event, sender, parts[2] if len(parts) > 2 else "")
            return
        if action == "remove-from-repo":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>need name</b></blockquote>", parse_mode="html")
                return
            await self._remove_from_repo(event, parts[1].strip(), sender)
            return
        if action == "update-in-repo":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            await self._update_in_repo(event, sender)
            return
        if action == "repo-status":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            data = await self._repo_index(force=True)
            if not data:
                await self._respond(event, "<blockquote><b>repo unavailable</b></blockquote>", parse_mode="html")
                return
            plugins = data.get("plugins", []) if isinstance(data, dict) else []
            await self._respond(event, "<blockquote><b>repo</b>: <code>%d plugins</code></blockquote>" % len(plugins), parse_mode="html")
            return
        if action == "repo-list":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            data = await self._repo_index(force=True)
            if not data or not isinstance(data.get("plugins"), list):
                await self._respond(event, "<blockquote><b>repo unavailable</b></blockquote>", parse_mode="html")
                return
            if not data["plugins"]:
                await self._respond(event, "<blockquote><b>repo empty</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>repo plugins</b>: %d</blockquote>" % len(data["plugins"])]
            for pl in data["plugins"]:
                name = str(pl.get("name", "?"))
                ver = str(pl.get("version", "?"))
                auth = str(pl.get("author", "?"))
                out.append("<b>%s</b> v%s — <code>%s</code>" % (html.escape(name), html.escape(ver), html.escape(auth)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "install":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None and len(parts) > 1:
                ok, info = await self._repo_install(parts[1])
                if ok:
                    dn = (info.get("manifest") or {}).get("name", parts[1])
                    ver = (info.get("manifest") or {}).get("version", "?")
                    await self._respond(event, "<blockquote><b>installed:</b> <code>%s</code> v%s</blockquote>" % (html.escape(str(dn)), html.escape(str(ver))), parse_mode="html")
                else:
                    await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(info)), parse_mode="html")
                return
            ok, reg_name, info = await self._install_from_reply(event)
            if ok:
                await self._respond(event, "<blockquote><b>installed</b> <code>%s</code></blockquote>" % html.escape(str(reg_name)), parse_mode="html")
            else:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(reg_name)), parse_mode="html")
            return
        if action == "cfg":
            await self._handle_cfg(event, args, sender, role, p)
            return
        if action == "export":
            fmt = "json"
            m = re.search(r"--format=(\w+)", args)
            if m:
                fmt = m.group(1).lower()
            sites = self._sites()
            if fmt == "json":
                data = json.dumps(sites, ensure_ascii=False, indent=2).encode("utf-8")
                fname = "sites.json"
            elif fmt == "csv":
                buf = io.StringIO()
                w = csv.writer(buf)
                w.writerow(["name", "url", "host", "param", "tags", "priority", "disabled", "type"])
                for n, s in sites.items():
                    w.writerow([n, s.get("url", ""), s.get("host", ""), s.get("param", ""), "|".join(s.get("tags") or []), s.get("priority", ""), str(bool(s.get("disabled"))), s.get("type", "html")])
                data = buf.getvalue().encode("utf-8")
                fname = "sites.csv"
            else:
                data = json.dumps(sites, ensure_ascii=False).encode("utf-8")
                fname = "sites.json"
            try:
                await event.client.send_file(event.chat_id, data, file_name=fname)
            except Exception:
                pass
            return
        if action == "import":
            if not self._role_gte(role, "superadmin"):
                await self._respond(event, "<blockquote><b>superadmin+</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                await self._respond(event, "<blockquote><b>reply to json</b></blockquote>", parse_mode="html")
                return
            try:
                data = await reply.download_media(bytes)
                parsed = json.loads(data.decode("utf-8"))
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            sites = self._sites()
            added = 0
            if isinstance(parsed, dict):
                for name, entry in parsed.items():
                    if isinstance(entry, dict) and "url" in entry and self._is_ssrf_safe(entry["url"]):
                        sites[name] = entry
                        added += 1
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>imported:</b> <code>%d</code></blockquote>" % added, parse_mode="html")
            return
        if action == "backup":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            payload = json.dumps({"version": self.version, "ts": time.time(), "sites": self._sites(), "roles": self._cfg_mgr.get("roles.roles") or {}, "stats": self._stats, "history": self._history[-200:]}, ensure_ascii=False, indent=2).encode("utf-8")
            try:
                await event.client.send_file(event.chat_id, payload, file_name="backup_%d.json" % int(time.time()))
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        if action == "restore":
            if not self._role_gte(role, "owner"):
                await self._respond(event, "<blockquote><b>owner only</b></blockquote>", parse_mode="html")
                return
            reply = None
            try:
                reply = await event.get_reply_message()
            except Exception:
                reply = None
            if reply is None:
                await self._respond(event, "<blockquote><b>reply to backup</b></blockquote>", parse_mode="html")
                return
            try:
                raw = await reply.download_media(bytes)
                data = json.loads(raw.decode("utf-8"))
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            if isinstance(data.get("sites"), dict):
                self._save_sites(data["sites"])
            if isinstance(data.get("stats"), dict):
                self._stats.update(data["stats"])
            await self._respond(event, "<blockquote><b>restore ok</b></blockquote>", parse_mode="html")
            return
        if action == "watch":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>watch add|list|remove|run</b></blockquote>", parse_mode="html")
                return
            sub = parts[1].lower()
            tail = parts[2] if len(parts) > 2 else ""
            ws = self._cfg_mgr.get("advanced.watchers") or []
            if sub == "add":
                new_only = "--new-only" in tail
                tail2 = re.sub(r"--\w+", "", tail).strip()
                m = re.match(r"(.+?)\s+every\s+(\d+)([smhd])$", tail2)
                if not m:
                    await self._respond(event, "<blockquote><b>format: query every 1h</b></blockquote>", parse_mode="html")
                    return
                q, n, u = m.group(1).strip(), int(m.group(2)), m.group(3)
                mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[u]
                wid = hashlib.sha1((q + str(time.time())).encode()).hexdigest()[:8]
                ws.append({"id": wid, "query": q, "interval": n * mult, "next_run": time.time() + n * mult, "seen": [], "new_only": new_only})
                self._cfg_mgr.set("advanced.watchers", ws)
                await self._respond(event, "<blockquote><b>watch:</b> <code>%s</code></blockquote>" % wid, parse_mode="html")
                return
            if sub == "list":
                if not ws:
                    await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                    return
                out = ["<blockquote><b>watchers</b></blockquote>"]
                for w in ws:
                    out.append("<code>%s</code> — <code>%s</code> — %s" % (html.escape(w["id"]), html.escape(w["query"]), time.strftime("%Y-%m-%d %H:%M", time.localtime(w.get("next_run", 0)))))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "remove":
                wid = tail.strip()
                ws = [w for w in ws if w.get("id") != wid]
                self._cfg_mgr.set("advanced.watchers", ws)
                await self._respond(event, "<blockquote><b>removed</b></blockquote>", parse_mode="html")
                return
            if sub == "run":
                wid = tail.strip()
                if wid == "--all":
                    for w in ws:
                        w["next_run"] = 0
                    self._cfg_mgr.set("advanced.watchers", ws)
                await self._respond(event, "<blockquote><b>queued</b></blockquote>", parse_mode="html")
                return
            return
        if action == "profile":
            q = parts[1] if len(parts) > 1 else ""
            if not q:
                await self._respond(event, "<blockquote><code>%sdothat profile &lt;query&gt;</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>profiling..</b></blockquote>", parse_mode="html")
            t0 = time.time()
            sites = self._sites()
            rows = []
            for name, site in sites.items():
                if site.get("disabled"):
                    continue
                url = self._build_url(self._apply_site_override(name, site), q)
                t1 = time.time()
                try:
                    page, status, elapsed = await self._fetch_async(url)
                    fetch_t = time.time() - t1
                    t2 = time.time()
                    self._extract(page, url)
                    parse_t = time.time() - t2
                    rows.append((name, round(fetch_t, 3), round(parse_t, 3), len(page)))
                except Exception:
                    rows.append((name, round(time.time() - t1, 3), 0.0, 0))
            rows.sort(key=lambda r: -r[1])
            out = ["<blockquote><b>profile</b> %s \u2014 total %.2fs</blockquote>" % (html.escape(q), round(time.time() - t0, 2))]
            for n, ft, pt, sz in rows[:15]:
                out.append("<code>%s</code> \u2014 fetch %ss, parse %ss, %dB" % (html.escape(n), ft, pt, sz))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return

        if action == "multi":
            rest = args[len("multi"):].strip()
            queries = [q.strip() for q in rest.split("|") if q.strip()]
            if not queries:
                await self._respond(event, "<blockquote><code>%sdothat multi q1 | q2 | q3</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>running batch..</b></blockquote>", parse_mode="html")
            blocks = []
            for q in queries[:5]:
                ok, err = await self._search_everywhere(q, tag=tag_filter, actor=sender, chat_id=chat_id)
                header = "<blockquote><b>%s</b> \u2014 <code>%d hits</code></blockquote>" % (html.escape(q), len(ok))
                body = self._format_results(q, ok)[0] if ok else self._no_result_text(err)
                blocks.append(header + "\n" + body)
            try:
                await self._respond(event, "\n\n".join(blocks), parse_mode="html")
            except Exception:
                pass
            return

        if action == "find-in-history":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><code>%sdothat find-in-history &lt;query&gt;</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            q = parts[1].strip()
            c = self._sqlite_conn()
            if c is None:
                await self._respond(event, "<blockquote><b>sqlite disabled</b></blockquote>", parse_mode="html")
                return
            try:
                with self._sqlite_lock:
                    rows = c.execute("SELECT ts, query, hits FROM queries WHERE query LIKE ? ORDER BY ts DESC LIMIT 20", ("%" + q + "%",)).fetchall()
            except Exception:
                rows = []
            if not rows:
                await self._respond(event, "<blockquote><b>nothing found</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>history search</b></blockquote>"]
            for ts, query, hits in rows:
                out.append("<code>%s</code> \u2014 <code>%s</code> (%d)" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)), html.escape(query), hits))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return

        if args.startswith("@"):
            m = re.match(r"@([\w,\-]+)\s+(.+)$", args, re.DOTALL)
            if m:
                names = [n.strip().lower() for n in m.group(1).split(",") if n.strip()]
                query = m.group(2).strip()
                sites = self._sites()
                selected = {n: sites[n] for n in names if n in sites}
                if not selected:
                    await self._respond(event, "<blockquote><b>no matching sources</b></blockquote>", parse_mode="html")
                    return
                await self._respond(event, "<blockquote><b>doing that..</b></blockquote>", parse_mode="html")
                tasks = [self._search_site(n, s, query) for n, s in selected.items()]
                raw = await asyncio.gather(*tasks, return_exceptions=True)
                ok = [r for r in raw if isinstance(r, dict) and "__error__" not in r]
                err = [r for r in raw if isinstance(r, dict) and "__error__" in r]
                for r in ok:
                    r["score"] = self._bm25_score(r, query, ok, selected.get(r["name"], {}))
                ok.sort(key=lambda r: r.get("score", 0), reverse=True)
                await self._send_result(event, query, ok, err)
                return

        if action == "rename":
            if not self._role_gte(role, "editor"):
                await self._respond(event, "<blockquote><b>editor+</b></blockquote>", parse_mode="html")
                return
            tail = parts[1] if len(parts) == 2 else ("%s %s" % (parts[1], parts[2]) if len(parts) > 1 else "")
            names = tail.split()
            if len(names) < 2:
                await self._respond(event, "<blockquote><code>%sdothat rename &lt;old&gt; &lt;new&gt;</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            old, new = names[0].lower(), names[1].lower()
            sites = self._sites()
            if old not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            sites[new] = sites.pop(old)
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>renamed:</b> <code>%s</code> \u2192 <code>%s</code></blockquote>" % (html.escape(old), html.escape(new)), parse_mode="html")
            return

        if action == "clone":
            if not self._role_gte(role, "editor"):
                await self._respond(event, "<blockquote><b>editor+</b></blockquote>", parse_mode="html")
                return
            tail = parts[1] if len(parts) == 2 else ("%s %s" % (parts[1], parts[2]) if len(parts) > 1 else "")
            names = tail.split()
            if len(names) < 2:
                await self._respond(event, "<blockquote><code>%sdothat clone &lt;old&gt; &lt;new&gt;</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            old, new = names[0].lower(), names[1].lower()
            sites = self._sites()
            if old not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            sites[new] = copy.deepcopy(sites[old])
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>cloned:</b> <code>%s</code> \u2192 <code>%s</code></blockquote>" % (html.escape(old), html.escape(new)), parse_mode="html")
            return

        if action == "audit-me":
            sid = str(sender)
            rows = [a for a in self._audit if a.get("actor") == sid]
            if not rows:
                await self._respond(event, "<blockquote><b>no actions</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>my audit</b></blockquote>"]
            for rec in rows[-20:][::-1]:
                out.append("<code>%s</code> <b>%s</b> \u2014 %s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["ts"])), html.escape(rec["action"]), html.escape(rec["details"])))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return

        if action == "metrics":
            if not self._role_gte(role, "admin"):
                await self._respond(event, "<blockquote><b>admin+</b></blockquote>", parse_mode="html")
                return
            if len(parts) < 2 or parts[1].lower() != "export":
                await self._respond(event, "<blockquote><code>%sdothat metrics export [--format=csv|json] [--since=7d]</code></blockquote>" % html.escape(p), parse_mode="html")
                return
            c = self._sqlite_conn()
            if c is None:
                await self._respond(event, "<blockquote><b>sqlite disabled</b></blockquote>", parse_mode="html")
                return
            since = time.time() - 7 * 86400
            m = re.search(r"--since=(\d+)([dh])", args)
            if m:
                n, u = int(m.group(1)), m.group(2)
                since = time.time() - n * (86400 if u == "d" else 3600)
            fmt = "csv"
            fm = re.search(r"--format=(\w+)", args)
            if fm:
                fmt = fm.group(1).lower()
            try:
                with self._sqlite_lock:
                    rows = c.execute("SELECT source, COUNT(*), SUM(blocked), AVG(elapsed), AVG(size) FROM fetches WHERE ts>? GROUP BY source", (since,)).fetchall()
            except Exception:
                rows = []
            if not rows:
                await self._respond(event, "<blockquote><b>no data</b></blockquote>", parse_mode="html")
                return
            if fmt == "json":
                payload = json.dumps([{"source": r[0], "total": r[1], "blocked": r[2] or 0, "avg_elapsed": round(r[3] or 0, 3), "avg_size": round(r[4] or 0, 1)} for r in rows], ensure_ascii=False, indent=2).encode("utf-8")
                fname = "metrics.json"
            else:
                buf = io.StringIO()
                w = csv.writer(buf)
                w.writerow(["source", "total", "blocked", "avg_elapsed", "avg_size"])
                for r in rows:
                    w.writerow([r[0], r[1], r[2] or 0, round(r[3] or 0, 3), round(r[4] or 0, 1)])
                payload = buf.getvalue().encode("utf-8")
                fname = "metrics.csv"
            try:
                await event.client.send_file(event.chat_id, payload, file_name=fname)
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed:</b> <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
            return

        if action in ("all", "fast", "deep"):
            mode = action
            q = parts[1] if len(parts) > 1 else ""
            if not q:
                await self._respond(event, "<blockquote><b>need query</b></blockquote>", parse_mode="html")
                return
            if self._query_forbidden(q):
                await self._respond(event, "<blockquote><b>forbidden</b></blockquote>", parse_mode="html")
                return
            ok_limit, key = self._check_quota_pre(sender, "search")
            if not ok_limit:
                await self._respond(event, "<blockquote><b>quota exceeded</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>doing that..</b></blockquote>", parse_mode="html")
            ok, err = await self._search_everywhere(q, tag=tag_filter, mode=mode, actor=sender, chat_id=chat_id)
            if ok or err:
                self._check_quota_commit(sender, key)
            await self._send_result(event, q, ok, err)
            return
        if action == "search":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>search &lt;name&gt; &lt;query&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            query = parts[2].strip()
            site = self._sites().get(name)
            if not site:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            r = await self._search_site(name, site, query)
            if isinstance(r, dict) and "__error__" in r:
                await self._respond(event, "<blockquote><b>failed</b>: %s</blockquote>" % html.escape(r.get("error", "?")), parse_mode="html")
                return
            await self._respond(event, self._format_results(query, [r])[0], parse_mode="html")
            return
        if action == "raw":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>raw &lt;name&gt; &lt;query&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            query = parts[2].strip()
            site = self._sites().get(name)
            if not site:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            url = self._build_url(site, query)
            try:
                page, status, elapsed = await self._fetch_async(url)
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed</b>: <code>%s</code></blockquote>" % html.escape(str(e)), parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>raw %s</b> — %d — %ss — %dB</blockquote>\n<pre>%s</pre>" % (html.escape(name), status, elapsed, len(page), html.escape(page[:3500])), parse_mode="html")
            return
        if action == "trace":
            q = parts[1] if len(parts) > 1 else ""
            if not q:
                await self._respond(event, "<blockquote><b>need query</b></blockquote>", parse_mode="html")
                return
            sites = self._sites()
            lines = ["<blockquote><b>trace</b> %s</blockquote>" % html.escape(q)]
            for name, site in list(sites.items())[:10]:
                if site.get("disabled"):
                    continue
                url = self._build_url(self._apply_site_override(name, site), q)
                try:
                    page, status, elapsed = await self._fetch_async(url)
                    v = "☁" if self._is_cloudflare(page) else "🛡" if self._is_captcha(page) else "⚠" if self._looks_js_required(page, page) else "🔴" if status >= 400 else "✅"
                    lines.append("%s <code>%s</code> — %ss, %dB" % (v, html.escape(name), elapsed, len(page)))
                except Exception as e:
                    lines.append("🔴 <code>%s</code> — %s" % (html.escape(name), type(e).__name__))
            await self._respond(event, "\n".join(lines), parse_mode="html")
            return
        if action == "page":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>page &lt;n&gt; &lt;query&gt;</b></blockquote>", parse_mode="html")
                return
            try:
                page_n = max(0, int(parts[1]) - 1)
            except ValueError:
                await self._respond(event, "<blockquote><b>bad page</b></blockquote>", parse_mode="html")
                return
            q = parts[2].strip()
            cached = self._cache_get(q + "||normal", actor=sender, chat_id=chat_id)
            if cached is None:
                ok, err = await self._search_everywhere(q, actor=sender, chat_id=chat_id)
            else:
                ok, err = cached, []
            if not ok:
                await self._respond(event, self._no_result_text(err), parse_mode="html")
                return
            text, total = self._format_results(q, ok, page=page_n)
            await self._respond(event, text, parse_mode="html")
            return
        if action == "retry":
            last = self._last_result.get("query") if self._last_result else None
            if not last:
                await self._respond(event, "<blockquote><b>nothing to retry</b></blockquote>", parse_mode="html")
                return
            self._cache.pop(self._cache_key(last + "||normal", actor=sender), None)
            ok, err = await self._search_everywhere(last, actor=sender, chat_id=chat_id)
            await self._send_result(event, last, ok, err)
            return
        if action == "history":
            if not self._history:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            target_actor = parts[1].strip() if len(parts) > 1 and self._role_gte(role, "admin") else None
            lines = ["<blockquote><b>recent</b></blockquote>"]
            for h in self._history[-20:][::-1]:
                if target_actor and h.get("actor") != target_actor:
                    continue
                lines.append("<code>%s</code> — <code>%s</code> (%d/%d)" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(h["ts"])), html.escape(h["query"]), h["hits"], h["errors"]))
            await self._respond(event, "\n".join(lines), parse_mode="html")
            return
        if action == "sites":
            page = 0
            if len(parts) > 1:
                try:
                    page = max(0, int(parts[1]) - 1)
                except ValueError:
                    pass
            sites = self._sites()
            names = sorted(sites.keys())
            per = max(1, int(self._cfg_mgr.get("search.sites_per_page", 5) or 5))
            total = max(1, (len(names) + per - 1) // per)
            page = max(0, min(page, total - 1))
            chunk = names[page * per:(page + 1) * per]
            out = ["<blockquote><b>sites</b></blockquote>", "<b>total:</b> <code>%d</code> page <code>%d/%d</code>" % (len(names), page + 1, total)]
            for n in chunk:
                d = sites[n]
                alive = d.get("alive")
                mark = "🟢" if alive else ("🔴" if alive is False else "⚪")
                dis = " ⏸" if d.get("disabled") else ""
                out.append("%s <b>%s</b>%s — <code>%s</code>" % (mark, html.escape(n), dis, html.escape(d.get("host", "?"))))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "info":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>info &lt;name&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            site = self._sites().get(name)
            if not site:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            alive = site.get("alive")
            mark = "🟢" if alive else ("🔴" if alive is False else "⚪")
            await self._respond(event, "<blockquote><b>%s</b> %s\nurl: <code>%s</code>\nhost: <code>%s</code>\npriority: <code>%s</code>\nweight: <code>%s</code>\ntags: <code>%s</code>\ndisabled: <code>%s</code></blockquote>" % (html.escape(name), mark, html.escape(site.get("url", "")), html.escape(site.get("host", "?")), site.get("priority", "normal"), site.get("weight", 1.0), html.escape(",".join(site.get("tags") or []) or "-"), bool(site.get("disabled"))), parse_mode="html")
            return
        if action == "add":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>add &lt;name&gt; &lt;url&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].strip().lower()
            tail = parts[2].strip() if len(parts) > 2 else ""
            tail, flags = self._parse_flags(tail)
            url = self._extract_url_from_text(tail)
            if not url:
                reply = None
                try:
                    reply = await event.get_reply_message()
                except Exception:
                    reply = None
                if reply is not None:
                    url = self._extract_url_from_text(getattr(reply, "raw_text", "") or "")
            if not url or not url.startswith(("http://", "https://")) or not self._is_ssrf_safe(url):
                await self._respond(event, "<blockquote><b>need valid url</b></blockquote>", parse_mode="html")
                return
            parsed = urlparse(url)
            entry = {"url": url, "host": parsed.netloc, "alive": None}
            if isinstance(flags.get("param"), str):
                entry["param"] = flags["param"]
            if isinstance(flags.get("tag"), str):
                entry["tags"] = [flags["tag"]]
            if isinstance(flags.get("priority"), str):
                entry["priority"] = flags["priority"]
            sites = self._sites()
            sites[name] = entry
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>added:</b> <code>%s</code></blockquote>" % html.escape(name), parse_mode="html")
            return
        if action == "add-api":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>add-api &lt;name&gt; &lt;preset|url&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].strip().lower()
            tail = parts[2].strip() if len(parts) > 2 else ""
            tail, flags = self._parse_flags(tail)
            if not tail and name in API_PRESETS:
                preset = copy.deepcopy(API_PRESETS[name])
                preset["host"] = urlparse(preset["url"]).netloc
                preset["alive"] = None
                preset["type"] = "api"
                preset["tags"] = ["api"]
                sites = self._sites()
                sites[name] = preset
                self._save_sites(sites)
                await self._respond(event, "<blockquote><b>api added:</b> <code>%s</code></blockquote>" % html.escape(name), parse_mode="html")
                return
            url = self._extract_url_from_text(tail)
            if not url.startswith(("http://", "https://")) or not self._is_ssrf_safe(url):
                await self._respond(event, "<blockquote><b>need url</b></blockquote>", parse_mode="html")
                return
            entry = {"url": url, "host": urlparse(url).netloc, "alive": None, "type": "json"}
            sites = self._sites()
            sites[name] = entry
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>api added:</b> <code>%s</code></blockquote>" % html.escape(name), parse_mode="html")
            return
        if action == "remove":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>remove &lt;name&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            sites = self._sites()
            if name not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            del sites[name]
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>gone</b></blockquote>", parse_mode="html")
            return
        if action in ("enable", "disable"):
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>need name</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            sites = self._sites()
            if name not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            sites[name]["disabled"] = (action == "disable")
            if action == "enable":
                self._stats["per_source_fail"][name] = 0
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>%sd:</b> <code>%s</code></blockquote>" % (action, html.escape(name)), parse_mode="html")
            return
        if action == "tag":
            tail = parts[1] if len(parts) == 2 else ("%s %s" % (parts[1], parts[2]) if len(parts) > 1 else "")
            toks = tail.split()
            if len(toks) < 2:
                await self._respond(event, "<blockquote><b>tag &lt;name&gt; [+|-]tag</b></blockquote>", parse_mode="html")
                return
            name, tag_spec = toks[0].lower(), toks[1]
            sites = self._sites()
            if name not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            tags = list(sites[name].get("tags") or [])
            if tag_spec.startswith("-"):
                tags = [x for x in tags if x != tag_spec[1:]]
            elif tag_spec.startswith("+"):
                if tag_spec[1:] not in tags:
                    tags.append(tag_spec[1:])
            else:
                if tag_spec not in tags:
                    tags.append(tag_spec)
            sites[name]["tags"] = tags
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>%s</b> tags: <code>%s</code></blockquote>" % (html.escape(name), html.escape(",".join(tags) or "-")), parse_mode="html")
            return
        if action == "priority":
            tail = parts[1] if len(parts) == 2 else ("%s %s" % (parts[1], parts[2]) if len(parts) > 1 else "")
            toks = tail.split()
            if len(toks) < 2:
                await self._respond(event, "<blockquote><b>priority &lt;name&gt; high|normal|low</b></blockquote>", parse_mode="html")
                return
            name, level = toks[0].lower(), toks[1].lower()
            if level not in ("high", "normal", "low"):
                await self._respond(event, "<blockquote><b>bad level</b></blockquote>", parse_mode="html")
                return
            sites = self._sites()
            if name not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            sites[name]["priority"] = level
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>%s</b> %s</blockquote>" % (html.escape(name), level), parse_mode="html")
            return
        if action == "weight":
            tail = parts[1] if len(parts) == 2 else ("%s %s" % (parts[1], parts[2]) if len(parts) > 1 else "")
            toks = tail.split()
            if len(toks) < 2:
                await self._respond(event, "<blockquote><b>weight &lt;name&gt; &lt;float&gt;</b></blockquote>", parse_mode="html")
                return
            name = toks[0].lower()
            try:
                weight = float(toks[1])
            except ValueError:
                await self._respond(event, "<blockquote><b>bad weight</b></blockquote>", parse_mode="html")
                return
            sites = self._sites()
            if name not in sites:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            sites[name]["weight"] = weight
            self._save_sites(sites)
            await self._respond(event, "<blockquote><b>%s</b> weight: %s</blockquote>" % (html.escape(name), weight), parse_mode="html")
            return
        if action == "tags":
            sites = self._sites()
            all_tags = {}
            for n, s in sites.items():
                for t in s.get("tags") or []:
                    all_tags.setdefault(t, []).append(n)
            if not all_tags:
                await self._respond(event, "<blockquote><b>no tags</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>tags</b></blockquote>"]
            for t, names in sorted(all_tags.items()):
                out.append("<code>%s</code> — %s" % (html.escape(t), ", ".join(html.escape(n) for n in names)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "ping":
            sites = self._sites()
            if not sites:
                await self._respond(event, "<blockquote><b>no sites</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>pinging..</b></blockquote>", parse_mode="html")
            rows = []
            sem = asyncio.Semaphore(5)
            async def check(name, site):
                async with sem:
                    started = time.time()
                    try:
                        alive = await asyncio.wait_for(asyncio.to_thread(self._ping, self._build_url(site, "test")), timeout=12)
                    except Exception:
                        alive = False
                    rows.append((name, alive, round(time.time() - started, 2)))
            await asyncio.gather(*(check(n, s) for n, s in sites.items()))
            rows.sort(key=lambda r: r[0])
            out = ["<blockquote><b>ping</b></blockquote>"]
            for name, alive, el in rows:
                out.append("%s <code>%s</code> — %ss" % ("🟢" if alive else "🔴", html.escape(name), el))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action in ("heal", "doctor"):
            sites = self._sites()
            if not sites:
                await self._respond(event, "<blockquote><b>no sites</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>checking..</b></blockquote>", parse_mode="html")
            sem = asyncio.Semaphore(5)
            rows = []
            st = {"ch": False}
            async def probe(name, site):
                async with sem:
                    url = self._build_url(self._apply_site_override(name, site), "test")
                    started = time.time()
                    try:
                        page, status, _ = await self._fetch_async(url)
                        elapsed = round(time.time() - started, 2)
                        size = len(page)
                        if self._is_cloudflare(page):
                            verdict = "☁ cloudflare"
                            alive = False
                        elif self._is_captcha(page):
                            verdict = "🛡 captcha"
                            alive = True
                        elif self._looks_js_required(page, page):
                            verdict = "⚠ needs js"
                            alive = True
                        elif status >= 400:
                            verdict = "🔴 http %d" % status
                            alive = False
                        else:
                            verdict = "✅ ok"
                            alive = True
                    except Exception as e:
                        elapsed = round(time.time() - started, 2)
                        size = 0
                        verdict = "🔴 %s" % type(e).__name__
                        alive = False
                    if site.get("alive") != alive:
                        site["alive"] = alive
                        st["ch"] = True
                    rows.append((name, verdict, elapsed, size))
            await asyncio.gather(*(probe(n, s) for n, s in sites.items()))
            if st["ch"]:
                self._save_sites(sites)
            rows.sort(key=lambda r: r[0])
            out = ["<blockquote><b>%s</b></blockquote>" % action]
            for name, verdict, elapsed, size in rows:
                out.append("%s <code>%s</code> — %ss, %dB" % (verdict, html.escape(name), elapsed, size))
            if action == "doctor" and "--deep" in args:
                out.append("")
                out.append("<blockquote><b>deep</b></blockquote>")
                c = self._sqlite_conn()
                if c is None:
                    out.append("❌ sqlite disabled")
                else:
                    try:
                        with self._sqlite_lock:
                            c.execute("PRAGMA quick_check").fetchone()
                        out.append("✅ sqlite ok")
                    except Exception as e:
                        out.append("❌ sqlite: %s" % html.escape(str(e)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "dead":
            sites = self._sites()
            dead = [n for n, s in sites.items() if s.get("alive") is False]
            if not dead:
                await self._respond(event, "<blockquote><b>none</b></blockquote>", parse_mode="html")
                return
            await self._respond(event, "<blockquote><b>dead</b></blockquote>\n" + "\n".join("• <code>%s</code>" % html.escape(n) for n in dead), parse_mode="html")
            return
        if action == "slow":
            percs = self._latency_percentiles()
            if not percs:
                await self._respond(event, "<blockquote><b>no data</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>slowest</b></blockquote>"]
            for src, pp in sorted(percs.items(), key=lambda kv: -kv[1]["p95"])[:15]:
                out.append("<code>%.2fs</code> — <code>%s</code>" % (pp["p95"], html.escape(src)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "slow-source":
            percs = self._latency_percentiles()
            if not percs:
                await self._respond(event, "<blockquote><b>no data</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>slow sources</b></blockquote>"]
            for src, pp in sorted(percs.items(), key=lambda kv: -kv[1]["p95"])[:15]:
                out.append("p95 <code>%.2fs</code> p50 <code>%.2fs</code> — <code>%s</code>" % (pp["p95"], pp["p50"], html.escape(src)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "latency":
            percs = self._latency_percentiles()
            if not percs:
                await self._respond(event, "<blockquote><b>no data</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>latency</b></blockquote>"]
            for src, pp in sorted(percs.items(), key=lambda kv: -kv[1]["p95"])[:20]:
                out.append("<code>%s</code> p50 <code>%.2f</code> p95 <code>%.2f</code> p99 <code>%.2f</code> n=%d" % (html.escape(src), pp["p50"], pp["p95"], pp["p99"], pp["n"]))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "stat":
            s = self._stats
            top = sorted(s["top_queries"].items(), key=lambda x: -x[1])[:10]
            per = sorted(s.get("per_source", {}).items(), key=lambda x: -x[1])[:10]
            tl = "\n".join("• <code>%s</code> — %d" % (html.escape(q), n) for q, n in top) or "<i>-</i>"
            pl = "\n".join("• <code>%s</code> — %d" % (html.escape(k), v) for k, v in per) or "<i>-</i>"
            fails = sum((s.get("per_source_fail") or {}).values())
            await self._respond(event, "<blockquote><b>stat</b></blockquote>\nqueries: %d\nhits: %d\nfails: %d\n<b>top:</b>\n%s\n<b>sources:</b>\n%s" % (s["total_queries"], s["total_sources_hit"], fails, tl, pl), parse_mode="html")
            return
        if action == "top":
            per = sorted(self._stats.get("per_source", {}).items(), key=lambda x: -x[1])[:20]
            if not per:
                await self._respond(event, "<blockquote><b>no data</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>top</b></blockquote>"]
            for i, (k, v) in enumerate(per, 1):
                out.append("%d. <code>%s</code> — %d" % (i, html.escape(k), v))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "dashboard":
            s = self._stats
            sites = self._sites()
            alive = sum(1 for x in sites.values() if x.get("alive"))
            dead = sum(1 for x in sites.values() if x.get("alive") is False)
            dis = sum(1 for x in sites.values() if x.get("disabled"))
            new_cnt = sum(1 for v in self._plugins.values() if v.get("source") == "new")
            old_cnt = sum(1 for v in self._plugins.values() if v.get("source") == "legacy")
            await self._respond(event, "<blockquote><b>dashboard</b></blockquote>\nqueries: %d\nhits: %d\nplugins: %d (new %d / legacy %d)\nsites: %d (🟢%d 🔴%d ⏸%d)" % (s["total_queries"], s["total_sources_hit"], len(self._plugins), new_cnt, old_cnt, len(sites), alive, dead, dis), parse_mode="html")
            return
        if action == "logs":
            c = self._sqlite_conn()
            if c is None:
                await self._respond(event, "<blockquote><b>sqlite disabled</b></blockquote>", parse_mode="html")
                return
            limit = 15
            if len(parts) > 1:
                try:
                    limit = int(parts[1])
                except ValueError:
                    pass
            try:
                with self._sqlite_lock:
                    rows = c.execute("SELECT ts, source, url, status, elapsed, size, blocked, verdict FROM fetches ORDER BY ts DESC LIMIT ?", (limit,)).fetchall()
            except Exception:
                rows = []
            if not rows:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>fetches</b></blockquote>"]
            for ts, src, url, status, elapsed, size, blocked, verdict in rows:
                mark = "🛡" if blocked else "✅"
                out.append("%s <code>%s</code> — %d — %ss — %dB" % (mark, html.escape(src), status, elapsed, size))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "audit":
            if not self._audit:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            n = 30
            if len(parts) > 1:
                try:
                    n = max(1, min(200, int(parts[1])))
                except ValueError:
                    pass
            af = re.search(r"--action=(\w+)", args)
            uf = re.search(r"--actor=(\S+)", args)
            action_filter = af.group(1) if af else None
            actor_filter = uf.group(1) if uf else None
            out = ["<blockquote><b>audit</b></blockquote>"]
            for rec in self._audit[-n:][::-1]:
                if action_filter and rec.get("action") != action_filter:
                    continue
                if actor_filter and rec.get("actor") != actor_filter:
                    continue
                out.append("<code>%s</code> <b>%s</b> by <code>%s</code> — %s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(rec["ts"])), html.escape(rec["action"]), html.escape(rec["actor"]), html.escape(rec["details"])))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "snapshot":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>snapshot &lt;name&gt; &lt;query&gt;</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            query = parts[2].strip()
            site = self._sites().get(name)
            if not site:
                await self._respond(event, "<blockquote><b>404</b></blockquote>", parse_mode="html")
                return
            url = self._build_url(site, query)
            try:
                page, status, elapsed = await self._fetch_async(url)
                if self._is_cloudflare(page) or self._is_captcha(page):
                    await self._respond(event, "<blockquote><b>blocked</b></blockquote>", parse_mode="html")
                    return
                self._sqlite_save_snapshot(name, query, url, page)
                await self._respond(event, "<blockquote><b>snapshot:</b> %dB</blockquote>" % len(page), parse_mode="html")
            except Exception as e:
                await self._respond(event, "<blockquote><b>failed</b>: %s</blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        if action == "diff":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>diff &lt;name&gt; &lt;query&gt;</b></blockquote>", parse_mode="html")
                return
            c = self._sqlite_conn()
            if c is None:
                await self._respond(event, "<blockquote><b>sqlite disabled</b></blockquote>", parse_mode="html")
                return
            name = parts[1].lower()
            query = parts[2].strip()
            try:
                with self._sqlite_lock:
                    rows = c.execute("SELECT ts, html FROM snapshots WHERE source=? AND query=? ORDER BY ts DESC LIMIT 2", (name, query)).fetchall()
            except Exception:
                rows = []
            if len(rows) < 2:
                await self._respond(event, "<blockquote><b>need 2 snapshots</b></blockquote>", parse_mode="html")
                return
            _, txo, _, _, _, _ = self._extract(rows[1][1], "")
            _, txn, _, _, _, _ = self._extract(rows[0][1], "")
            added = len(txn) - len(txo)
            await self._respond(event, "<blockquote><b>diff</b> %s\n<b>delta:</b> %s%d</blockquote>" % (html.escape(name), "+" if added >= 0 else "", added), parse_mode="html")
            return
        if action == "note":
            if len(parts) < 3:
                await self._respond(event, "<blockquote><b>note add|remove</b></blockquote>", parse_mode="html")
                return
            sub = parts[1].lower()
            notes = self._cfg_mgr.get("advanced.notes") or {}
            if sub == "add":
                toks = parts[2].split(maxsplit=1)
                if len(toks) < 2:
                    await self._respond(event, "<blockquote><b>need url + text</b></blockquote>", parse_mode="html")
                    return
                url, text = toks[0], toks[1]
                notes[url] = {"text": text, "ts": time.time(), "by": sender}
                self._cfg_mgr.set("advanced.notes", notes)
                await self._respond(event, "<blockquote><b>note saved</b></blockquote>", parse_mode="html")
                return
            if sub == "remove":
                url = parts[2].strip()
                notes.pop(url, None)
                self._cfg_mgr.set("advanced.notes", notes)
                await self._respond(event, "<blockquote><b>note removed</b></blockquote>", parse_mode="html")
                return
            return
        if action == "notes":
            notes = self._cfg_mgr.get("advanced.notes") or {}
            if not notes:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            search = parts[1].lower() if len(parts) > 1 else ""
            out = ["<blockquote><b>notes</b></blockquote>"]
            shown = 0
            for url, data in list(notes.items()):
                if search and search not in (url + " " + data.get("text", "")).lower():
                    continue
                out.append("<code>%s</code> — %s\n<i>%s</i>" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(data.get("ts", 0))), html.escape(url[:80]), html.escape(data.get("text", ""))))
                shown += 1
                if shown >= 20:
                    break
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "template":
            if len(parts) < 2:
                await self._respond(event, "<blockquote><b>template add|list|run|remove</b></blockquote>", parse_mode="html")
                return
            sub = parts[1].lower()
            tail = parts[2] if len(parts) > 2 else ""
            templates = self._cfg_mgr.get("advanced.templates") or {}
            if sub == "add":
                toks = tail.split(maxsplit=1)
                if len(toks) < 2:
                    await self._respond(event, "<blockquote><b>need name + query</b></blockquote>", parse_mode="html")
                    return
                templates[toks[0]] = {"query": toks[1], "ts": time.time()}
                self._cfg_mgr.set("advanced.templates", templates)
                await self._respond(event, "<blockquote><b>saved:</b> <code>%s</code></blockquote>" % html.escape(toks[0]), parse_mode="html")
                return
            if sub == "list":
                if not templates:
                    await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                    return
                out = ["<blockquote><b>templates</b></blockquote>"]
                for tname, data in templates.items():
                    out.append("<code>%s</code> — <code>%s</code>" % (html.escape(tname), html.escape(data.get("query", "")[:100])))
                await self._respond(event, "\n".join(out), parse_mode="html")
                return
            if sub == "run":
                tname = tail.strip()
                if tname not in templates:
                    await self._respond(event, "<blockquote><b>not found</b></blockquote>", parse_mode="html")
                    return
                q = templates[tname].get("query", "")
                ok, err = await self._search_everywhere(q, actor=sender)
                await self._send_result(event, q, ok, err)
                return
            if sub == "remove":
                templates.pop(tail.strip(), None)
                self._cfg_mgr.set("advanced.templates", templates)
                await self._respond(event, "<blockquote><b>removed</b></blockquote>", parse_mode="html")
                return
            return
        if action == "saved":
            saved = self._cfg_mgr.get("advanced.saved_results") or {}
            if not saved:
                await self._respond(event, "<blockquote><b>empty</b></blockquote>", parse_mode="html")
                return
            out = ["<blockquote><b>saved</b></blockquote>"]
            for sid, data in list(saved.items())[-20:]:
                out.append("<code>%s</code> — <code>%s</code> (%d)" % (sid, html.escape(data.get("query", "")), data.get("hits", 0)))
            await self._respond(event, "\n".join(out), parse_mode="html")
            return
        if action == "save":
            e = self._last_result or {}
            ok = e.get("ok") or []
            q = e.get("query") or ""
            saved = self._cfg_mgr.get("advanced.saved_results") or {}
            sid = hashlib.sha1((q + str(time.time())).encode()).hexdigest()[:10]
            saved[sid] = {"query": q, "ts": time.time(), "hits": len(ok), "results": [{k: v for k, v in r.items() if k not in ("snippet_hl", "snippet_esc")} for r in ok[:50]]}
            self._cfg_mgr.set("advanced.saved_results", saved)
            await self._respond(event, "<blockquote><b>saved</b> <code>%s</code></blockquote>" % sid, parse_mode="html")
            return
        if action == "openall":
            e = self._last_result or {}
            urls = [r["url"] for r in (e.get("ok") or [])[:30]]
            if not urls:
                await self._respond(event, "<blockquote><b>nothing to open</b></blockquote>", parse_mode="html")
                return
            chunks = []
            current = ""
            for u in urls:
                line = "• %s\n" % u
                if len(current) + len(line) > 3800:
                    chunks.append(current)
                    current = line
                else:
                    current += line
            if current:
                chunks.append(current)
            try:
                for chunk in chunks:
                    await event.client.send_message(event.chat_id, chunk[:4000])
            except Exception:
                pass
            return
        if action == "json":
            e = self._last_result or {}
            ok = e.get("ok") or []
            payload = json.dumps({"query": e.get("query"), "results": [{k: v for k, v in r.items() if k not in ("snippet_hl", "snippet_esc")} for r in ok]}, ensure_ascii=False, indent=2)
            try:
                await event.client.send_file(event.chat_id, payload.encode("utf-8"), file_name="ddt_%d.json" % int(time.time()))
            except Exception:
                pass
            return
        sites = self._sites()
        if not sites:
            await self._respond(event, "<blockquote><b>no sources</b></blockquote>", parse_mode="html")
            return
        if self._query_forbidden(args):
            await self._respond(event, "<blockquote><b>forbidden</b></blockquote>", parse_mode="html")
            return
        ok_limit, key = self._check_quota_pre(sender, "search")
        if not ok_limit:
            await self._respond(event, "<blockquote><b>quota exceeded</b></blockquote>", parse_mode="html")
            return
        await self._respond(event, "<blockquote><b>doing that..</b></blockquote>", parse_mode="html")
        ok, err = await self._search_everywhere(args, tag=tag_filter, actor=sender, chat_id=chat_id)
        if ok or err:
            self._check_quota_commit(sender, key)
        if to_chat:
            try:
                text, _ = self._format_results(args, ok)
                await event.client.send_message(to_chat, text if ok else self._no_result_text(err), parse_mode="html")
                await self._respond(event, "<blockquote><b>sent</b></blockquote>", parse_mode="html")
            except Exception as e:
                await self._respond(event, "<blockquote><b>send failed</b>: %s</blockquote>" % html.escape(str(e)), parse_mode="html")
            return
        await self._send_result(event, args, ok, err)


module = DontDoThatADM