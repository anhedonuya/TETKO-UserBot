def _write_cfg_lib(cfg_dir: Path):
    cfg_dir.mkdir(parents=True, exist_ok=True)
    files = {}

    files["__init__.py"] = (
        '"""dontdothat_cfg_new_lib — config system 1.5.0."""\n'
        "from .defaults import CFG_DEFAULTS, CFG_SECTIONS, CFG_SCHEMA\n"
        "from .sections import flatten, unflatten, section_of, get_path, set_path\n"
        "from .validator import validate_value, validate_cfg\n"
        "from .history import History\n"
        "from .override import OverrideManager\n"
        "from .profiles import ProfileManager\n"
        "from .export import export_cfg, import_cfg\n"
        "from .loader import ConfigLoader\n"
        "from .manager import ConfigManager\n"
        "from .env import env_key, env_value, env_all\n"
        "from .migrations import migrate, register_migration, CONFIG_MIGRATIONS\n"
        'CONFIG_VERSION = "1.5.0"\n'
    )
    files["version.py"] = 'CONFIG_VERSION = "1.5.0"\n'
    files["defaults.py"] = (
        "CFG_DEFAULTS = " + repr(CFG_DEFAULTS) + "\n"
        "CFG_SECTIONS = " + repr(CFG_SECTIONS) + "\n"
        "CFG_SCHEMA = " + repr(CFG_SCHEMA) + "\n"
    )
    files["sections.py"] = (
        "def flatten(cfg):\n"
        "    out = {}\n"
        "    for section, values in cfg.items():\n"
        "        if isinstance(values, dict):\n"
        "            for k, v in values.items():\n"
        "                out['%s.%s' % (section, k)] = v\n"
        "        else:\n"
        "            out[section] = values\n"
        "    return out\n"
        "\n"
        "def unflatten(flat):\n"
        "    out = {}\n"
        "    for key, value in flat.items():\n"
        "        if '.' in key:\n"
        "            section, k = key.split('.', 1)\n"
        "            out.setdefault(section, {})[k] = value\n"
        "        else:\n"
        "            out.setdefault('advanced', {})[key] = value\n"
        "    return out\n"
        "\n"
        "def section_of(key, defaults):\n"
        "    if '.' in key:\n"
        "        return key.split('.', 1)[0]\n"
        "    for section, values in defaults.items():\n"
        "        if isinstance(values, dict) and key in values:\n"
        "            return section\n"
        "    return 'advanced'\n"
        "\n"
        "def get_path(cfg, key):\n"
        "    if '.' in key:\n"
        "        section, k = key.split('.', 1)\n"
        "        data = cfg.get(section) or {}\n"
        "        if isinstance(data, dict):\n"
        "            return data.get(k)\n"
        "        return None\n"
        "    return cfg.get(key)\n"
        "\n"
        "def set_path(cfg, key, value):\n"
        "    if '.' in key:\n"
        "        section, k = key.split('.', 1)\n"
        "        data = cfg.get(section) or {}\n"
        "        if not isinstance(data, dict):\n"
        "            data = {}\n"
        "        data[k] = value\n"
        "        cfg[section] = data\n"
        "    else:\n"
        "        cfg[key] = value\n"
        "    return cfg\n"
    )
    files["validator.py"] = (
        "def validate_value(value, default):\n"
        "    if default is None:\n"
        "        return True, None\n"
        "    if isinstance(default, bool):\n"
        "        return isinstance(value, bool), 'expected bool'\n"
        "    if isinstance(default, int):\n"
        "        return isinstance(value, int) and not isinstance(value, bool), 'expected int'\n"
        "    if isinstance(default, float):\n"
        "        return isinstance(value, (int, float)) and not isinstance(value, bool), 'expected number'\n"
        "    if isinstance(default, str):\n"
        "        return isinstance(value, str), 'expected str'\n"
        "    if isinstance(default, list):\n"
        "        return isinstance(value, list), 'expected list'\n"
        "    if isinstance(default, dict):\n"
        "        return isinstance(value, dict), 'expected dict'\n"
        "    return True, None\n"
        "\n"
        "def validate_cfg(flat, defaults):\n"
        "    errors = []\n"
        "    for section, vals in defaults.items():\n"
        "        if not isinstance(vals, dict):\n"
        "            continue\n"
        "        for k, default in vals.items():\n"
        "            key = '%s.%s' % (section, k)\n"
        "            if key not in flat:\n"
        "                continue\n"
        "            ok, err = validate_value(flat[key], default)\n"
        "            if not ok:\n"
        "                errors.append('%s: %s' % (key, err))\n"
        "    return errors\n"
    )
    files["schema.py"] = (
        "def validate_schema(key, value, schema):\n"
        "    rule = schema.get(key)\n"
        "    if not rule:\n"
        "        return True, None\n"
        "    t = rule.get('type')\n"
        "    if t == 'int' and (not isinstance(value, int) or isinstance(value, bool)):\n"
        "        return False, 'expected int'\n"
        "    if t == 'float' and (not isinstance(value, (int, float)) or isinstance(value, bool)):\n"
        "        return False, 'expected float'\n"
        "    if t == 'str' and not isinstance(value, str):\n"
        "        return False, 'expected str'\n"
        "    if t == 'bool' and not isinstance(value, bool):\n"
        "        return False, 'expected bool'\n"
        "    if t == 'choice' and value not in (rule.get('choices') or []):\n"
        "        return False, 'not in choices'\n"
        "    mn = rule.get('min')\n"
        "    if mn is not None and isinstance(value, (int, float)) and value < mn:\n"
        "        return False, 'below min %s' % mn\n"
        "    mx = rule.get('max')\n"
        "    if mx is not None and isinstance(value, (int, float)) and value > mx:\n"
        "        return False, 'above max %s' % mx\n"
        "    return True, None\n"
    )
    files["history.py"] = (
        "import time\n"
        "\n"
        "class History:\n"
        "    def __init__(self, per_key_limit=100):\n"
        "        self._data = {}\n"
        "        self._limit = per_key_limit\n"
        "\n"
        "    def push(self, key, old, new, actor='?'):\n"
        "        h = self._data.setdefault(key, [])\n"
        "        h.append({'ts': time.time(), 'old': old, 'new': new, 'actor': str(actor)})\n"
        "        if len(h) > self._limit:\n"
        "            self._data[key] = h[-self._limit:]\n"
        "\n"
        "    def get(self, key, limit=20):\n"
        "        return self._data.get(key, [])[-limit:]\n"
        "\n"
        "    def all(self):\n"
        "        return dict(self._data)\n"
        "\n"
        "    def clear(self):\n"
        "        self._data.clear()\n"
    )
    files["override.py"] = (
        "import time\n"
        "\n"
        "class OverrideManager:\n"
        "    def __init__(self):\n"
        "        self._data = {}\n"
        "\n"
        "    def set(self, key, value, ttl=3600):\n"
        "        self._data[key] = {'value': value, 'expires_at': time.time() + ttl}\n"
        "\n"
        "    def get(self, key):\n"
        "        e = self._data.get(key)\n"
        "        if not e:\n"
        "            return None\n"
        "        if e['expires_at'] < time.time():\n"
        "            self._data.pop(key, None)\n"
        "            return None\n"
        "        return e['value']\n"
        "\n"
        "    def active(self):\n"
        "        now = time.time()\n"
        "        expired = [k for k, v in self._data.items() if v['expires_at'] < now]\n"
        "        for k in expired:\n"
        "            self._data.pop(k, None)\n"
        "        return dict(self._data)\n"
        "\n"
        "    def clear(self):\n"
        "        self._data.clear()\n"
    )
    files["profiles.py"] = (
        "import json\n"
        "from pathlib import Path\n"
        "\n"
        "class ProfileManager:\n"
        "    def __init__(self, base_dir='data/dontdothat_cfg_profiles'):\n"
        "        self.base_dir = Path(base_dir)\n"
        "        self.base_dir.mkdir(parents=True, exist_ok=True)\n"
        "\n"
        "    def list(self):\n"
        "        builtin = ['prod', 'dev', 'minimal', 'test']\n"
        "        custom = [p.stem for p in self.base_dir.glob('*.json')]\n"
        "        return {'builtin': builtin, 'custom': custom}\n"
        "\n"
        "    def get_builtin(self, name):\n"
        "        if name == 'prod':\n"
        "            return {'ui': {'log_searches': False}, 'search': {'priority_first': True}}\n"
        "        if name == 'dev':\n"
        "            return {'ui': {'log_searches': True}, 'plugins': {'auto_disable_on_error': False}}\n"
        "        if name == 'minimal':\n"
        "            return {'search': {'max_parallel': 3, 'priority_first': False}}\n"
        "        if name == 'test':\n"
        "            return {'plugins': {'enabled': False}}\n"
        "        return None\n"
        "\n"
        "    def save(self, name, data):\n"
        "        p = self.base_dir / ('%s.json' % name)\n"
        "        p.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')\n"
        "\n"
        "    def load(self, name):\n"
        "        builtin = self.get_builtin(name)\n"
        "        if builtin:\n"
        "            return builtin\n"
        "        p = self.base_dir / ('%s.json' % name)\n"
        "        if not p.exists():\n"
        "            return None\n"
        "        try:\n"
        "            return json.loads(p.read_text(encoding='utf-8'))\n"
        "        except Exception:\n"
        "            return None\n"
        "\n"
        "    def delete(self, name):\n"
        "        p = self.base_dir / ('%s.json' % name)\n"
        "        if p.exists():\n"
        "            p.unlink()\n"
        "            return True\n"
        "        return False\n"
    )
    files["export.py"] = (
        "import json\n"
        "\n"
        "def export_cfg(flat, fmt='json'):\n"
        "    if fmt == 'json':\n"
        "        return json.dumps(flat, ensure_ascii=False, indent=2).encode('utf-8')\n"
        "    if fmt == 'env':\n"
        "        lines = []\n"
        "        for k, v in flat.items():\n"
        "            lines.append('%s=%s' % ('DDT_' + k.replace('.', '_').upper(), json.dumps(v)))\n"
        "        return '\\n'.join(lines).encode('utf-8')\n"
        "    if fmt == 'toml':\n"
        "        lines = []\n"
        "        for k, v in flat.items():\n"
        "            lines.append('\"%s\" = %s' % (k, json.dumps(v)))\n"
        "        return '\\n'.join(lines).encode('utf-8')\n"
        "    return json.dumps(flat, ensure_ascii=False).encode('utf-8')\n"
        "\n"
        "def import_cfg(data, merge=True, current=None):\n"
        "    try:\n"
        "        parsed = json.loads(data.decode('utf-8'))\n"
        "    except Exception as e:\n"
        "        return {}, str(e)\n"
        "    if not isinstance(parsed, dict):\n"
        "        return {}, 'not a dict'\n"
        "    if merge and current:\n"
        "        out = dict(current)\n"
        "        for k, v in parsed.items():\n"
        "            if out.get(k) is None:\n"
        "                out[k] = v\n"
        "        return out, None\n"
        "    return parsed, None\n"
    )
    files["migrations.py"] = (
        "CONFIG_MIGRATIONS = {}\n"
        "\n"
        "def register_migration(from_version, to_version, fn):\n"
        "    CONFIG_MIGRATIONS[(from_version, to_version)] = fn\n"
        "\n"
        "def migrate(cfg, from_version, to_version):\n"
        "    if from_version == to_version:\n"
        "        return cfg\n"
        "    fn = CONFIG_MIGRATIONS.get((from_version, to_version))\n"
        "    if fn:\n"
        "        return fn(cfg)\n"
        "    return cfg\n"
    )
    files["env.py"] = (
        "import os\n"
        "\n"
        "def env_key(section, key):\n"
        "    return 'DDT_%s_%s' % (section.upper(), key.upper())\n"
        "\n"
        "def env_value(section, key):\n"
        "    ek = env_key(section, key)\n"
        "    if ek in os.environ:\n"
        "        return os.environ[ek]\n"
        "    return None\n"
        "\n"
        "def env_all(defaults):\n"
        "    out = {}\n"
        "    for section, keys in defaults.items():\n"
        "        if not isinstance(keys, dict):\n"
        "            continue\n"
        "        for k in keys:\n"
        "            v = env_value(section, k)\n"
        "            if v is not None:\n"
        "                out['%s.%s' % (section, k)] = v\n"
        "    return out\n"
    )
    files["loader.py"] = (
        "import json\n"
        "from pathlib import Path\n"
        "\n"
        "class ConfigLoader:\n"
        "    def __init__(self, module_name, base_dir='data/tetko_config'):\n"
        "        self.module_name = module_name\n"
        "        self.base_dir = Path(base_dir)\n"
        "        self.base_dir.mkdir(parents=True, exist_ok=True)\n"
        "        self.path = self.base_dir / ('%s.json' % module_name)\n"
        "\n"
        "    def load(self):\n"
        "        if not self.path.exists():\n"
        "            return {}\n"
        "        try:\n"
        "            return json.loads(self.path.read_text(encoding='utf-8'))\n"
        "        except Exception:\n"
        "            return {}\n"
        "\n"
        "    def save(self, data):\n"
        "        try:\n"
        "            self.path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')\n"
        "            return True\n"
        "        except Exception:\n"
        "            return False\n"
        "\n"
        "    def save_atomic(self, data):\n"
        "        import tempfile, os\n"
        "        try:\n"
        "            fd, tmp = tempfile.mkstemp(prefix='cfg_', suffix='.json', dir=str(self.base_dir))\n"
        "            with os.fdopen(fd, 'w', encoding='utf-8') as f:\n"
        "                json.dump(data, f, ensure_ascii=False, indent=2)\n"
        "            os.replace(tmp, self.path)\n"
        "            return True\n"
        "        except Exception:\n"
        "            return self.save(data)\n"
    )
    files["manager.py"] = (
        "import copy\n"
        "from .defaults import CFG_DEFAULTS, CFG_SCHEMA, CFG_SECTIONS\n"
        "from .sections import flatten, unflatten, section_of, get_path, set_path\n"
        "from .validator import validate_cfg\n"
        "from .schema import validate_schema\n"
        "from .history import History\n"
        "from .override import OverrideManager\n"
        "from .profiles import ProfileManager\n"
        "from .export import export_cfg, import_cfg\n"
        "from .loader import ConfigLoader\n"
        "from .env import env_all\n"
        "\n"
        "class ConfigManager:\n"
        "    def __init__(self, module_name='DontDoThatADM', base_dir='data/tetko_config'):\n"
        "        self.module_name = module_name\n"
        "        self.defaults = CFG_DEFAULTS\n"
        "        self.schema = CFG_SCHEMA\n"
        "        self.sections = CFG_SECTIONS\n"
        "        self.loader = ConfigLoader(module_name, base_dir)\n"
        "        self.history = History()\n"
        "        self.overrides = OverrideManager()\n"
        "        self.profiles = ProfileManager()\n"
        "        self._data = {}\n"
        "        self._load()\n"
        "\n"
        "    def _load(self):\n"
        "        disk = self.loader.load()\n"
        "        data = {}\n"
        "        for s, v in self.defaults.items():\n"
        "            data[s] = copy.deepcopy(v) if isinstance(v, dict) else v\n"
        "        for s, v in disk.items():\n"
        "            if isinstance(v, dict) and isinstance(data.get(s), dict):\n"
        "                data[s].update(v)\n"
        "            else:\n"
        "                data[s] = v\n"
        "        env = env_all(self.defaults)\n"
        "        for k, v in env.items():\n"
        "            if v in ('true', 'True', '1'):\n"
        "                v = True\n"
        "            elif v in ('false', 'False', '0'):\n"
        "                v = False\n"
        "            else:\n"
        "                try:\n"
        "                    v = int(v)\n"
        "                except Exception:\n"
        "                    try:\n"
        "                        v = float(v)\n"
        "                    except Exception:\n"
        "                        pass\n"
        "            set_path(data, k, v)\n"
        "        self._data = data\n"
        "\n"
        "    def _save(self):\n"
        "        self.loader.save_atomic(self._data)\n"
        "\n"
        "    def all(self):\n"
        "        return copy.deepcopy(self._data)\n"
        "\n"
        "    def section(self, name):\n"
        "        v = self._data.get(name)\n"
        "        if isinstance(v, dict):\n"
        "            return dict(v)\n"
        "        return {}\n"
        "\n"
        "    def get(self, key, default=None):\n"
        "        v = get_path(self._data, key)\n"
        "        if v is None and default is not None:\n"
        "            return default\n"
        "        return v\n"
        "\n"
        "    def set(self, key, value, actor='?'):\n"
        "        rule = self.schema.get(key)\n"
        "        if rule:\n"
        "            ok, err = validate_schema(key, value, self.schema)\n"
        "            if not ok:\n"
        "                raise ValueError('%s: %s' % (key, err))\n"
        "        old = get_path(self._data, key)\n"
        "        set_path(self._data, key, value)\n"
        "        self.history.push(key, old, value, actor)\n"
        "        self._save()\n"
        "        return True\n"
        "\n"
        "    def reset(self, key, actor='reset'):\n"
        "        section = section_of(key, self.defaults)\n"
        "        short = key.split('.', 1)[-1] if '.' in key else key\n"
        "        if short not in self.defaults.get(section, {}):\n"
        "            return False\n"
        "        default = copy.deepcopy(self.defaults[section][short])\n"
        "        old = get_path(self._data, key)\n"
        "        set_path(self._data, key, default)\n"
        "        self.history.push(key, old, default, actor)\n"
        "        self._save()\n"
        "        return True\n"
        "\n"
        "    def validate(self):\n"
        "        flat = flatten(self._data)\n"
        "        return validate_cfg(flat, self.defaults)\n"
        "\n"
        "    def flat(self):\n"
        "        return flatten(self._data)\n"
        "\n"
        "    def schema_for(self, key):\n"
        "        section = section_of(key, self.defaults)\n"
        "        short = key.split('.', 1)[-1] if '.' in key else key\n"
        "        defaults = self.defaults.get(section, {})\n"
        "        base = {'type': 'unknown', 'default': None, 'section': section}\n"
        "        if short in defaults:\n"
        "            base['type'] = type(defaults[short]).__name__\n"
        "            base['default'] = defaults[short]\n"
        "        rule = self.schema.get(key)\n"
        "        if rule:\n"
        "            base.update(rule)\n"
        "        return base\n"
        "\n"
        "    def use_profile(self, name):\n"
        "        p = self.profiles.load(name)\n"
        "        if not p:\n"
        "            return False\n"
        "        for s, v in p.items():\n"
        "            if isinstance(v, dict):\n"
        "                cur = self._data.get(s) or {}\n"
        "                if not isinstance(cur, dict):\n"
        "                    cur = {}\n"
        "                cur.update(v)\n"
        "                self._data[s] = cur\n"
        "            else:\n"
        "                self._data[s] = v\n"
        "        self._save()\n"
        "        return True\n"
        "\n"
        "    def export(self, fmt='json'):\n"
        "        return export_cfg(self.flat(), fmt)\n"
        "\n"
        "    def import_(self, data, merge=True):\n"
        "        cur = self.flat()\n"
        "        new, err = import_cfg(data, merge=merge, current=cur)\n"
        "        if err:\n"
        "            return 0, err\n"
        "        cnt = 0\n"
        "        for k, v in new.items():\n"
        "            set_path(self._data, k, v)\n"
        "            cnt += 1\n"
        "        self._save()\n"
        "        return cnt, None\n"
    )

    for name, content in files.items():
        (cfg_dir / name).write_text(content, encoding="utf-8")


class _PluginCtx(dict):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        object.__setattr__(self, "_meta", {})
        object.__setattr__(self, "_plugin", None)
        object.__setattr__(self, "_manifest", None)
        object.__setattr__(self, "_state", {})
        object.__setattr__(self, "_cache", {})
        object.__setattr__(self, "_shared", {})
        object.__setattr__(self, "_logger", None)
        object.__setattr__(self, "_cfg", None)
        object.__setattr__(self, "_module", None)
        object.__setattr__(self, "_kernel", None)
        object.__setattr__(self, "_storage", None)

    def __getattr__(self, item):
        try:
            return self[item]
        except KeyError:
            raise AttributeError(item)

    def __setattr__(self, key, value):
        if key.startswith("_"):
            object.__setattr__(self, key, value)
        else:
            self[key] = value

    @property
    def meta(self):
        return object.__getattribute__(self, "_meta")

    @property
    def plugin(self):
        return object.__getattribute__(self, "_plugin")

    @property
    def manifest(self):
        return object.__getattribute__(self, "_manifest")

    @property
    def state(self):
        return object.__getattribute__(self, "_state")

    @property
    def cache(self):
        return object.__getattribute__(self, "_cache")

    @property
    def logger(self):
        return object.__getattribute__(self, "_logger")

    @property
    def cfg(self):
        return object.__getattribute__(self, "_cfg")

    @property
    def shared(self):
        return object.__getattribute__(self, "_shared")

    @property
    def module(self):
        return object.__getattribute__(self, "_module")

    @property
    def kernel(self):
        return object.__getattribute__(self, "_kernel")

    @property
    def storage(self):
        return object.__getattribute__(self, "_storage")

    def call_plugin(self, plugin_name, method_name, *args, **kwargs):
        m = object.__getattribute__(self, "_module")
        if m is None:
            return None
        key = str(plugin_name or "").lower().replace(" ", "_")
        info = m._plugins.get(key)
        if not info:
            return None
        obj = info.get("module")
        if obj is None:
            return None
        fn = getattr(obj, method_name, None)
        if not callable(fn):
            return None
        try:
            return fn(*args, **kwargs)
        except Exception:
            return None

    def emit(self, event_type, data=None):
        m = object.__getattribute__(self, "_module")
        if m is None:
            return
        m._emit_event(event_type, data or {})


class _Return:
    CONTINUE = "continue"
    MODIFY = "modify"
    BLOCK = "block"
    REPLACE = "replace"
    ERROR = "error"
    SKIP = "skip"
    CHAIN = "chain"

    def __init__(self, kind, value=None, reason=None):
        self.kind = kind
        self.value = value
        self.reason = reason

    @classmethod
    def cont(cls):
        return cls(cls.CONTINUE)

    @classmethod
    def modify(cls, value):
        return cls(cls.MODIFY, value=value)

    @classmethod
    def block(cls, reason=""):
        return cls(cls.BLOCK, reason=reason)

    @classmethod
    def replace(cls, value):
        return cls(cls.REPLACE, value=value)

    @classmethod
    def error(cls, reason=""):
        return cls(cls.ERROR, reason=reason)

    @classmethod
    def skip(cls):
        return cls(cls.SKIP)

    @classmethod
    def chain(cls, value=None):
        return cls(cls.CHAIN, value=value)


@dataclass
class _DDTManifest:
    name: str = ""
    version: str = "0.0.0"
    author: str = ""
    description: str = ""
    api: str = "1.5.0"
    min_core: str = ""
    access: List[str] = field(default_factory=list)
    tags: List[str] = field(default_factory=list)
    categories: List[str] = field(default_factory=list)
    requires: List[str] = field(default_factory=list)
    optional: List[str] = field(default_factory=list)
    conflicts: List[str] = field(default_factory=list)
    provides: List[str] = field(default_factory=list)
    cfg_defaults: Dict[str, Any] = field(default_factory=dict)
    cfg_schema: Dict[str, Any] = field(default_factory=dict)
    events: List[str] = field(default_factory=list)
    priority: Dict[str, int] = field(default_factory=dict)
    pipelines: Dict[str, List[str]] = field(default_factory=dict)
    license: str = ""
    channel: str = "stable"
    stability: str = "stable"
    group: str = ""
    template: str = ""
    timeout: int = 10
    async_only: bool = True
    retry_on_error: bool = False
    max_retries: int = 2
    hidden: bool = False
    deprecated: bool = False


class _DDTPlugin:
    manifest = None

    def __init__(self, manifest=None):
        if manifest is not None:
            self.manifest = manifest
        self._ctx_ref = None
        self._loaded = False


class _PluginLoggerImpl:
    def __init__(self, name, base_dir="data/dontdothat_plugins_logs"):
        self.name = name
        self.base_dir = Path(base_dir)
        self.base_dir.mkdir(parents=True, exist_ok=True)
        self.path = self.base_dir / ("%s.log" % name)

    def _write(self, level, msg):
        try:
            line = "[%s] [%s] %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), level, str(msg))
            if self.path.exists() and self.path.stat().st_size > 1024 * 1024:
                try:
                    bak = self.path.with_suffix(".log.1")
                    if bak.exists():
                        bak.unlink()
                    self.path.rename(bak)
                except Exception:
                    pass
            with open(self.path, "a", encoding="utf-8") as f:
                f.write(line)
        except Exception:
            pass

    def debug(self, msg):
        self._write("DEBUG", msg)

    def info(self, msg):
        self._write("INFO", msg)

    def warning(self, msg):
        self._write("WARN", msg)

    def error(self, msg):
        self._write("ERROR", msg)


class _PluginConfigView:
    def __init__(self, module, plugin_name, defaults, schema):
        self._module = module
        self._name = plugin_name
        self._defaults = dict(defaults or {})
        self._schema = dict(schema or {})

    def _store(self):
        cfg = self._module._cfg_mgr
        plugins = cfg.section("plugins")
        store = plugins.get("per_plugin") or {}
        return plugins, store, cfg

    def get(self, key, default=None):
        _, store, _ = self._store()
        per = store.get(self._name) or {}
        if key in per:
            return per[key]
        if key in self._defaults:
            return self._defaults[key]
        return default

    def set(self, key, value):
        rule = self._schema.get(key)
        if rule:
            t = rule.get("type")
            if t == "int" and (not isinstance(value, int) or isinstance(value, bool)):
                raise ValueError("expected int")
            if t == "float" and (not isinstance(value, (int, float)) or isinstance(value, bool)):
                raise ValueError("expected float")
            if t == "str" and not isinstance(value, str):
                raise ValueError("expected str")
            if t == "bool" and not isinstance(value, bool):
                raise ValueError("expected bool")
        _, store, cfg = self._store()
        per = store.get(self._name) or {}
        per[key] = value
        store[self._name] = per
        cfg.set("plugins.per_plugin", store, actor="plugin:" + self._name)

    def all(self):
        _, store, _ = self._store()
        per = dict(store.get(self._name) or {})
        for k, v in self._defaults.items():
            per.setdefault(k, v)
        return per


class _PluginStorage:
    def __init__(self, plugin_name, base_dir="data/dontdothat_plugins_state"):
        self.plugin_name = plugin_name
        self.base_dir = Path(base_dir)
        self.base_dir.mkdir(parents=True, exist_ok=True)
        safe = "".join(c if c.isalnum() or c in "._-" else "_" for c in plugin_name)
        self.path = self.base_dir / ("%s.db" % safe)
        self._conn = None
        self._lock = threading.Lock()

    _BACKUP_THRESHOLD_BYTES = 8 * 1024 * 1024

    def _maybe_backup(self):
        try:
            if not self.path.exists():
                return
            if self.path.stat().st_size < self._BACKUP_THRESHOLD_BYTES:
                return
            bak = self.path.with_suffix(".db.bak")
            if bak.exists():
                try:
                    bak.unlink()
                except Exception:
                    pass
            shutil.copyfile(self.path, bak)
        except Exception:
            pass

    def schema(self):
        try:
            row = self.query("SELECT value FROM _kv WHERE key='__schema__'")
            if row and row[0]:
                return int(json.loads(row[0][0]))
        except Exception:
            pass
        return 0

    def set_schema(self, version):
        self.set("__schema__", int(version))

    def _connect(self):
        if self._conn is not None:
            return self._conn
        self._maybe_backup()
        conn = sqlite3.connect(str(self.path), check_same_thread=False)
        try:
            conn.execute("PRAGMA journal_mode=WAL")
        except Exception:
            pass
        conn.execute("CREATE TABLE IF NOT EXISTS _kv (key TEXT PRIMARY KEY, value TEXT, updated REAL)")
        conn.commit()
        self._conn = conn
        return conn

    def get(self, key, default=None):
        try:
            with self._lock:
                conn = self._connect()
                row = conn.execute("SELECT value FROM _kv WHERE key=?", (str(key),)).fetchone()
                if row is None:
                    return default
                try:
                    return json.loads(row[0])
                except Exception:
                    return row[0]
        except Exception:
            return default

    def set(self, key, value):
        try:
            with self._lock:
                conn = self._connect()
                conn.execute(
                    "INSERT OR REPLACE INTO _kv (key, value, updated) VALUES (?,?,?)",
                    (str(key), json.dumps(value, ensure_ascii=False), time.time()),
                )
                conn.commit()
            return True
        except Exception:
            return False

    def delete(self, key):
        try:
            with self._lock:
                conn = self._connect()
                conn.execute("DELETE FROM _kv WHERE key=?", (str(key),))
                conn.commit()
            return True
        except Exception:
            return False

    def keys(self):
        try:
            with self._lock:
                conn = self._connect()
                return [r[0] for r in conn.execute("SELECT key FROM _kv").fetchall()]
        except Exception:
            return []

    def execute(self, sql, params=()):
        try:
            with self._lock:
                conn = self._connect()
                cur = conn.execute(sql, params)
                conn.commit()
                return cur
        except Exception:
            return None

    def query(self, sql, params=()):
        try:
            with self._lock:
                conn = self._connect()
                return conn.execute(sql, params).fetchall()
        except Exception:
            return []

    def close(self):
        try:
            with self._lock:
                if self._conn is not None:
                    self._conn.close()
                    self._conn = None
        except Exception:
            pass


class _StateStore:
    def __init__(self, base_dir="data/dontdothat_plugins_state"):
        self.base_dir = Path(base_dir)
        self.base_dir.mkdir(parents=True, exist_ok=True)
        self._lock = threading.Lock()
        self._cache = {}

    def _path(self, name):
        safe = "".join(c if c.isalnum() or c in "._-" else "_" for c in name)
        return self.base_dir / (safe + ".json")

    def get(self, name):
        with self._lock:
            if name in self._cache:
                return self._cache[name]
            p = self._path(name)
            if p.exists():
                try:
                    data = json.loads(p.read_text(encoding="utf-8"))
                    if not isinstance(data, dict):
                        data = {}
                except Exception:
                    data = {}
            else:
                data = {}
            self._cache[name] = data
            return data

    def save(self, name):
        with self._lock:
            data = self._cache.get(name)
            if data is None:
                return
            try:
                self._path(name).write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
            except Exception:
                pass

    def save_all(self):
        with self._lock:
            names = list(self._cache.keys())
        for n in names:
            self.save(n)

    def clear(self, name):
        with self._lock:
            self._cache[name] = {}
            try:
                self._path(name).unlink()
            except Exception:
                pass


class _PluginCacheStore:
    def __init__(self, ttl=300, max_size=1000):
        self.ttl = ttl
        self.max_size = max_size
        self._data = {}

    def get(self, key):
        e = self._data.get(key)
        if not e:
            return None
        if time.time() - e["ts"] > e["ttl"]:
            del self._data[key]
            return None
        return e["value"]

    def set(self, key, value, ttl=None):
        self._data[key] = {"value": value, "ts": time.time(), "ttl": ttl or self.ttl}
        if len(self._data) > self.max_size:
            items = sorted(self._data.items(), key=lambda kv: kv[1]["ts"])
            for k, _ in items[: len(items) // 2]:
                self._data.pop(k, None)

    def delete(self, key):
        self._data.pop(key, None)

    def clear(self):
        self._data.clear()


class _EventBus:
    def __init__(self, log_size=500):
        self._log = []
        self._log_size = log_size

    def emit(self, event_type, data=None):
        rec = {"ts": time.time(), "type": event_type, "data": data or {}}
        self._log.append(rec)
        if len(self._log) > self._log_size:
            self._log = self._log[-self._log_size:]
        return rec

    def history(self, limit=50, event_type=None):
        out = self._log
        if event_type:
            out = [r for r in out if r["type"] == event_type]
        return out[-limit:]


class _HealthMonitor:
    def __init__(self):
        self._status = {}

    def update(self, name, status, message=""):
        self._status[name] = {"status": status, "message": message, "checked_at": time.time()}

    def get(self, name):
        return self._status.get(name)

    def all(self):
        return dict(self._status)


class _Metrics:
    def __init__(self):
        self._data = {}

    def inc(self, plugin, hook, key="calls", amount=1):
        p = self._data.setdefault(plugin, {}).setdefault(hook, {})
        p[key] = p.get(key, 0) + amount

    def add_time(self, plugin, hook, seconds):
        p = self._data.setdefault(plugin, {}).setdefault(hook, {})
        p["total_time"] = p.get("total_time", 0.0) + seconds

    def get(self, plugin=None):
        if plugin:
            return self._data.get(plugin, {})
        return dict(self._data)

    def clear(self):
        self._data.clear()


class _RollbackManager:
    def __init__(self, base_dir="data/dontdothat_plugins_versions", max_versions=3):
        self.base_dir = Path(base_dir)
        self.base_dir.mkdir(parents=True, exist_ok=True)
        self.max_versions = max_versions

    def store_version(self, name, version, path):
        folder = self.base_dir / name
        folder.mkdir(parents=True, exist_ok=True)
        target = folder / ("%s.py" % version)
        try:
            shutil.copyfile(path, target)
        except Exception:
            return False
        versions = sorted(folder.glob("*.py"), key=lambda p: p.stat().st_mtime)
        while len(versions) > self.max_versions:
            old = versions.pop(0)
            try:
                old.unlink()
            except Exception:
                pass
        return True

    def list_versions(self, name):
        folder = self.base_dir / name
        if not folder.exists():
            return []
        return sorted([p.stem for p in folder.glob("*.py")])

    def get_version(self, name, version):
        p = self.base_dir / name / ("%s.py" % version)
        if p.exists():
            return p
        return None


def _parse_version_tuple(v):
    parts = []
    for part in str(v).split("."):
        num = part.split("-")[0]
        try:
            parts.append(int(num))
        except ValueError:
            parts.append(0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts)


def _compare_versions(a, b):
    ta, tb = _parse_version_tuple(a), _parse_version_tuple(b)
    if ta < tb:
        return -1
    if ta > tb:
        return 1
    return 0


def _ddt_headers_dict(resp):
    out = {}
    try:
        h = getattr(resp, "headers", None)
        if h is None:
            return out
        try:
            items = dict(h).items()
        except Exception:
            items = []
        for k, v in items:
            out[str(k)] = str(v)
    except Exception:
        pass
    return out


def _semver_satisfies(current, required):
    if not required:
        return True, ''
    req = str(required).strip()
    op = '>='
    ver = req
    for prefix in ('>=', '<=', '==', '>', '<', '!='):
        if req.startswith(prefix):
            op = prefix
            ver = req[len(prefix):].strip()
            break
    cur_t = _parse_version_tuple(current)
    req_t = _parse_version_tuple(ver)
    okv = True
    if op == '>=':
        okv = cur_t >= req_t
    elif op == '<=':
        okv = cur_t <= req_t
    elif op == '==':
        okv = cur_t == req_t
    elif op == '>':
        okv = cur_t > req_t
    elif op == '<':
        okv = cur_t < req_t
    elif op == '!=':
        okv = cur_t != req_t
    return okv, '%s %s' % (op, ver)


class DontDoThatADM(Module):
    name = "DontDoThatADM"
    __compat__ = "0.0.9.0"
    version = "0.0.0"
    author = "@flexOwnerAL"
    description = "owner edition"

    config = {
        "_bootstrap": True,
        "cfg_dir": "data/dontdothat_cfg_new_lib",
        "cfg_base_dir": "data/tetko_config",
        "sqlite_db_path": "data/dontdothat.db",
        "plugins_dir_legacy": "data/dontdothat_plugins",
        "plugins_dir_new": "data/dontdothat_plugins_new",
        "plugins_dir_bundles": "data/dontdothat_plugins_bundles",
        "state_dir": "data/dontdothat_plugins_state",
        "logs_dir": "data/dontdothat_plugins_logs",
        "versions_dir": "data/dontdothat_plugins_versions",
    }

    _RX_URL = re.compile(r"https?://\S+")
    _RX_WORD = re.compile(r"\w+", re.UNICODE)
    _RX_FLAG = re.compile(r'--(\w+)(?:=(?:"([^"]*)"|\'([^\']*)\'|(\S+)))?')
    _RX_BARE_URL = re.compile(r"\b([a-zA-Z0-9][a-zA-Z0-9-]*(?:\.[a-zA-Z0-9-]+)+(?:/[^\s]*)?)")
    _RX_QUOTED = re.compile(r'"([^"]+)"')
    _RX_TOKEN = re.compile(r'("(?:[^"\\]|\\.)*"|\(|\)|\bAND\b|\bOR\b|\bNOT\b|[+\-]?\S+)', re.IGNORECASE)
    _RX_WILDCARD = re.compile(r"(\w+)\*")
    _RX_FUZZY = re.compile(r"~(\w+)")
    _RX_DDG_REDIRECT = re.compile(r"^https?://(?:lite\.|html\.|www\.)?duckduckgo\.com/l/\?[^\"']*?uddg=([^&\s\"']+)", re.IGNORECASE)
    _RX_DDG_REDIRECT_INLINE = re.compile(r"https?://(?:lite\.|html\.|www\.)?duckduckgo\.com/l/\?[^\"'\s>]*?uddg=([^&\s\"'>]+)", re.IGNORECASE)
    _RX_TITLE = re.compile(r"(?is)<title[^>]*>(.*?)</title>")
    _RX_OG_TITLE = re.compile(r'<meta[^>]+property=["\']og:title["\'][^>]+content=["\']([^"\']+)["\']', re.IGNORECASE)
    _RX_TW_TITLE = re.compile(r'<meta[^>]+name=["\']twitter:title["\'][^>]+content=["\']([^"\']+)["\']', re.IGNORECASE)
    _RX_H1 = re.compile(r"(?is)<h1[^>]*>(.*?)</h1>")

    def __init__(self, kernel=None):
        super().__init__(kernel)
        self._sem = None
        self._sem_limit = None
        self._sem_lock = threading.Lock()
        self._sqlite_lock = threading.Lock()
        self._morph_lock = threading.Lock()
        self._rate_lock = threading.Lock()
        self._cache = {}
        self._stats = {"total_queries": 0, "total_sources_hit": 0, "top_queries": {}, "per_source": {}, "per_source_fail": {}, "per_user": {}, "latency": {}, "slow_queries": []}
        self._history = []
        self._audit = []
        self._rate_limit_map = {}
        self._last_result = {}
        self._plugins = {}
        self._sqlite = None
        self._cookie_jar = {}
        self._strategy_stats = {}
        self._repo_index_cache = {}
        self._dead_services = set()
        self._user_activity = {}
        self._active_menus = {}
        self._morph_cache = {}
        self._plugin_quota = {}
        self._cfg_mgr = None
        self._state_store = None
        self._cache_store = None
        self._event_bus = None
        self._health_monitor = None
        self._metrics = None
        self._rollback = None
        self._plugin_cfg_views = {}
        self._hook_budget = {}
        self._storage = {}

    def _ensure_cfg(self):
        cfg_dir = Path(self.config.get("cfg_dir", "data/dontdothat_cfg_new_lib"))
        _write_cfg_lib(cfg_dir)

    def _load_cfg(self):
        cfg_dir = Path(self.config.get("cfg_dir", "data/dontdothat_cfg_new_lib"))
        parent = str(cfg_dir.parent)
        if parent not in sys.path:
            sys.path.insert(0, parent)
        mod_name = "dontdothat_cfg_new_lib"
        if mod_name in sys.modules:
            for k in list(sys.modules.keys()):
                if k == mod_name or k.startswith(mod_name + "."):
                    sys.modules.pop(k, None)
        try:
            spec = importlib.util.spec_from_file_location(mod_name, cfg_dir / "__init__.py", submodule_search_locations=[str(cfg_dir)])
            if spec is None or spec.loader is None:
                return None
            mod = importlib.util.module_from_spec(spec)
            sys.modules[mod_name] = mod
            spec.loader.exec_module(mod)
            return mod
        except Exception as e:
            try:
                self.log.warning("cfg lib load failed: %s" % e)
            except Exception:
                pass
            return None

    async def on_load(self):
        self._ensure_cfg()
        cfg_lib = self._load_cfg()
        if cfg_lib is None:
            try:
                self.log.error("cfg lib unavailable; module cannot start")
            except Exception:
                pass
            return
        manager_cls = getattr(cfg_lib, "ConfigManager", None)
        if manager_cls is None:
            try:
                self.log.error("ConfigManager missing")
            except Exception:
                pass
            return
        self._cfg_mgr = manager_cls(module_name=self.name, base_dir=self.config.get("cfg_base_dir", "data/tetko_config"))
        self._state_store = _StateStore(self.config.get("state_dir", "data/dontdothat_plugins_state"))
        self._cache_store = _PluginCacheStore()
        self._event_bus = _EventBus()
        self._health_monitor = _HealthMonitor()
        self._metrics = _Metrics()
        self._rollback = _RollbackManager(self.config.get("versions_dir", "data/dontdothat_plugins_versions"))
        Path(self.config.get("plugins_dir_legacy", "data/dontdothat_plugins")).mkdir(parents=True, exist_ok=True)
        Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new")).mkdir(parents=True, exist_ok=True)
        Path(self.config.get("state_dir", "data/dontdothat_plugins_state")).mkdir(parents=True, exist_ok=True)
        Path(self.config.get("logs_dir", "data/dontdothat_plugins_logs")).mkdir(parents=True, exist_ok=True)
        Path(self.config.get("versions_dir", "data/dontdothat_plugins_versions")).mkdir(parents=True, exist_ok=True)
        if self._cfg_mgr.get("plugins.enabled", True):
            legacy_dir = Path(self.config.get("plugins_dir_legacy", "data/dontdothat_plugins"))
            new_dir = Path(self.config.get("plugins_dir_new", "data/dontdothat_plugins_new"))
            for py in sorted(legacy_dir.glob("*.py")):
                if py.name.startswith("_"):
                    continue
                await self._load_plugin_any(py)
            for ddt in sorted(new_dir.glob("*.ddt")):
                if ddt.name.startswith("_"):
                    continue
                await self._load_plugin_any(ddt)
            for py in sorted(new_dir.glob("*.py")):
                if py.name.startswith("_"):
                    continue
                try:
                    self.log.warning("ddt: legacy .py in new dir (rename to .ddt): %s", py.name)
                except Exception:
                    pass
                await self._load_plugin_any(py)
        await self._run_hook("on_start", {"module": self})

    async def on_unload(self):
        for name in list(self._plugins.keys()):
            try:
                await self._run_hook_plugin(name, "on_unload", {"module": self})
            except Exception:
                pass
        if self._state_store is not None:
            self._state_store.save_all()

    def _import_plugin_module(self, path):
        p = Path(path)
        stem = p.stem
        mod_name = "ddt_plugin_%s_%s" % (stem, uuid.uuid4().hex[:6])
        if p.suffix.lower() == ".ddt":
            import importlib.machinery as _ilm
            _loader = _ilm.SourceFileLoader(mod_name, str(p))
            spec = importlib.util.spec_from_file_location(mod_name, p, loader=_loader)
        else:
            spec = importlib.util.spec_from_file_location(mod_name, p)
        if spec is None or spec.loader is None:
            raise ImportError("spec failed")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[mod_name] = mod
        spec.loader.exec_module(mod)
        return mod

    def _detect_manifest(self, mod):
        for attr in ("MANIFEST", "MANIFEST_CLASS"):
            obj = getattr(mod, attr, None)
            if obj is None:
                continue
            if is_dataclass(obj) and not isinstance(obj, type):
                try:
                    return asdict(obj)
                except Exception:
                    pass
            if is_dataclass(obj) and isinstance(obj, type):
                try:
                    return asdict(obj())
                except Exception:
                    pass
            if isinstance(obj, dict):
                return dict(obj)
            if hasattr(obj, "__dict__") and hasattr(obj, "name"):
                return {k: v for k, v in obj.__dict__.items() if not k.startswith("_")}
        plugin_cls = getattr(mod, "Plugin", None)
        if plugin_cls is not None and hasattr(plugin_cls, "manifest"):
            m = plugin_cls.manifest
            if is_dataclass(m) and not isinstance(m, type):
                try:
                    return asdict(m)
                except Exception:
                    pass
            if is_dataclass(m) and isinstance(m, type):
                try:
                    return asdict(m())
                except Exception:
                    pass
            if isinstance(m, dict):
                return dict(m)
        plain = getattr(mod, "PLUGIN", None)
        if isinstance(plain, dict):
            return dict(plain)
        flat = {}
        for k in ("name", "version", "author", "description", "access", "tags", "hooks", "min_core", "api", "priority", "events", "cfg_defaults"):
            if hasattr(mod, k):
                flat[k] = getattr(mod, k)
        if flat.get("name"):
            return flat
        for attr in dir(mod):
            if attr.startswith("_"):
                continue
            obj = getattr(mod, attr)
            if isinstance(obj, type) and hasattr(obj, "name") and hasattr(obj, "version"):
                return {k: v for k, v in obj.__dict__.items() if not k.startswith("_") and not callable(v)}
        return None

    _TRUST_ORDER = {"sandboxed": 0, "trusted": 1, "privileged": 2}

    def _resolve_trust(self, name, manifest, source="legacy"):
        overrides = self._cfg_mgr.get("plugins.trust_overrides") or {}
        if name in overrides:
            level = str(overrides[name] or "").lower()
            if level in self._TRUST_ORDER:
                return level
        author = str(manifest.get("author") or "").strip().lstrip("@").lower()
        privileged = [a.lstrip("@").lower() for a in (self._cfg_mgr.get("plugins.privileged_authors") or [])]
        trusted = [a.lstrip("@").lower() for a in (self._cfg_mgr.get("plugins.trusted_authors") or [])]
        if author and author in privileged:
            return "privileged"
        if source == "repo":
            repos = self._cfg_mgr.get("plugins.trusted_repos") or []
            repo = self._cfg_mgr.get("plugins.repo", "")
            if author and author in trusted:
                if repos and repo not in repos:
                    return "sandboxed"
                return "trusted"
            if repo and repo in repos:
                return "trusted"
            return "sandboxed"
        if source in ("legacy", "new", "ddt"):
            return "trusted"
        return "sandboxed"

    def _register_plugin(self, name, module_obj, manifest, trust, source, path):
        info = {"name": name, "module": module_obj, "manifest": manifest, "trust_level": trust, "source": source, "path": str(path), "enabled": True, "frozen": False, "loaded_at": time.time(), "sha256": ""}
        try:
            info["sha256"] = hashlib.sha256(Path(path).read_bytes()).hexdigest()
        except Exception:
            pass
        self._plugins[name] = info
        self._plugin_cfg_views[name] = _PluginConfigView(self, name, manifest.get("cfg_defaults") or {}, manifest.get("cfg_schema") or {})
        self._plugin_quota[name] = []
        return info

    def _unregister_plugin(self, name):
        info = self._plugins.pop(name, None)
        if info is None:
            return
        self._plugin_quota.pop(name, None)
        self._plugin_cfg_views.pop(name, None)

    async def _load_plugin_any(self, path):
        p = Path(path)
        if p.suffix.lower() == ".ddt":
            return await self._load_ddt_plugin(p)
        return await self._load_py_plugin(p)

    async def _load_ddt_plugin(self, path):
        p = Path(path)
        try:
            _head = p.read_bytes()[:4]
        except Exception as e:
            return False, "ddt read failed: %s" % e, {}
        if _head[:2] == b"PK":
            return await self._load_ddt_bundle(p)
        try:
            code_text = p.read_text(encoding="utf-8")
        except Exception as e:
            return False, "ddt read failed: %s" % e, {}
        first_line = (code_text.split("\n", 1)[0] or "").strip()
        if first_line.startswith("#!ddt"):
            parts = first_line.split()
            if len(parts) < 2:
                return False, "ddt magic header missing version", {}
        else:
            try:
                self.log.warning("ddt: missing magic header (add '#!ddt 1.5.0'): %s", p.name)
            except Exception:
                pass
        try:
            mod = self._import_plugin_module(p)
        except Exception as e:
            return False, "ddt import failed: %s" % e, {}
        manifest = self._detect_manifest(mod)
        if manifest is None:
            return False, "ddt manifest not found", {}
        if not manifest.get("name"):
            return False, "ddt manifest name missing", {}
        api = str(manifest.get("api") or "")
        if not api.startswith("1.5"):
            return False, "ddt requires api>=1.5.0 (got %r)" % api, {}
        plugin_cls = getattr(mod, "Plugin", None)
        if plugin_cls is None or not isinstance(plugin_cls, type):
            return False, "ddt requires class Plugin", {}
        name = manifest["name"].lower().replace(" ", "_")
        expected_sha = str(manifest.get("sha256") or "").strip().lower()
        if expected_sha:
            actual = hashlib.sha256(code_text.encode("utf-8")).hexdigest().lower()
            if actual != expected_sha:
                return False, "sha256 mismatch (want %s..., got %s...)" % (expected_sha[:16], actual[:16]), {}

        _trust_early = self._resolve_trust(name, manifest, source="ddt")
        if _trust_early != "privileged":
            _bm, _bc = self._scan_imports(code_text)
            if _bm or _bc:
                try:
                    self.log.warning("ddt scan: %s mods=%s calls=%s", name, _bm, _bc)
                except Exception:
                    pass
        missing, _ = self._resolve_requires(manifest.get("requires") or [])
        if missing:
            return False, "missing requirements: %s" % ", ".join(missing), {}
        conflict = []
        for conf in (manifest.get("conflicts") or []):
            key = str(conf).lower().replace(" ", "_")
            if key and key in self._plugins:
                conflict.append(str(conf))
        if conflict:
            return False, "conflicts with: %s" % ", ".join(conflict), {}
        if name in self._plugins:
            self._unregister_plugin(name)
        trust = self._resolve_trust(name, manifest, source="ddt")
        try:
            instance = plugin_cls()
        except Exception as e:
            return False, "instantiate: %s" % e, {}
        self._register_plugin(name, instance, manifest, trust, "ddt", p)
        timeout = self._plugin_timeout(manifest)
        try:
            ctx = self._make_ctx(name, "on_load", {"module": self, "name": name, "trust": trust})
            method = getattr(instance, "on_load", None)
            if callable(method):
                r = method(ctx)
                if asyncio.iscoroutine(r):
                    await asyncio.wait_for(r, timeout=timeout)
        except Exception as e:
            self._unregister_plugin(name)
            return False, "on_load failed: %s" % e, {}
        self._emit_event("plugin.loaded", {"name": name, "trust": trust, "source": "ddt"})
        return True, name, self._plugins[name]

    async def _load_ddt_bundle(self, path):
        import zipfile as _zipfile
        p = Path(path)
        bundle_root = Path(self.config.get("plugins_dir_bundles", "data/dontdothat_plugins_bundles"))
        bundle_root.mkdir(parents=True, exist_ok=True)
        target = bundle_root / p.stem
        try:
            if target.exists():
                shutil.rmtree(target, ignore_errors=True)
            target.mkdir(parents=True, exist_ok=True)
            with _zipfile.ZipFile(str(p), "r") as zf:
                for member in zf.namelist():
                    if ".." in member or member.startswith("/"):
                        continue
                    zf.extract(member, str(target))
        except Exception as e:
            return False, "bundle extract failed: %s" % e, {}
        mj = target / "manifest.json"
        if not mj.exists():
            return False, "bundle missing manifest.json", {}
        try:
            manifest = json.loads(mj.read_text(encoding="utf-8"))
        except Exception as e:
            return False, "bundle manifest invalid: %s" % e, {}
        if not isinstance(manifest, dict) or not manifest.get("name"):
            return False, "bundle manifest missing name", {}
        entry_name = str(manifest.get("entry") or "plugin.py")
        entry_path = target / entry_name
        if not entry_path.exists():
            return False, "bundle entry not found: %s" % entry_name, {}
        lib_dirs = manifest.get("lib") or []
        if isinstance(lib_dirs, str):
            lib_dirs = [lib_dirs]
        for ld in lib_dirs:
            lp = target / str(ld)
            if lp.is_dir() and str(lp) not in sys.path:
                sys.path.insert(0, str(lp))
        if str(target) not in sys.path:
            sys.path.insert(0, str(target))
        try:
            mod = self._import_plugin_module(entry_path)
        except Exception as e:
            return False, "bundle import failed: %s" % e, {}
        name = str(manifest["name"]).lower().replace(" ", "_")
        api = str(manifest.get("api") or "1.5.0")
        if not api.startswith("1.5"):
            return False, "bundle requires api>=1.5.0", {}
        trust = self._resolve_trust(name, manifest, source="ddt")
        missing, _ = self._resolve_requires(manifest.get("requires") or [])
        if missing:
            return False, "missing requirements: %s" % ", ".join(missing), {}
        conflict = []
        for conf in (manifest.get("conflicts") or []):
            ck = str(conf).lower().replace(" ", "_")
            if ck and ck in self._plugins:
                conflict.append(str(conf))
        if conflict:
            return False, "conflicts with: %s" % ", ".join(conflict), {}
        if name in self._plugins:
            self._unregister_plugin(name)
        plugin_cls = getattr(mod, "Plugin", None)
        try:
            if isinstance(plugin_cls, type):
                instance = plugin_cls()
            else:
                attrs = {}
                for h in (manifest.get("hooks") or []):
                    fn = getattr(mod, h, None)
                    if callable(fn):
                        attrs[h] = staticmethod(fn)
                for _attr in dir(mod):
                    if _attr.startswith("_") or _attr in attrs:
                        continue
                    _fn = getattr(mod, _attr)
                    if callable(_fn) and not isinstance(_fn, type):
                        attrs[_attr] = staticmethod(_fn)
                cls = type("ShimB_" + name, (_DDTPlugin,), attrs)
                shim = _DDTManifest(
                    name=manifest.get("name", name),
                    version=manifest.get("version", "1.0.0"),
                    author=manifest.get("author", ""),
                    description=manifest.get("description", ""),
                    api="1.0.0",
                    access=manifest.get("access") or [],
                    tags=manifest.get("tags") or [],
                )
                instance = cls(manifest=shim)
        except Exception as e:
            return False, "bundle instantiate failed: %s" % e, {}
        self._register_plugin(name, instance, manifest, trust, "ddt", entry_path)
        timeout = self._plugin_timeout(manifest)
        try:
            ctx = self._make_ctx(name, "on_load", {"module": self, "name": name, "trust": trust})
            method_obj = getattr(instance, "on_load", None)
            if callable(method_obj):
                r = method_obj(ctx)
                if asyncio.iscoroutine(r):
                    await asyncio.wait_for(r, timeout=timeout)
        except Exception as e:
            self._unregister_plugin(name)
            return False, "bundle on_load failed: %s" % e, {}
        self._emit_event("plugin.loaded", {"name": name, "trust": trust, "source": "ddt-bundle"})
        return True, name, self._plugins[name]

    async def _load_py_plugin(self, path):
        p = Path(path)
        try:
            code_text = p.read_text(encoding="utf-8")
        except Exception as e:
            return False, "read failed: %s" % e, {}
        try:
            mod = self._import_plugin_module(p)
        except Exception as e:
            return False, "import failed: %s" % e, {}
        manifest = self._detect_manifest(mod)
        if manifest is None:
            return False, "manifest not found", {}
        if not manifest.get("name"):
            return False, "manifest name missing", {}
        name = manifest["name"].lower().replace(" ", "_")
        _src_probe = "new" if "Plugin" in dir(mod) and isinstance(getattr(mod, "Plugin"), type) else "legacy"
        _trust_probe = self._resolve_trust(name, manifest, source=_src_probe)
        expected_sha = str(manifest.get("sha256") or "").strip().lower()
        if expected_sha:
            actual = hashlib.sha256(code_text.encode("utf-8")).hexdigest().lower()
            if actual != expected_sha:
                return False, "sha256 mismatch (want %s..., got %s...)" % (expected_sha[:16], actual[:16]), {}

        if _trust_probe != "privileged" and _src_probe == "new":
            _bm, _bc = self._scan_imports(code_text)
            if _bm or _bc:
                try:
                    self.log.warning("py scan: %s mods=%s calls=%s", name, _bm, _bc)
                except Exception:
                    pass
        missing, _ = self._resolve_requires(manifest.get("requires") or [])
        if missing:
            return False, "missing requirements: %s" % ", ".join(missing), {}
        conflict = []
        for conf in (manifest.get("conflicts") or []):
            key = str(conf).lower().replace(" ", "_")
            if key and key in self._plugins:
                conflict.append(str(conf))
        if conflict:
            return False, "conflicts with: %s" % ", ".join(conflict), {}
        if name in self._plugins:
            self._unregister_plugin(name)
        source = "new" if "Plugin" in dir(mod) and isinstance(getattr(mod, "Plugin"), type) else "legacy"
        trust = self._resolve_trust(name, manifest, source=source)
        if source == "new":
            try:
                instance = getattr(mod, "Plugin")()
            except Exception as e:
                return False, "instantiate: %s" % e, {}
            self._register_plugin(name, instance, manifest, trust, source, p)
        else:
            attrs = {}
            for h in (manifest.get("hooks") or []):
                fn = getattr(mod, h, None)
                if callable(fn):
                    attrs[h] = staticmethod(fn)
            for _attr in dir(mod):
                if _attr.startswith("_") or _attr in attrs:
                    continue
                _fn = getattr(mod, _attr)
                if callable(_fn) and not isinstance(_fn, type):
                    attrs[_attr] = staticmethod(_fn)
            cls = type("Shim_" + name, (_DDTPlugin,), attrs)
            shim_manifest = _DDTManifest(
                name=manifest.get("name", name),
                version=manifest.get("version", "1.0.0"),
                author=manifest.get("author", ""),
                description=manifest.get("description", ""),
                api="1.0.0",
                access=manifest.get("access") or [],
                tags=manifest.get("tags") or [],
            )
            instance = cls(manifest=shim_manifest)
            self._register_plugin(name, instance, manifest, trust, source, p)
        timeout = self._plugin_timeout(manifest)
        try:
            ctx = self._make_ctx(name, "on_load", {"module": self, "name": name, "trust": trust})
            method = getattr(instance, "on_load", None)
            if callable(method):
                r = method(ctx)
                if asyncio.iscoroutine(r):
                    await asyncio.wait_for(r, timeout=timeout)
        except Exception as e:
            self._unregister_plugin(name)
            return False, "on_load failed: %s" % e, {}
        self._emit_event("plugin.loaded", {"name": name, "trust": trust, "source": source})
        return True, name, self._plugins[name]

    _ACCESS_BY_TRUST = {
        "sandboxed":  frozenset({"inline", "ui", "cache"}),
        "trusted":    frozenset({"module", "inline", "ui", "cache"}),
        "privileged": frozenset({"module", "kernel", "inline", "ui", "cache"}),
    }

    def _make_ctx(self, plugin_name, hook_name, base):
        ctx = _PluginCtx()
        for k, v in base.items():
            ctx[k] = v
        info = self._plugins.get(plugin_name) or {}
        manifest = info.get("manifest") or {}
        trust = (info.get("trust_level") or "sandboxed").lower()
        declared = set(manifest.get("access") or [])
        allowed = self._ACCESS_BY_TRUST.get(trust, self._ACCESS_BY_TRUST["sandboxed"])
        access = declared & allowed
        state = self._state_store.get(plugin_name)
        object.__setattr__(ctx, "_meta", {
            "hook": hook_name,
            "plugin": plugin_name,
            "call_id": uuid.uuid4().hex,
            "started_at": time.time(),
        })
        object.__setattr__(ctx, "_plugin", info.get("module"))
        object.__setattr__(ctx, "_manifest", manifest)
        object.__setattr__(ctx, "_state", state)
        object.__setattr__(ctx, "_cache", self._cache_store)
        object.__setattr__(ctx, "_shared", self._cache_store)
        object.__setattr__(ctx, "_logger", _PluginLoggerImpl(plugin_name, self.config.get("logs_dir", "data/dontdothat_plugins_logs")))
        object.__setattr__(ctx, "_cfg", self._plugin_cfg_views.get(plugin_name))
        object.__setattr__(ctx, "_module", self if "module" in access else None)
        object.__setattr__(ctx, "_kernel", getattr(self, "kernel", None) if "kernel" in access else None)
        storage = self._storage.get(plugin_name)
        if storage is None:
            storage = _PluginStorage(plugin_name, self.config.get("state_dir", "data/dontdothat_plugins_state"))
            self._storage[plugin_name] = storage
        object.__setattr__(ctx, "_trust", trust)
        object.__setattr__(ctx, "_declared_access", declared)
        object.__setattr__(ctx, "_effective_access", access)
        object.__setattr__(ctx, "_storage", storage)
        for cap in access:
            if cap in ("module", "kernel"):
                self._audit_capability(plugin_name, cap)
        return ctx

    def _hook_budget_ok(self, plugin_name, hook_name, window=10.0, max_calls=200):
        now = time.time()
        key = "%s:%s" % (plugin_name, hook_name)
        bucket = self._hook_budget.setdefault(key, [])
        bucket[:] = [t for t in bucket if now - t < window]
        if len(bucket) >= max_calls:
            return False
        bucket.append(now)
        return True

    def _plugin_timeout(self, manifest):
        try:
            timeout = int((manifest or {}).get("timeout", 10) or 10)
        except Exception:
            timeout = 10
        return max(1, min(timeout, 120))

    async def _run_hook(self, hook_name, ctx_base):
        items = []
        for name, info in self._plugins.items():
            if info.get("enabled") is False or info.get("frozen"):
                continue
            manifest = info.get("manifest") or {}
            hooks = manifest.get("hooks") or []
            module_obj = info.get("module")
            method = getattr(module_obj, hook_name, None) if module_obj else None
            if method is None or not callable(method):
                if hook_name not in hooks:
                    continue
                continue
            priority = (manifest.get("priority") or {}).get(hook_name, 50)
            trust = (info.get("trust_level") or "sandboxed").lower()
            trust_rank = self._TRUST_ORDER.get(trust, 0)
            items.append((trust_rank, -priority, name, method))
        items.sort(key=lambda x: (-x[0], x[1], x[2]))
        result = None
        for trust_rank, _, name, method in items:
            info = self._plugins.get(name) or {}
            trust = (info.get("trust_level") or "sandboxed").lower()
            manifest = info.get("manifest") or {}
            timeout = self._plugin_timeout(manifest)
            if not self._hook_budget_ok(name, hook_name):
                try:
                    self._sqlite_log_plugin_error(name, hook_name, "rate limit exceeded")
                except Exception:
                    pass
                continue
            try:
                ctx = self._make_ctx(name, hook_name, ctx_base)
                r = method(ctx)
                if asyncio.iscoroutine(r):
                    r = await asyncio.wait_for(r, timeout=timeout)
                if r is None:
                    continue
                if isinstance(r, _Return):
                    if trust == "sandboxed" and r.kind in (_Return.BLOCK, _Return.ERROR):
                        try:
                            self._sqlite_log_plugin_error(name, hook_name, "sandbox tried to %s" % r.kind)
                        except Exception:
                            pass
                        continue
                    if r.kind == _Return.CONTINUE:
                        continue
                    if r.kind == _Return.SKIP:
                        return result
                    if r.kind == _Return.BLOCK:
                        return False
                    if r.kind in (_Return.MODIFY, _Return.REPLACE, _Return.CHAIN):
                        result = r.value
                        if r.kind != _Return.CHAIN:
                            return result
                        continue
                    if r.kind == _Return.ERROR:
                        raise RuntimeError(r.reason or "plugin error")
                if r is False:
                    if trust == "sandboxed":
                        try:
                            self._sqlite_log_plugin_error(name, hook_name, "sandbox tried to block")
                        except Exception:
                            pass
                        continue
                    return False
                if trust == "sandboxed" and not isinstance(r, (str, dict, list)):
                    try:
                        self._sqlite_log_plugin_error(name, hook_name, "sandbox returned unsupported type: %s" % type(r).__name__)
                    except Exception:
                        pass
                    continue
                return r
            except asyncio.TimeoutError:
                try:
                    self._sqlite_log_plugin_error(name, hook_name, "timeout after %ds" % timeout)
                except Exception:
                    pass
                continue
            except Exception as e:
                try:
                    self._sqlite_log_plugin_error(name, hook_name, str(e))
                except Exception:
                    pass
                continue
        return result

    async def _run_hook_plugin(self, plugin_name, hook_name, ctx_base):
        info = self._plugins.get(plugin_name)
        if not info or info.get("enabled") is False:
            return None
        module_obj = info.get("module")
        method = getattr(module_obj, hook_name, None) if module_obj else None
        if method is None or not callable(method):
            return None
        manifest = info.get("manifest") or {}
        timeout = self._plugin_timeout(manifest)
        try:
            ctx = self._make_ctx(plugin_name, hook_name, ctx_base)
            r = method(ctx)
            if asyncio.iscoroutine(r):
                r = await asyncio.wait_for(r, timeout=timeout)
            return r
        except asyncio.TimeoutError:
            try:
                self._sqlite_log_plugin_error(plugin_name, hook_name, "timeout after %ds" % timeout)
            except Exception:
                pass
            return None
        except Exception as e:
            try:
                self._sqlite_log_plugin_error(plugin_name, hook_name, str(e))
            except Exception:
                pass
            return None

    def _emit_event(self, event_type, data):
        if self._event_bus is not None:
            self._event_bus.emit(event_type, data)
        for name, info in self._plugins.items():
            manifest = info.get("manifest") or {}
            events = manifest.get("events") or []
            if event_type not in events:
                continue
            module_obj = info.get("module")
            method = getattr(module_obj, "on_event", None) if module_obj else None
            if method is None or not callable(method):
                continue
            try:
                ctx = self._make_ctx(name, "on_event", {"event": {"ts": time.time(), "type": event_type, "data": data or {}}})
                r = method(ctx)
                if asyncio.iscoroutine(r):
                    try:
                        loop = asyncio.get_running_loop()
                        loop.create_task(r)
                    except RuntimeError:
                        pass
            except Exception:
                continue

    def _audit_log(self, actor, action, details=""):
        if not self._cfg_mgr.get("audit.enabled", True):
            return
        self._audit.append({"ts": time.time(), "actor": str(actor) if actor is not None else "?", "action": action, "details": details[:300]})
        maxr = int(self._cfg_mgr.get("audit.max_records", 2000) or 2000)
        if len(self._audit) > maxr:
            self._audit = self._audit[-maxr:]

    def _sqlite_conn(self):
        if not self._cfg_mgr.get("sqlite.enabled", True):
            return None
        if self._sqlite is not None:
            return self._sqlite
        with self._sqlite_lock:
            if self._sqlite is not None:
                return self._sqlite
            try:
                db_path = self._cfg_mgr.get("sqlite.db_path") or self.config.get("sqlite_db_path", "data/dontdothat.db")
                path = Path(db_path)
                path.parent.mkdir(parents=True, exist_ok=True)
                conn = sqlite3.connect(str(path), check_same_thread=False)
                try:
                    conn.execute("PRAGMA journal_mode=WAL")
                except Exception:
                    pass
                conn.execute("CREATE TABLE IF NOT EXISTS fetches (ts REAL, source TEXT, url TEXT, status INTEGER, elapsed REAL, size INTEGER, blocked INTEGER, verdict TEXT)")
                conn.execute("CREATE TABLE IF NOT EXISTS queries (ts REAL, actor TEXT, query TEXT, hits INTEGER, errors INTEGER)")
                conn.execute("CREATE TABLE IF NOT EXISTS snapshots (ts REAL, source TEXT, query TEXT, url TEXT, html TEXT)")
                conn.execute("CREATE TABLE IF NOT EXISTS slow_queries (ts REAL, actor TEXT, query TEXT, elapsed REAL, hits INTEGER)")
                conn.execute("CREATE TABLE IF NOT EXISTS plugin_errors (ts REAL, plugin TEXT, hook TEXT, error TEXT)")
                conn.commit()
                self._sqlite = conn
            except Exception:
                self._sqlite = None
        return self._sqlite

    def _sqlite_log_fetch(self, source, url, status, elapsed, size, blocked, verdict):
        c = self._sqlite_conn()
        if c is None:
            return
        try:
            with self._sqlite_lock:
                c.execute("INSERT INTO fetches (ts, source, url, status, elapsed, size, blocked, verdict) VALUES (?,?,?,?,?,?,?,?)", (time.time(), source, url[:2000], status, elapsed, size, 1 if blocked else 0, verdict[:200]))
                c.commit()
        except Exception:
            pass

    def _sqlite_log_query(self, actor, query, hits, errors):
        c = self._sqlite_conn()
        if c is None:
            return
        try:
            with self._sqlite_lock:
                c.execute("INSERT INTO queries (ts, actor, query, hits, errors) VALUES (?,?,?,?,?)", (time.time(), str(actor) if actor is not None else "?", query, hits, errors))
                c.commit()
        except Exception:
            pass

    def _sqlite_log_slow(self, actor, query, elapsed, hits):
        c = self._sqlite_conn()
        if c is None:
            return
        try:
            with self._sqlite_lock:
                c.execute("INSERT INTO slow_queries (ts, actor, query, elapsed, hits) VALUES (?,?,?,?,?)", (time.time(), str(actor) if actor is not None else "?", query, elapsed, hits))
                c.commit()
        except Exception:
            pass

    def _sqlite_log_plugin_error(self, plugin, hook, error):
        c = self._sqlite_conn()
        if c is None:
            return
        try:
            with self._sqlite_lock:
                c.execute("INSERT INTO plugin_errors (ts, plugin, hook, error) VALUES (?,?,?,?)", (time.time(), plugin, hook, error[:500]))
                c.commit()
        except Exception:
            pass

    def _sqlite_save_snapshot(self, source, query, url, html_text):
        if not self._cfg_mgr.get("advanced.snapshots_enabled", True):
            return
        c = self._sqlite_conn()
        if c is None:
            return
        try:
            with self._sqlite_lock:
                c.execute("INSERT INTO snapshots (ts, source, query, url, html) VALUES (?,?,?,?,?)", (time.time(), source, query, url, html_text[:500_000]))
                c.commit()
        except Exception:
            pass

    def _semaphore(self):
        limit = int(self._cfg_mgr.get("search.max_parallel", 5) or 5)
        limit = max(1, limit)
        with self._sem_lock:
            if self._sem is None or self._sem_limit != limit:
                self._sem = asyncio.Semaphore(limit)
                self._sem_limit = limit
            return self._sem

    def _prefix(self):
        try:
            return getattr(self.kernel.context, "prefix", ".") or "."
        except Exception:
            return "."

    def _sender_id(self, event):
        s = getattr(event, "sender_id", None)
        if s is None:
            s = getattr(getattr(event, "from_user", None), "id", None)
        try:
            return int(s) if s is not None else None
        except (TypeError, ValueError):
            return None

    def _is_owner(self, event):
        try:
            return bool(self.kernel.context.is_owner(self._sender_id(event)))
        except Exception:
            return False

    def _role_of(self, event):
        if self._is_owner(event):
            return "owner"
        sid = self._sender_id(event)
        if sid is None:
            return None
        r = self._cfg_mgr.get("roles.roles") or {}
        for key, val in (("superadmins", "superadmin"), ("admins", "admin"), ("editors", "editor"), ("verified", "verified"), ("contributors", "contributor"), ("searchers", "searcher"), ("viewers", "viewer"), ("guests", "guest"), ("trusted", "searcher")):
            if sid in (r.get(key) or []):
                return val
        return None

    def _role_of_by_uid(self, uid):
        if uid is None:
            return None
        try:
            if int(self.kernel.context.admin_id) == int(uid):
                return "owner"
        except Exception:
            pass
        r = self._cfg_mgr.get("roles.roles") or {}
        for key, val in (("superadmins", "superadmin"), ("admins", "admin"), ("editors", "editor"), ("verified", "verified"), ("contributors", "contributor"), ("searchers", "searcher"), ("viewers", "viewer"), ("guests", "guest"), ("trusted", "searcher")):
            if uid in (r.get(key) or []):
                return val
        return None

    def _role_gte(self, role, target):
        return ROLE_ORDER.get(role or "", -99) >= ROLE_ORDER.get(target, 99)

    def _is_trusted_uid(self, uid):
        if uid is None:
            return False
        r = self._cfg_mgr.get("roles.roles") or {}
        for k in ("superadmins", "admins", "editors", "verified", "contributors", "searchers", "viewers", "guests", "trusted"):
            if uid in (r.get(k) or []):
                return True
        return False

    def _set_role(self, uid, role):
        r = self._cfg_mgr.get("roles.roles") or {}
        for k in ("superadmins", "admins", "editors", "verified", "contributors", "searchers", "viewers", "guests", "trusted"):
            r[k] = [x for x in (r.get(k) or []) if x != uid]
        mapping = {"superadmin": "superadmins", "admin": "admins", "editor": "editors", "verified": "verified", "contributor": "contributors", "searcher": "searchers", "viewer": "viewers", "guest": "guests", "trusted": "trusted"}
        if role in mapping:
            r.setdefault(mapping[role], []).append(uid)
        self._cfg_mgr.set("roles.roles", r)

    def _remove_role(self, uid):
        r = self._cfg_mgr.get("roles.roles") or {}
        for k in ("superadmins", "admins", "editors", "verified", "contributors", "searchers", "viewers", "guests", "trusted"):
            r[k] = [x for x in (r.get(k) or []) if x != uid]
        self._cfg_mgr.set("roles.roles", r)

    def _is_muted(self, uid):
        m = self._cfg_mgr.get("roles.muted_until") or {}
        until = m.get(str(uid))
        if not until:
            return None
        if until < time.time():
            m.pop(str(uid), None)
            self._cfg_mgr.set("roles.muted_until", m)
            return None
        return until

    def _mute_user(self, uid, seconds):
        m = self._cfg_mgr.get("roles.muted_until") or {}
        m[str(uid)] = time.time() + seconds
        self._cfg_mgr.set("roles.muted_until", m)

    def _unmute_user(self, uid):
        m = self._cfg_mgr.get("roles.muted_until") or {}
        m.pop(str(uid), None)
        self._cfg_mgr.set("roles.muted_until", m)

    def _sites(self):
        data = self._cfg_mgr.get("sites")
        if not isinstance(data, dict):
            data = {}
        if not data and DEFAULT_SITES:
            data = copy.deepcopy(DEFAULT_SITES)
            try:
                self._cfg_mgr.set("sites", data)
            except Exception:
                pass
        return data

    def _save_sites(self, data):
        try:
            self._cfg_mgr.set("sites", data)
        except Exception:
            pass

    def _args(self, event):
        text = (getattr(event, "raw_text", "") or "").strip()
        p = self._prefix()
        if not text.startswith(p):
            return ""
        body = text[len(p):]
        parts = body.split(maxsplit=1)
        return parts[1].strip() if len(parts) > 1 else ""

    def _clean(self, text):
        for rx, repl in PII_REDACTION:
            text = rx.sub(repl, text)
        return text

    def _normalize(self, text):
        return text.lower().replace("ё", "е")

    def _lemmatize(self, text):
        if not self._cfg_mgr.get("search.morphology_enabled", True) or _MORPH is None:
            return self._normalize(text)
        norm = self._normalize(text)
        out = []
        with self._morph_lock:
            for w in self._RX_WORD.findall(norm):
                if len(w) <= 2:
                    out.append(w)
                    continue
                c = self._morph_cache.get(w)
                if c is not None:
                    out.append(c)
                    continue
                try:
                    lemma = _MORPH.parse(w)[0].normal_form
                except Exception:
                    lemma = w
                self._morph_cache[w] = lemma
                out.append(lemma)
                limit = int(self._cfg_mgr.get("advanced.morph_cache_max", 5000) or 5000)
                if len(self._morph_cache) > limit:
                    self._morph_cache = dict(list(self._morph_cache.items())[-limit // 2:])
        return " ".join(out)

    def _region_for_url(self, url):
        try:
            host = urlparse(url).netloc.lower()
        except Exception:
            return "en"
        if host.endswith((".ru", ".рф", ".su", ".by", ".kz")) or "yandex" in host:
            return "ru"
        if host.endswith(".cn") or "baidu" in host:
            return "cn"
        return "en"

    def _pick_ua(self, url):
        pool = USER_AGENTS_BY_REGION.get(self._region_for_url(url), USER_AGENTS_BY_REGION["en"]) if self._cfg_mgr.get("net.region_ua", True) else USER_AGENTS_BY_REGION["en"]
        return random.choice(pool)

    def _is_cloudflare(self, text):
        low = (text or "").lower()
        return any(m in low for m in CLOUDFLARE_MARKERS)

    def _is_captcha(self, text):
        low = (text or "").lower()
        return any(m in low for m in CAPTCHA_MARKERS)

    def _looks_blocked(self, text):
        if not self._cfg_mgr.get("net.blocked_detection", True):
            return False
        return self._is_cloudflare(text) or self._is_captcha(text)

    def _looks_js_required(self, text, raw_html=""):
        if not self._cfg_mgr.get("net.js_detection", True):
            return False
        low = (text or "").lower()
        if any(m in low for m in JS_MARKERS):
            return True
        rl = (raw_html or "").lower()
        if any(m in rl for m in JS_MARKERS):
            return True
        if len((text or "").strip()) < 250 and len(raw_html or "") > 30_000:
            return True
        return False

    def _is_ssrf_safe(self, url):
        if not self._cfg_mgr.get("security.ssrf_enabled", True):
            return True
        try:
            p = urlparse(url)
        except Exception:
            return False
        if p.scheme.lower() not in ("http", "https"):
            return False
        host = (p.hostname or "").lower()
        if not host:
            return False
        if PRIVATE_HOST_PATTERNS.search(host):
            return False
        if host.endswith(".onion"):
            return bool(self._cfg_mgr.get("net.use_tor", False))
        return True

    def _extract_meta(self, raw_html):
        meta = {}
        for name, pattern in (
            ("og_title", r'<meta[^>]+property=["\']og:title["\'][^>]+content=["\']([^"\']+)["\']'),
            ("og_desc", r'<meta[^>]+property=["\']og:description["\'][^>]+content=["\']([^"\']+)["\']'),
            ("og_image", r'<meta[^>]+property=["\']og:image["\'][^>]+content=["\']([^"\']+)["\']'),
            ("author", r'<meta[^>]+name=["\']author["\'][^>]+content=["\']([^"\']+)["\']'),
            ("date", r'<meta[^>]+property=["\']article:published_time["\'][^>]+content=["\']([^"\']+)["\']'),
            ("desc", r'<meta[^>]+name=["\']description["\'][^>]+content=["\']([^"\']+)["\']'),
            ("canonical", r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)["\']'),
        ):
            m = re.search(pattern, raw_html, re.IGNORECASE)
            if m:
                meta[name] = html.unescape(m.group(1).strip())[:300]
        return meta

    def _flatten_json(self, obj, out):
        if isinstance(obj, dict):
            for v in obj.values():
                self._flatten_json(v, out)
        elif isinstance(obj, list):
            for v in obj:
                self._flatten_json(v, out)
        elif isinstance(obj, (str, int, float)):
            s = str(obj)
            if len(s) > 2:
                out.append(s)

    def _extract_embedded_json(self, raw_html):
        out = {}
        for marker, pattern in (
            ("next", r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>'),
            ("nuxt", r'window\.__NUXT__\s*=\s*(\{.*?\});'),
            ("initial_state", r'window\.__INITIAL_STATE__\s*=\s*(\{.*?\});'),
            ("ld_json", r'<script[^>]+type="application/ld\+json"[^>]*>(.*?)</script>'),
        ):
            m = re.search(pattern, raw_html, re.DOTALL | re.IGNORECASE)
            if not m:
                continue
            try:
                out[marker] = json.loads(m.group(1).strip())
            except Exception:
                continue
        return out

    def _json_path(self, obj, path):
        if not path:
            return obj
        cur = obj
        for part in path.split("."):
            if cur is None:
                return None
            if isinstance(cur, list):
                try:
                    i = int(part)
                    cur = cur[i] if -len(cur) <= i < len(cur) else None
                except ValueError:
                    return None
            elif isinstance(cur, dict):
                cur = cur.get(part)
            else:
                return None
        return cur

    def _token_bucket_wait(self, host):
        wait = float(self._cfg_mgr.get("search.rate_limit_seconds", 0.5) or 0.5)
        if wait <= 0:
            return
        with self._rate_lock:
            last = self._rate_limit_map.get(host, 0)
            delta = time.time() - last
            if delta < wait:
                time.sleep(wait - delta)
            self._rate_limit_map[host] = time.time()

    def _user_rate_ok(self, uid, event=None):
        if uid is None:
            return True
        role = self._role_of(event) if event is not None else None
        per_role = (self._cfg_mgr.get("roles.role_rate") or {}).get(role or "", 30)
        limit = int(per_role if per_role is not None else self._cfg_mgr.get("roles.rate_limit_per_user", 30) or 30)
        if limit <= 0:
            return True
        now = time.time()
        with self._rate_lock:
            m = self._cfg_mgr.get("roles.user_rate_map") or {}
            bucket = m.get(str(uid), [])
            bucket = [t for t in bucket if now - t < 60]
            if len(bucket) >= limit:
                m[str(uid)] = bucket
                self._cfg_mgr.set("roles.user_rate_map", m)
                return False
            bucket.append(now)
            m[str(uid)] = bucket
            if len(m) > 500:
                cutoff = now - 3600
                m = {k: v for k, v in m.items() if any(t > cutoff for t in (v or []))}
            self._cfg_mgr.set("roles.user_rate_map", m)
        return True

    def _check_quota_pre(self, uid, action):
        quotas = self._cfg_mgr.get("roles.trusted_quotas") or {}
        per = quotas.get(str(uid))
        if not per:
            return True, None
        key = "daily_searches" if action == "search" else "daily_adds" if action in ("add", "add-api", "add-contrib") else None
        if not key:
            return True, None
        used = self._cfg_mgr.get("roles.quota_used") or {}
        today = time.strftime("%Y-%m-%d")
        bucket = used.get(str(uid)) or {}
        if bucket.get("date") != today:
            bucket = {"date": today, "counts": {}}
        counts = bucket.get("counts") or {}
        limit = int(per.get(key, 999999))
        cur = int(counts.get(key, 0))
        if cur >= limit:
            self._emit_event("quota.exceeded", {"uid": uid, "key": key})
            return False, key
        return True, key

    def _check_quota_commit(self, uid, key):
        if not key:
            return
        used = self._cfg_mgr.get("roles.quota_used") or {}
        today = time.strftime("%Y-%m-%d")
        bucket = used.get(str(uid)) or {}
        if bucket.get("date") != today:
            bucket = {"date": today, "counts": {}}
        counts = bucket.get("counts") or {}
        counts[key] = int(counts.get(key, 0)) + 1
        bucket["counts"] = counts
        used[str(uid)] = bucket
        if len(used) > 500:
            used = {k: v for k, v in used.items() if v.get("date") == today}
        self._cfg_mgr.set("roles.quota_used", used)

    def _chat_allowed(self, event):
        allowed = self._cfg_mgr.get("security.allowed_chats") or []
        if not allowed:
            return True
        try:
            return event.chat_id in allowed
        except Exception:
            return True

    def _user_blocked(self, event):
        blocked = self._cfg_mgr.get("security.blocked_users") or []
        return self._sender_id(event) in blocked

    def _query_forbidden(self, query):
        bl = self._cfg_mgr.get("security.blocked_queries") or []
        low = self._normalize(query)
        for w in bl:
            try:
                if re.search(w, low):
                    return True
            except Exception:
                if self._normalize(w) in low:
                    return True
        return False

    def _proxies(self):
        if self._cfg_mgr.get("net.use_tor", False):
            p = self._cfg_mgr.get("net.tor_proxy")
            return {"http": p, "https": p}
        pool = self._cfg_mgr.get("net.proxies") or []
        if pool:
            p = random.choice(pool)
            return {"http": p, "https": p}
        return None

    def _cookie_for(self, domain):
        if not self._cfg_mgr.get("net.cookies_enabled", True):
            return None
        e = self._cookie_jar.get(domain)
        if not e:
            return None
        if e.get("expires", 0) < time.time():
            self._cookie_jar.pop(domain, None)
            return None
        return e

    def _save_cookie(self, domain, cookie, ua, proxy):
        if not self._cfg_mgr.get("net.cookies_enabled", True):
            return
        self._cookie_jar[domain] = {"cookie": cookie, "ua": ua, "proxy": proxy or "", "expires": time.time() + 3600 * 6}
        limit = int(self._cfg_mgr.get("net.cookie_jar_max", 500) or 500)
        if len(self._cookie_jar) > limit:
            items = sorted(self._cookie_jar.items(), key=lambda kv: kv[1].get("expires", 0))
            for k, _ in items[: len(items) // 2]:
                self._cookie_jar.pop(k, None)

    async def _http_request(self, url, headers=None, timeout=None):
        if not self._is_ssrf_safe(url):
            raise ValueError("unsafe url: %s" % url[:100])
        ua = self._pick_ua(url)
        try:
            domain = urlparse(url).netloc.lower()
        except Exception:
            domain = ""
        cookie_header = None
        if domain:
            ck = self._cookie_for(domain)
            if ck:
                cookie_header = ck.get("cookie")
                if ck.get("ua"):
                    ua = ck["ua"]
        h = {"User-Agent": ua, "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "ru,en-US;q=0.8,en;q=0.7", "Cache-Control": "no-cache", "Sec-Fetch-Dest": "document", "Sec-Fetch-Mode": "navigate", "Sec-Fetch-Site": "none", "Upgrade-Insecure-Requests": "1"}
        if cookie_header:
            h["Cookie"] = cookie_header
        if headers:
            h.update(headers)
        t = timeout or float(self._cfg_mgr.get("search.timeout", 12) or 12)
        max_bytes = int(self._cfg_mgr.get("search.max_bytes", 500000) or 500000)
        proxies = self._proxies()
        if _HAS_CURL and self._cfg_mgr.get("net.use_curl_cffi", True) and not proxies:
            try:
                async with _CurlSession() as session:
                    r = await session.get(url, headers=h, timeout=t, impersonate="chrome", allow_redirects=True)
                    try:
                        fu = str(getattr(r, "url", "") or "")
                        if fu and not self._is_ssrf_safe(fu):
                            raise ValueError("unsafe redirect")
                    except ValueError:
                        raise
                    except Exception:
                        pass
                    try:
                        sc = r.cookies
                        if sc:
                            ck_str = "; ".join("%s=%s" % (k, v) for k, v in sc.items())
                            if "cf_clearance" in ck_str.lower() and domain:
                                self._save_cookie(domain, ck_str, ua, None)
                    except Exception:
                        pass
                    return (r.text or "")[:max_bytes], r.status_code, _ddt_headers_dict(r)
            except ValueError:
                raise
            except Exception:
                pass
        if _HAS_HTTPX:
            try:
                proxy_arg = proxies.get("http") if proxies else None
                kwargs = {"http2": True, "timeout": t, "follow_redirects": True, "headers": h}
                if proxy_arg:
                    kwargs["proxy"] = proxy_arg
                try:
                    async with httpx.AsyncClient(**kwargs) as client:
                        r = await client.get(url)
                        if not self._is_ssrf_safe(str(r.url)):
                            raise ValueError("unsafe redirect")
                        return (r.text or "")[:max_bytes], r.status_code, _ddt_headers_dict(r), _ddt_headers_dict(r)
                except TypeError:
                    kwargs.pop("proxy", None)
                    if proxy_arg:
                        kwargs["proxies"] = proxy_arg
                    async with httpx.AsyncClient(**kwargs) as client:
                        r = await client.get(url)
                        if not self._is_ssrf_safe(str(r.url)):
                            raise ValueError("unsafe redirect")
                        return (r.text or "")[:max_bytes], r.status_code, _ddt_headers_dict(r), _ddt_headers_dict(r)
            except ValueError:
                raise
            except Exception:
                pass

        def _sync():
            req = Request(url, headers=h)
            opener = build_opener(ProxyHandler(proxies)) if proxies else build_opener()
            with opener.open(req, timeout=t) as resp:
                fu = resp.geturl()
                raw = resp.read(max_bytes)
                cs = resp.headers.get_content_charset() or "utf-8"
                try:
                    text = raw.decode(cs, errors="ignore")
                except LookupError:
                    text = raw.decode("utf-8", errors="ignore")
                return text, resp.status, fu

        text, status, fu = await asyncio.to_thread(_sync)
        if fu and not self._is_ssrf_safe(fu):
            raise ValueError("unsafe redirect")
        return text, status

    async def _fetch_async(self, url):
        started = time.time()
        r = await self._http_request(url)
        text, status = r[0], r[1]
        return text, status, round(time.time() - started, 2)

    async def _fetch_json(self, url):
        _r = await self._http_request(url, headers={"Accept": "application/json"})
        text, status = _r[0], _r[1]
        try:
            return json.loads(text), status
        except Exception:
            return None, status

    async def _fetch_with_jina(self, url, fmt="markdown"):
        if "jina" in self._dead_services:
            return ""
        jina_url = "https://r.jina.ai/" + url
        headers = {}
        if fmt == "text":
            headers["X-Return-Format"] = "text"
        elif fmt == "html":
            headers["X-Return-Format"] = "html"
        try:
            text, _ = await self._http_request(jina_url, headers=headers)
            if not text:
                self._dead_services.add("jina")
            return text
        except Exception:
            self._dead_services.add("jina")
            return ""

    def _ping(self, url):
        try:
            req = Request(url, headers={"User-Agent": self._pick_ua(url)})
            with urlopen(req, timeout=8) as r:
                body = r.read(65536)
                cs = r.headers.get_content_charset() or "utf-8"
                try:
                    text = body.decode(cs, errors="ignore")
                except LookupError:
                    text = body.decode("utf-8", errors="ignore")
                return not self._looks_blocked(text)
        except Exception:
            return False

    def _readability_extract(self, raw_html):
        if not self._cfg_mgr.get("search.readability_enabled", True):
            return None
        try:
            h = re.sub(r"(?is)<(script|style|nav|footer|header|aside|form).*?</\1>", " ", raw_html)
            blocks = re.findall(r"(?is)<(article|main|section|div|p)[^>]*>(.*?)</\1>", h)
            scored = []
            for tag, content in blocks:
                txt = re.sub(r"(?s)<[^>]+>", " ", content)
                txt = html.unescape(txt)
                txt = re.sub(r"\s+", " ", txt).strip()
                if len(txt) < 100:
                    continue
                links = len(re.findall(r"(?i)<a\s", content))
                ps = len(re.findall(r"(?i)<p[\s>]", content))
                score = len(txt) - links * 30 + ps * 10
                if tag in ("article", "main"):
                    score += 200
                scored.append((score, txt))
            if not scored:
                return None
            scored.sort(key=lambda x: -x[0])
            return " ".join(t for _, t in scored[:5])[:8000]
        except Exception:
            return None

    def _extract_title_fallback(self, html_raw, url, meta):
        for rx in (self._RX_OG_TITLE, self._RX_TW_TITLE):
            try:
                m = rx.search(html_raw)
                if m:
                    t = html.unescape(re.sub(r"\s+", " ", m.group(1))).strip()
                    if t:
                        return t
            except Exception:
                continue
        try:
            m = self._RX_TITLE.search(html_raw)
            if m:
                t = html.unescape(re.sub(r"<[^>]+>", " ", m.group(1))).strip()
                if t:
                    return t
        except Exception:
            pass
        try:
            m = self._RX_H1.search(html_raw)
            if m:
                t = html.unescape(re.sub(r"<[^>]+>", " ", m.group(1))).strip()
                if t:
                    return t
        except Exception:
            pass
        if meta.get("og_title"):
            return meta["og_title"]
        try:
            p = urlparse(url)
            path = p.path.strip("/")
            if path:
                last = path.split("/")[-1]
                last = re.sub(r"\.(?:html?|php|aspx?|jsp)$", "", last, flags=re.IGNORECASE)
                last = unquote(last).replace("_", " ").replace("-", " ").strip()
                if len(last) >= 3:
                    return last
            return p.netloc
        except Exception:
            return ""

    def _extract(self, source, base_url):
        raw = source
        readable = self._readability_extract(raw)
        source = re.sub(r"(?is)<script.*?</script>", " ", source)
        source = re.sub(r"(?is)<style.*?</style>", " ", source)
        source = re.sub(r"(?is)<noscript.*?</noscript>", " ", source)
        title = ""
        tm = re.search(r"(?is)<title[^>]*>(.*?)</title>", source)
        if tm:
            title = re.sub(r"<[^>]+>", " ", tm.group(1))
            title = html.unescape(title).strip()
        meta = self._extract_meta(raw)
        if not title:
            title = self._extract_title_fallback(raw, base_url, meta)
        text = re.sub(r"(?s)<[^>]+>", " ", source)
        text = html.unescape(text)
        text = re.sub(r"\s+", " ", text).strip()
        text = self._clean(text)
        if readable and len(readable) > len(text) * 0.4:
            text = readable + " || " + text[:3000]
        embedded = self._extract_embedded_json(raw)
        if embedded and len(text) < 500:
            extra = []
            for obj in embedded.values():
                self._flatten_json(obj, extra)
            if extra:
                text = text + " || " + " ".join(extra[:200])
        links = []
        for href in re.findall(r'''(?is)<a[^>]+href=["']([^"']+)["']''', source):
            try:
                full = urljoin(base_url, href)
                if urlparse(full).scheme in ("http", "https"):
                    links.append(full)
            except Exception:
                pass
        files = [l for l in links if re.search(r"\.(pdf|docx?|xlsx?|zip|rar|7z|txt|csv|json)$", l, re.I)]
        images = re.findall(r'''(?is)<img[^>]+src=["']([^"']+)["']''', source)
        images = [urljoin(base_url, i) for i in images[:20] if not i.startswith("data:")]
        links = list(dict.fromkeys(links))
        max_links = int(self._cfg_mgr.get("search.max_links", 50) or 50)
        return title, text, links[:max_links], files[:10], images[:10], meta

    def _build_url(self, site, query):
        template = site["url"]
        if "{query}" in template:
            return template.replace("{query}", quote_plus(query))
        param = site.get("param") or self._autodetect_param(template) or self._cfg_mgr.get("search.default_param", "q")
        sep = "&" if "?" in template else "?"
        return "%s%s%s=%s" % (template, sep, param, quote_plus(query))

    def _autodetect_param(self, url):
        try:
            qs = urlparse(url).query
        except Exception:
            return None
        preferred = ("q", "query", "text", "search", "s", "keyword", "k", "wd", "word", "term", "find")
        for key in preferred:
            for pair in qs.split("&"):
                if "=" in pair:
                    k = pair.split("=", 1)[0]
                    if k == key:
                        return key
        return None

    def _apply_site_override(self, name, site):
        if not self._cfg_mgr.get("net.site_overrides", True):
            return site
        host = (site.get("host") or "").lower()
        for h, ov in SITE_URL_OVERRIDES.items():
            if h in host or host in h:
                ns = dict(site)
                ns["url"] = ov["url"]
                ns["param"] = ov.get("param", "q")
                ns["_override_note"] = ov.get("note", "")
                return ns
        return site

    def _highlight(self, escaped_text, query):
        if not self._cfg_mgr.get("search.highlight_matches", True):
            return escaped_text
        if not escaped_text or not query:
            return escaped_text
        words = [w for w in self._RX_WORD.findall(self._normalize(query)) if len(w) > 1]
        if not words:
            return escaped_text
        pattern = r"(?<![\w])(?:" + "|".join(re.escape(html.escape(w)) for w in sorted(set(words), key=len, reverse=True)) + r")(?![\w])"
        try:
            return re.sub(pattern, lambda m: "<b>%s</b>" % m.group(0), escaped_text, flags=re.IGNORECASE | re.UNICODE)
        except Exception:
            return escaped_text

    def _safe_truncate(self, text, limit):
        if len(text) <= limit:
            return text
        cut = text[:limit]
        for tag in ("<b>", "</b>", "<i>", "</i>", "<code>", "</code>", "<pre>", "</pre>", "<blockquote>", "</blockquote>", "<u>", "</u>", "<s>", "</s>", "<tg-spoiler>", "</tg-spoiler>"):
            if cut.count(tag) % 2 != 0:
                cut = cut.rsplit(tag, 1)[0]
        return cut

    def _context_snippet(self, text, query, window=200, max_snippets=2):
        norm = self._lemmatize(text)
        words = [w for w in self._lemmatize(query).split() if len(w) > 1]
        if not words:
            return text[:700]
        positions = []
        for w in words:
            for m in re.finditer(re.escape(w), norm):
                positions.append(m.start())
                if len(positions) > 30:
                    break
        if not positions:
            return text[:700]
        positions.sort()
        snippets = []
        used_end = -1
        for pos in positions:
            if pos < used_end:
                continue
            start = max(0, pos - window)
            end = min(len(text), pos + window * 2)
            s = text[start:end].strip()
            for sw in STOPWORDS:
                s = re.sub(re.escape(sw), "", s, flags=re.IGNORECASE)
            snippets.append(s)
            used_end = end
            if len(snippets) >= max_snippets:
                break
        return " ... ".join(snippets) if snippets else text[:700]

    def _bm25_score(self, result, query, all_results, site):
        q_lemma = self._lemmatize(query)
        words = [w for w in q_lemma.split() if len(w) > 1]
        if not words:
            return 0.0
        text = self._lemmatize(result.get("snippet", ""))
        dl = len(text.split()) or 1
        lens = [len(self._lemmatize(r.get("snippet", "")).split()) for r in all_results]
        avgdl = max(1, sum(lens) / max(len(lens), 1))
        k1 = float(self._cfg_mgr.get("search.bm25_k1", 1.5) or 1.5)
        b = float(self._cfg_mgr.get("search.bm25_b", 0.75) or 0.75)
        N = max(1, len(all_results))
        score = 0.0
        for w in words:
            tf = text.count(w)
            if tf == 0:
                continue
            df = sum(1 for r in all_results if w in self._lemmatize(r.get("snippet", "")))
            idf = max(0.0, (N - df + 0.5) / (df + 0.5))
            idf = math.log(idf + 1) if idf > 0 else 0.0
            score += idf * (tf * (k1 + 1)) / (tf + k1 * (1 - b + b * dl / avgdl))
        priority_bonus = {"high": 0.3, "normal": 0.0, "low": -0.2}.get(site.get("priority", "normal"), 0.0)
        links_bonus = min(result.get("total_links", 0) / 100, 0.2)
        weight = float(site.get("weight", self._cfg_mgr.get("search.source_weight_default", 1.0)) or 1.0)
        return (score + priority_bonus + links_bonus) * weight

    def _parse_bool_ast(self, query):
        tokens = self._RX_TOKEN.findall(query)
        if not tokens:
            return None
        pos = [0]
        def peek():
            return tokens[pos[0]] if pos[0] < len(tokens) else None
        def consume():
            t = peek(); pos[0] += 1; return t
        def parse_or():
            left = parse_and()
            while peek() and peek().upper() == "OR":
                consume(); right = parse_and(); left = ("OR", left, right)
            return left
        def parse_and():
            left = parse_not()
            while True:
                nxt = peek()
                if nxt is None or nxt.upper() == "OR" or nxt == ")":
                    break
                if nxt.upper() == "AND":
                    consume()
                right = parse_not()
                left = ("AND", left, right)
            return left
        def parse_not():
            if peek() and peek().upper() == "NOT":
                consume(); return ("NOT", parse_not())
            return parse_atom()
        def parse_atom():
            t = peek()
            if t is None:
                return ("LEAF", "")
            if t == "(":
                consume(); node = parse_or()
                if peek() == ")":
                    consume()
                return node
            consume()
            if t.startswith('"') and t.endswith('"'):
                return ("LEAF", t[1:-1])
            if t.startswith("+"):
                return ("LEAF", t[1:])
            if t.startswith("-"):
                return ("NOT", ("LEAF", t[1:]))
            return ("LEAF", t)
        try:
            return parse_or()
        except Exception:
            return None

    def _eval_bool_ast(self, node, text):
        if node is None:
            return True
        op = node[0]
        if op == "LEAF":
            w = self._lemmatize(node[1])
            if not w:
                return True
            txt = self._lemmatize(text)
            for part in w.split():
                if part and part not in txt:
                    return False
            return True
        if op == "AND":
            return self._eval_bool_ast(node[1], text) and self._eval_bool_ast(node[2], text)
        if op == "OR":
            return self._eval_bool_ast(node[1], text) or self._eval_bool_ast(node[2], text)
        if op == "NOT":
            return not self._eval_bool_ast(node[1], text)
        return True

    def _parse_boolean(self, query):
        ops = {"include": [], "exclude": [], "site": None, "filetype": None, "intitle": None, "phrase": None, "wildcards": [], "fuzzy": [], "ast": None}
        if not self._cfg_mgr.get("search.operators_enabled", True):
            return query, ops
        phrase_m = self._RX_QUOTED.search(query)
        if phrase_m:
            ops["phrase"] = phrase_m.group(1)
            query = self._RX_QUOTED.sub(" ", query, count=1).strip()
        for m in re.finditer(r'(?:^|\s)(site|filetype|intitle):(\S+)', query):
            ops[m.group(1)] = m.group(2)
            query = query.replace(m.group(0), " ")
        wildcards = self._RX_WILDCARD.findall(query)
        if wildcards:
            ops["wildcards"] = wildcards
        fuzzy = self._RX_FUZZY.findall(query)
        if fuzzy:
            ops["fuzzy"] = fuzzy
        if self._cfg_mgr.get("search.boolean_operators_enabled", True):
            ast = self._parse_bool_ast(query)
            if ast is not None:
                ops["ast"] = ast
        tokens = query.split()
        cleaned = []
        for t in tokens:
            if t.startswith("+") and len(t) > 1:
                ops["include"].append(t[1:])
            elif t.startswith("-") and len(t) > 1:
                ops["exclude"].append(t[1:])
            elif t.startswith("~") and len(t) > 1:
                continue
            elif t.endswith("*") and len(t) > 1:
                continue
            elif t.upper() in ("AND", "OR", "NOT"):
                continue
            else:
                cleaned.append(t)
        return " ".join(cleaned).strip(), ops

    def _apply_synonyms(self, query):
        syn = self._cfg_mgr.get("advanced.synonyms") or {}
        if not syn:
            return query
        out = [query]
        for w in self._RX_WORD.findall(query):
            for k, vals in syn.items():
                if w.lower() == k.lower() and isinstance(vals, list):
                    out.extend(vals)
        return " ".join(dict.fromkeys(out))

    def _apply_wildcards(self, results, wildcards):
        if not wildcards:
            return results
        out = []
        for r in results:
            txt = self._lemmatize((r.get("snippet") or "") + " " + (r.get("title") or ""))
            ok = True
            for wc in wildcards:
                parts = self._lemmatize(wc).split()
                if not parts:
                    continue
                p = parts[0][:max(2, len(parts[0]) - 1)]
                if not any(w.startswith(p) for w in txt.split()):
                    ok = False
                    break
            if ok:
                out.append(r)
        return out

    def _apply_fuzzy(self, results, fuzzy):
        if not fuzzy:
            return results
        out = []
        for r in results:
            txt = self._lemmatize((r.get("snippet") or "") + " " + (r.get("title") or ""))
            words = set(txt.split())
            ok = True
            for fw in fuzzy:
                fl = self._lemmatize(fw)
                found = False
                for w in words:
                    if abs(len(w) - len(fl)) > 2:
                        continue
                    if difflib.SequenceMatcher(None, w, fl).ratio() >= 0.8:
                        found = True
                        break
                if not found:
                    ok = False
                    break
            if ok:
                out.append(r)
        return out

    def _apply_operators_filter(self, results, ops):
        filtered = []
        for r in results:
            if ops["site"] and ops["site"].lower() not in r.get("url", "").lower():
                continue
            if ops["filetype"]:
                exts = [e.strip().lstrip(".").lower() for e in ops["filetype"].split(",") if e.strip()]
                if exts:
                    hit = False
                    for ext in exts:
                        dot = "." + ext
                        if any(dot in (f or "").lower() for f in r.get("files", [])) or dot in (r.get("url") or "").lower():
                            hit = True
                            break
                    if not hit:
                        continue
            if ops["intitle"] and ops["intitle"].lower() not in (r.get("title") or "").lower():
                continue
            txt = self._lemmatize((r.get("snippet") or "") + " " + (r.get("title") or ""))
            if ops["phrase"] and self._lemmatize(ops["phrase"]) not in txt:
                continue
            if any(self._lemmatize(w) not in txt for w in ops["include"]):
                continue
            if any(self._lemmatize(w) in txt for w in ops["exclude"]):
                continue
            if ops.get("ast") is not None and not self._eval_bool_ast(ops["ast"], txt):
                continue
            filtered.append(r)
        filtered = self._apply_wildcards(filtered, ops.get("wildcards") or [])
        filtered = self._apply_fuzzy(filtered, ops.get("fuzzy") or [])
        return filtered

    def _dedup_difflib(self, results):
        thr = float(self._cfg_mgr.get("search.dedup_threshold", 0.85) or 0.85)
        out = []
        for r in sorted(results, key=lambda x: -len(x.get("snippet") or "")):
            dup = False
            r_len = len(r.get("snippet") or "")
            for o in out:
                o_len = len(o.get("snippet") or "")
                if o_len and abs(r_len - o_len) / max(r_len, o_len, 1) > 0.5:
                    continue
                if difflib.SequenceMatcher(None, r.get("snippet", "")[:400], o.get("snippet", "")[:400]).ratio() >= thr:
                    dup = True
                    break
            if not dup:
                out.append(r)
        return out

    def _extract_entities(self, text):
        if not self._cfg_mgr.get("search.entities_enabled", True):
            return {}
        found = {}
        for name, rx in ENTITY_PATTERNS.items():
            matches = list(dict.fromkeys(rx.findall(text)))
            if matches:
                found[name] = matches[:10]
        return found

    def _cache_key(self, query, actor=None, chat_id=None):
        payload = query
        if actor is not None:
            payload = "%s|%s" % (actor, payload)
        if chat_id is not None:
            payload = "%s|%s" % (chat_id, payload)
        return hashlib.sha1(payload.encode("utf-8", errors="ignore")).hexdigest()

    def _cache_get(self, query, actor=None, chat_id=None):
        ttl = int(self._cfg_mgr.get("search.cache_ttl", 300) or 300)
        if ttl <= 0:
            return None
        k = self._cache_key(query, actor, chat_id)
        e = self._cache.get(k)
        if not e:
            self._emit_event("cache.miss", {"query": query})
            return None
        if time.time() - e["ts"] > ttl:
            del self._cache[k]
            self._emit_event("cache.miss", {"query": query})
            return None
        self._emit_event("cache.hit", {"query": query})
        return e["data"]

    def _cache_set(self, query, data, actor=None, chat_id=None):
        ttl = int(self._cfg_mgr.get("search.cache_ttl", 300) or 300)
        if ttl <= 0:
            return
        self._cache[self._cache_key(query, actor, chat_id)] = {"ts": time.time(), "data": data}
        if len(self._cache) > 1000:
            now = time.time()
            self._cache = {k: v for k, v in self._cache.items() if now - v["ts"] < ttl * 2}
            if len(self._cache) > 1000:
                items = sorted(self._cache.items(), key=lambda kv: kv[1]["ts"])
                for k, _ in items[: len(items) // 2]:
                    self._cache.pop(k, None)

    def _unwrap_ddg(self, url):
        if not url:
            return url
        m = self._RX_DDG_REDIRECT.match(url)
        if not m:
            m = self._RX_DDG_REDIRECT_INLINE.search(url)
        if not m:
            return url
        try:
            return unquote(m.group(1))
        except Exception:
            return url

    def _parse_flags(self, tail):
        flags = {}
        for m in self._RX_FLAG.finditer(tail):
            key = m.group(1)
            val = m.group(2) or m.group(3) or m.group(4)
            if val is None:
                val = True
            flags[key] = val
        cleaned = self._RX_FLAG.sub("", tail).strip()
        return cleaned, flags

    def _extract_url_from_text(self, text):
        if not text:
            return ""
        m = self._RX_URL.search(text)
        if m:
            url = m.group(0)
        else:
            bm = self._RX_BARE_URL.search(text)
            url = "https://" + bm.group(1) if bm else text.strip()
        url = url.rstrip(".,;:!?")
        if len(url) >= 2 and url[0] in "<([{" and url[-1] in ">)]}":
            pairs = {"<": ">", "(": ")", "[": "]", "{": "}"}
            if pairs.get(url[0]) == url[-1]:
                url = url[1:-1].strip()
        return url

    async def _search_site(self, name, site, query, deep=False):
        if site.get("disabled"):
            return {"__skipped__": name}
        site = self._apply_site_override(name, site)
        if site.get("type") == "api":
            return await self._search_api_site(name, site, query)
        url = self._build_url(site, query)
        sem = self._semaphore()
        try:
            self._token_bucket_wait(urlparse(url).netloc)
        except Exception:
            pass
        ctx = {"url": url, "site": site, "name": name, "query": query}
        pre = await self._run_hook("before_fetch", ctx)
        if pre is False:
            return {"__error__": name, "error": "blocked by plugin"}
        if isinstance(pre, str):
            url = pre
        async with sem:
            try:
                page, status, elapsed = await self._fetch_async(url)
            except Exception as e:
                hr = await self._run_hook("on_error", {"url": url, "error": str(e), "site": site, "name": name, "query": query})
                if isinstance(hr, str):
                    page, status, elapsed = hr, 200, 0.0
                else:
                    self._stats["per_source_fail"][name] = self._stats["per_source_fail"].get(name, 0) + 1
                    return {"__error__": name, "error": str(e)[:200]}
        post = await self._run_hook("after_fetch", {"url": url, "html": page, "status": status, "site": site, "name": name, "query": query})
        if isinstance(post, str):
            page = post
        if post is False:
            self._stats["per_source_fail"][name] = self._stats["per_source_fail"].get(name, 0) + 1
            return {"__error__": name, "error": "blocked by plugin (after_fetch)"}
        bypass_info = None
        fallback_used = None
        if self._is_cloudflare(page):
            hr = await self._run_hook("on_blocked", {"url": url, "html": page, "reason": "cloudflare", "site": site, "name": name, "query": query})
            if isinstance(hr, str) and hr:
                page = hr
                bypass_info = "plugin:cloudflare"
            else:
                self._sqlite_log_fetch(name, url, status, elapsed, len(page), True, "cloudflare")
                self._stats["per_source_fail"][name] = self._stats["per_source_fail"].get(name, 0) + 1
                return {"__error__": name, "error": "cloudflare"}
        elif self._is_captcha(page):
            hr = await self._run_hook("on_blocked", {"url": url, "html": page, "reason": "captcha", "site": site, "name": name, "query": query})
            if isinstance(hr, str) and hr:
                page = hr
                bypass_info = "plugin:captcha"
            else:
                self._sqlite_log_fetch(name, url, status, elapsed, len(page), True, "captcha")
                self._stats["per_source_fail"][name] = self._stats["per_source_fail"].get(name, 0) + 1
                return {"__error__": name, "error": "captcha"}
        title, text, links, files, images, meta = self._extract(page, url)
        if self._looks_js_required(text, page):
            hr = await self._run_hook("on_js_required", {"url": url, "html": page, "site": site, "name": name, "query": query})
            if isinstance(hr, str) and hr:
                jt, jtx, jl, jf, ji, jm = self._extract(hr, url)
                if jtx and len(jtx) > len(text):
                    title, text, links, files, images, meta = jt or title, jtx, jl or links, jf or files, ji or images, jm or meta
                    bypass_info = (bypass_info or "") + "|plugin:js"
            elif self._cfg_mgr.get("net.use_jina", True):
                jp = await self._fetch_with_jina(url)
                if jp:
                    jt, jtx, jl, jf, ji, jm = self._extract(jp, url)
                    if jtx and len(jtx) > len(text):
                        title, text, links, files, images, meta = jt or title, jtx, jl or links, jf or files, ji or images, jm or meta
        if not self._is_cloudflare(page) and not self._is_captcha(page):
            self._stats["per_source_fail"][name] = 0
        norm_text = self._lemmatize(text)
        words = [w for w in self._lemmatize(query).split() if len(w) > 1]
        matches = sum(1 for w in words if w in norm_text)
        matching_links = links[:8] if matches > 0 else [l for l in links if any(w in l.lower() for w in words)][:8]
        snippet_len = int(self._cfg_mgr.get("search.max_snippet", 1200) or 1200)
        snippet = self._context_snippet(text[:snippet_len * 2], query)[:snippet_len]
        if self._cfg_mgr.get("security.pii_filter_in_snippet", False):
            snippet = self._clean(snippet)
        snippet_esc = html.escape(snippet)
        snippet_hl = self._highlight(snippet_esc, query)
        self._sqlite_log_fetch(name, url, status, elapsed, len(page), False, bypass_info or fallback_used or "ok")
        lat = self._stats["latency"].setdefault(name, [])
        lat.append(elapsed)
        limit_lat = int(self._cfg_mgr.get("search.latency_max_entries", 200) or 200)
        if len(lat) > limit_lat:
            self._stats["latency"][name] = lat[-100:]
        if deep and self._cfg_mgr.get("advanced.snapshots_enabled", True):
            self._sqlite_save_snapshot(name, query, url, page)
        result = {"name": name, "url": url, "title": title or "untitled page", "snippet": snippet, "snippet_esc": snippet_esc, "snippet_hl": snippet_hl, "links": [self._unwrap_ddg(l) for l in matching_links], "files": [self._unwrap_ddg(f) for f in files], "images": images, "matches": matches, "total_links": len(links), "status": status, "elapsed": elapsed, "bypass": bypass_info, "fallback": fallback_used, "override": site.get("_override_note"), "tags": site.get("tags") or [], "priority": site.get("priority") or "normal", "entities": self._extract_entities(text), "meta": meta}
        await self._run_hook("on_result", {"result": result, "url": url, "query": query})
        return result

    async def _search_api_site(self, name, site, query):
        url = self._build_url(site, query)
        try:
            data, status = await self._fetch_json(url)
        except Exception as e:
            return {"__error__": name, "error": str(e)[:200]}
        if data is None:
            return {"__error__": name, "error": "invalid json"}
        special = site.get("special")
        items = []
        if special == "opensearch":
            if isinstance(data, list) and len(data) >= 4:
                titles = data[1] or []
                descs = data[2] or []
                urls = data[3] or []
                for i in range(min(len(titles), len(urls))):
                    items.append({"title": titles[i], "url": urls[i], "desc": descs[i] if i < len(descs) else ""})
        else:
            raw = self._json_path(data, site.get("path"))
            if isinstance(raw, dict):
                raw = [raw]
            if not isinstance(raw, list):
                raw = []
            tf = site.get("title_field")
            uf = site.get("url_field")
            df = site.get("desc_field")
            for it in raw[:30]:
                t = self._json_path(it, tf) if tf else None
                l = self._json_path(it, uf) if uf else None
                d = self._json_path(it, df) if df else ""
                if not l and not t:
                    continue
                items.append({"title": str(t or "untitled"), "url": str(l or site.get("host", "")), "desc": str(d or "")[:300]})
        text = " ".join("%s — %s" % (it["title"], it["desc"]) for it in items)
        words = [w for w in self._lemmatize(query).split() if len(w) > 1]
        norm = self._lemmatize(text)
        matches = sum(1 for w in words if w in norm)
        snippet_len = int(self._cfg_mgr.get("search.max_snippet", 1200) or 1200)
        snippet = self._context_snippet(text[:snippet_len * 2], query)[:snippet_len]
        snippet_esc = html.escape(snippet)
        return {"name": name, "url": url, "title": "%s (api)" % name, "snippet": snippet, "snippet_esc": snippet_esc, "snippet_hl": self._highlight(snippet_esc, query), "links": [it["url"] for it in items[:8]], "files": [], "images": [], "matches": matches, "total_links": len(items), "status": status or 0, "elapsed": 0.0, "bypass": "api", "tags": site.get("tags") or [], "priority": site.get("priority") or "normal", "entities": {}}

    async def _search_everywhere(self, query, tag=None, mode="normal", actor=None, chat_id=None):
        started_at = time.time()
        cache_suffix = "|%s|%s" % (tag or "", mode)
        cached = self._cache_get(query + cache_suffix, actor=actor)
        if cached is not None:
            return cached, []
        op_query, ops = self._parse_boolean(query)
        syn_query = self._apply_synonyms(op_query) if op_query else op_query
        sites = self._sites()
        if tag:
            sites = {n: s for n, s in sites.items() if tag in (s.get("tags") or [])}
        sites = {n: s for n, s in sites.items() if not s.get("disabled")}
        if not sites:
            return [], []
        deep = mode == "deep"
        if mode == "fast":
            fast = {n: s for n, s in sites.items() if s.get("priority") == "high"}
            if fast:
                sites = fast
        tasks = [self._search_site(n, s, syn_query or query, deep=deep) for n, s in sites.items()]
        raw = await asyncio.gather(*tasks, return_exceptions=True)
        ok = []
        err = []
        seen = set()
        for item in raw:
            if isinstance(item, dict) and "__skipped__" in item:
                continue
            if isinstance(item, dict) and "__error__" in item:
                err.append(item)
            elif isinstance(item, dict):
                ul = []
                for l in item["links"]:
                    if l not in seen:
                        seen.add(l)
                        ul.append(l)
                item["links"] = ul
                ok.append(item)
            elif isinstance(item, BaseException):
                err.append({"__error__": "?", "error": str(item)[:200]})
        ok = self._apply_operators_filter(ok, ops)
        ok = self._dedup_difflib(ok)
        for r in ok:
            r["score"] = self._bm25_score(r, syn_query or query, ok, sites.get(r["name"], {}))
        ok.sort(key=lambda r: r.get("score", 0), reverse=True)
        self._cache_set(query + cache_suffix, ok, actor=actor)
        self._stats["total_queries"] += 1
        self._stats["total_sources_hit"] += len(ok)
        self._stats["top_queries"][query] = self._stats["top_queries"].get(query, 0) + 1
        for r in ok:
            self._stats["per_source"][r["name"]] = self._stats["per_source"].get(r["name"], 0) + 1
        if actor is not None:
            self._stats["per_user"][str(actor)] = self._stats["per_user"].get(str(actor), 0) + 1
        elapsed_total = time.time() - started_at
        if elapsed_total > float(self._cfg_mgr.get("search.slow_query_threshold", 5.0) or 5.0):
            self._stats["slow_queries"].append({"ts": time.time(), "query": query, "elapsed": round(elapsed_total, 2), "hits": len(ok)})
            if len(self._stats["slow_queries"]) > 100:
                self._stats["slow_queries"] = self._stats["slow_queries"][-100:]
            self._sqlite_log_slow(actor, query, elapsed_total, len(ok))
        self._last_result = {"query": query, "ok": ok, "err": err, "ts": time.time()}
        self._history.append({"query": query, "ts": time.time(), "hits": len(ok), "errors": len(err), "actor": str(actor) if actor else "?"})
        hs = int(self._cfg_mgr.get("search.history_size", 50) or 50)
        if len(self._history) > hs:
            self._history = self._history[-hs:]
        self._sqlite_log_query(actor, query, len(ok), len(err))
        if actor is not None:
            self._user_activity.setdefault(str(actor), []).append({"ts": time.time(), "type": "search", "query": query})
        self._emit_event("search.completed", {"query": query, "hits": len(ok)})
        return ok, err

    def _latency_percentiles(self):
        out = {}
        for src, arr in (self._stats.get("latency") or {}).items():
            if not arr:
                continue
            s = sorted(arr)
            n = len(s)
            out[src] = {"p50": s[int(n * 0.5)] if n else 0, "p95": s[min(int(n * 0.95), n - 1)] if n else 0, "p99": s[min(int(n * 0.99), n - 1)] if n else 0, "avg": round(sum(s) / n, 3), "n": n}
        return out

    def _format_results(self, query, results, page=0):
        maxd = int(self._cfg_mgr.get("search.max_sources_display", 10) or 10)
        total = max(1, (len(results) + maxd - 1) // maxd)
        page = max(0, min(page, total - 1))
        chunk = results[page * maxd:(page + 1) * maxd]
        p = self._prefix()
        out = ["<blockquote><b>some founded!!</b></blockquote>", "<b>target:</b> <code>%s</code>" % html.escape(query), "<b>sources hit:</b> <code>%d</code>" % len(results), "<b>page:</b> <code>%d/%d</code>" % (page + 1, total), ""]
        for r in chunk:
            badges = []
            if r.get("bypass"):
                badges.append("bypass:%s" % r["bypass"])
            if r.get("fallback"):
                badges.append("fallback:%s" % r["fallback"])
            if r.get("override"):
                badges.append("override:%s" % r["override"])
            bs = " <i>(%s)</i>" % ", ".join(badges) if badges else ""
            snip = self._safe_truncate(r.get("snippet_hl") or "", 700)
            out.append("<blockquote><b>%s</b> <i>(score %.2f, %ss)</i>%s\n<b>title:</b> %s\n<b>url:</b> <code>%s</code>\n<b>matches:</b> <code>%d</code> | <b>links:</b> <code>%d</code>\n<i>%s</i></blockquote>" % (html.escape(r["name"]), r.get("score", 0), r.get("elapsed", 0), bs, html.escape(r["title"]), html.escape(r["url"][:300]), r["matches"], r["total_links"], snip))
            if r.get("entities"):
                lines = []
                for k, vs in r["entities"].items():
                    lines.append("  <b>%s:</b> %s" % (k, ", ".join(html.escape(v) for v in vs[:5])))
                if lines:
                    out.append("<b>entities:</b>\n" + "\n".join(lines))
            if r.get("links"):
                out.append("<b>related:</b>")
                for l in r["links"][:5]:
                    out.append("• <code>%s</code>" % html.escape(l[:200]))
            out.append("")
        return "\n".join(out), total

    def _no_result_text(self, errors):
        if errors:
            lines = ["<blockquote><b>all sources failed 💀</b>"]
            for e in errors[:8]:
                lines.append("• <code>%s</code>: <i>%s</i>" % (html.escape(e.get("__error__", "?")), html.escape((e.get("error") or "")[:120])))
            lines.append("</blockquote>")
            return "\n".join(lines)
        return "<blockquote><b>no information..</b></blockquote>"

    def _usage(self):
        p = html.escape(self._prefix())
        return "<blockquote><b>DontDoThatADM v%s (owner edition)</b>\n<code>%sdothat help</code>\n<code>%sdothat &lt;query&gt;</code></blockquote>" % (self.version, p, p)

    async def _respond(self, event, text, **kwargs):
        if getattr(event, "out", None) is True:
            try:
                return await event.edit(text, **kwargs)
            except Exception:
                pass
        try:
            return await event.respond(text, **kwargs)
        except Exception:
            try:
                return await event.reply(text, **kwargs)
            except Exception:
                return None

    async def _send_result(self, event, query, ok, err, page=0):
        if not ok:
            await self._respond(event, self._no_result_text(err), parse_mode="html")
            return
        text, total = self._format_results(query, ok, page=page)
        self._last_result = {"query": query, "ok": ok, "err": err, "ts": time.time()}
        await self._respond(event, text, parse_mode="html")

    def _help_main(self, p):
        return "<blockquote><b>DontDoThatADM help</b>\n<code>%sdothat help search|sources|diag|plugins|repo|new|cfg|roles|service|operators|rc</code></blockquote>" % p

    def _help_search(self, p):
        return "<blockquote><b>search</b>\n<code>%sdothat &lt;query&gt;</code>\n<code>%sdothat all|fast|deep &lt;q&gt;</code>\n<code>%sdothat search &lt;name&gt; &lt;q&gt;</code>\n<code>%sdothat @src &lt;q&gt;</code>\n<code>%sdothat page &lt;n&gt; &lt;q&gt;</code>\n<code>%sdothat retry|history|openall|json|save|saved</code>\n</blockquote>" % (p, p, p, p, p, p)

    def _help_sources(self, p):
        return "<blockquote><b>sources</b>\n<code>%sdothat add &lt;name&gt; &lt;url&gt;</code>\n<code>%sdothat add-api &lt;name&gt; &lt;preset|url&gt;</code>\n<code>%sdothat remove|enable|disable|info &lt;name&gt;</code>\n<code>%sdothat tag|priority|weight &lt;name&gt; ...</code>\n<code>%sdothat sites|tags</code>\n</blockquote>" % (p, p, p, p, p)

